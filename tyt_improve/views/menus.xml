<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>'
    
        <!-- =========================
        Reporte "Registro de no conformidades"
        ========================= -->

        <!--Accion de reporte de no conformidad-->
        <record id="tyt_report_nc_xlsx" model="ir.actions.report"><field name="model">wizard.nc.report</field><field name="name">Registro de no conformidad</field><field name="report_type">xlsx</field><field name="report_name">tyt_improve.general_nonconformity_report</field><field name="report_file">Reporte de No conformidades</field><field name="attachment_use">False</field><field name="binding_type">report</field></record><!-- Heredar el menú de reportes existente -->
        <record id="menu_nonconformity_report_inherit" model="ir.ui.menu"><field name="name">Reportes</field><field name="parent_id" ref="mgmtsystem_nonconformity.menu_nonconformity_root"/></record>

        <!-- Definir la acción asociada al nuevo menú -->
        <record id="action_tyt_report_nc" model="ir.actions.act_window"><field name="name">Reporte de Registro de no conformidad</field><field name="res_model">wizard.nc.report</field><field name="view_mode">form</field><field name="view_id" ref="mgmtsystem_nonconformity.report_nc_excel"/><field name="target">new</field></record>

        <!-- Agregar nuevo elemento de menú en la sección de reportes -->
        <menuitem id="report_tyt_nc" name="Reporte de Registro de no conformidad" parent="mgmtsystem_nonconformity.menu_nonconformity_report" action="action_tyt_report_nc" sequence="150"/>


        <!-- =========================
        Reporte "Inventario y estado de no conformidades"
        ========================= -->

        <!-- Definir el modelo para el reporte de inventario de no conformidades -->
        <record id="tyt_report_nc_excel" model="ir.ui.view"><field name="name">wizard.nc.report.excel</field><field name="model">wizard.nc.report</field><field name="arch" type="xml"><form string="Wizard"><group><field name="date_init"/><field name="date_fin"/></group><footer><button name="export_nc_inventory_xls" type="object" default_focus="1" string="Exportar Reporte Excel" class="oe_highlight" context="{'xls_export':1}" icon="fa-download"/><button string="Cancelar" special="cancel"/></footer></form></field></record>

        <!-- Acción de reporte de inventario de no conformidades -->
        <record id="tyt_report_nc_inventory_xlsx" model="ir.actions.report"><field name="model">wizard.nc.report</field><field name="name">Inventario de no conformidades</field><field name="report_type">xlsx</field><field name="report_name">tyt_improve.general_nonconformity_inventory</field><field name="report_file">Inventario de no conformidades</field><field name="attachment_use">False</field><field name="binding_type">report</field></record><!-- Definir la acción asociada al nuevo menú -->

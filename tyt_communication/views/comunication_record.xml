<odoo>    
    <data>
        <record id="mgmtsystem_plan_training_form_tyt" model="ir.ui.view">
            <field name="name">mgmtsystem_plan_training_form_tyt</field>
            <field name="model">comunication.plan.line</field>
            <field name="inherit_id" ref="mgmtsystem_comunication.view_plan_line_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group[2]" position="replace">
                    <group>
                        <group>
                            <field name="user_id">
                                <list string="Puestos de Usuarios">
                                    <field name="name" string="Usuario"/>
                                    <field name="job_id" string="Puesto del Emisor"/>
                                </list>
                            </field>
                            <field name="type" readonly="state not in ['elaborate', 'validate_ok']" />
                            <field name="date_release" readonly="state not in ['elaborate']" />
                            <field name="via" readonly="state not in ['elaborate']" />
                            <field name="frequency_text" />
                        </group>                    
                        <group>
                            <field name="communication_target" readonly="state not in ['elaborate']" />
                            <field name="communication_format" readonly="state not in ['elaborate']" />
                            <field name="communication_place" readonly="state not in ['elaborate']" />
                            <field name="communication_media" readonly="state not in ['elaborate']" />
                            <field name="responsible_in_id" readonly="state not in ['elaborate']" />
                        </group>                
                    </group>                              
                </xpath>
            </field>
        </record>

        <!-- Actions-->
        <record id="mgmtsystem_comunication.plan_line_action" model="ir.actions.act_window">
            <field name="name">Plan de Comunicación</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">comunication.plan.line</field>
            <field name="view_mode">list,form,kanban,graph,pivot</field>
        </record>


    </data>
</odoo>
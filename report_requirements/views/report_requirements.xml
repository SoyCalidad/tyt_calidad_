<?xml version='1.0' encoding='UTF-8'?>
<!--Estructura basica de reportes-->
<odoo>
   <data>
      <template id="report_requirements_template">
         
      </template>
      <record id="requirements" model="report.paperformat">
         <field name="name">European A4 low margin</field>
         <field name="default" eval="True" />
         <field name="format">A4</field>
         <field name="page_height">0</field>
         <field name="page_width">0</field>
         <field name="orientation">Portrait</field>
         <field name="margin_top">0</field>
         <field name="margin_bottom">0</field>
         <field name="margin_left">0</field>
         <field name="margin_right">0</field>
         <field name="header_line" eval="False" />
         <field name="header_spacing">30</field>
         <field name="dpi">80</field>
      </record>
      <record id="report_requirements" model="ir.actions.report">
         <field name="model">legal.plan</field>
         <field name="name">Reporte de requisitos legales</field>
         <field name="report_type">qweb-pdf</field>
         <field name="report_name">report_requirements_template</field>
         <field name="report_file">report_requirements_template</field>
         <field name="paperformat_id" ref="requirements" />
         <field name="groups_id"
            eval="[(6, 0, [ref('base.group_no_one'), ref('mgmtsystem_legal.group_legal_onlyread_printreport'), ref('mgmtsystem_legal.group_legal_write_printreport'), ref('mgmtsystem_legal.group_legal_all')])]" />
         <field name="binding_model_id" ref="mgmtsystem_legal.model_legal_plan" />
         <field name="binding_type">report</field>
      </record>
   </data>
</odoo>
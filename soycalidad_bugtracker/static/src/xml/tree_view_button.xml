<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">

    <!-- Extensión del CrashManager en OWL -->
    <t t-name="soycalidad_bugtracker.CrashManagerPatch" owl="1">
        <t t-inherit="web.CrashManager" t-inherit-mode="extension">
            <xpath expr="//div[@class='o_error_detail']" position="inside">
                <a href="https://forms.gle/EjwLyPoFtcM5WojY8" target="_blank">
                    <button class="btn btn-primary">
                        <i class="fa fa-clipboard me-2"/> Notificar el error
                    </button>
                </a>
            </xpath>
        </t>
    </t>

    <!-- Extensión de botones en el control panel de ListView -->
    <t t-name="soycalidad_bugtracker.ListViewButtonsPatch" owl="1">
        <t t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
            <xpath expr="//button[contains(@class, 'o_list_export_xlsx')]" position="after">
                <button type="button"
                        class="btn btn-secondary fa fa-bug o_list_bug_report"
                        title="Enviar reporte de error"/>
            </xpath>
        </t>
    </t>

</templates>

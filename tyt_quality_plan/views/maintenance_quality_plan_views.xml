<odoo>
    <!-- Vista para el modelo Quality Log -->
    <record id="view_maintenance_qualityplan_form" model="ir.ui.view">
        <field name="name">maintenance.qualityplan.form</field>
        <field name="model">maintenance.qualityplan</field>
        <field name="arch" type="xml">
            <form string="Quality Plan">
                <header>
                    <button name="action_confirm" string="Save" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_link"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Edit" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                </header>
                <sheet readonly="state == 'confirmed'">
                    <group>
                        <field name="name" readonly="state == 'confirmed'"/>
                        <field name="week" readonly="state == 'confirmed'"/>
                        <field name="site" readonly="state == 'confirmed'"/>
                        <field name="state" invisible="1"/> 
                    </group>

                    <notebook>
                        <page string="Quality Plan">
                            <field name="quality_plan_line_ids" readonly="state == 'confirmed'">
                                <list>
                                    <field name="control"/>
                                    <field name="monitoring"/>
                                    <field name="percentage" widget="percentage"/>
                                    <field name="status"/>
                                </list>
                                <form>
                                    <field name="control" string="Control"/>
                                    <field name="monitoring" string="Monitoring"/>
                                    <field name="percentage" string="Percentage" widget="percentage"/>
                                    <field name="status" string="Status"/>
                                </form>
                            </field>
                        </page>
                        <page string="Validation and version">
                            <field name="quality_plan_stages_ids" readonly="state == 'confirmed'">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="stage"/>
                                    <field name="manager_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="total_percentage" widget="percentage" readonly="state == 'confirmed'"/>
                        <field name="observations" string="Feedback comments" readonly="state == 'confirmed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para la lista de Quality Logs -->
    <record id="view_maintenance_qualitylog_tree" model="ir.ui.view">
        <field name="name">maintenance.qualityplan.tree</field>
        <field name="model">maintenance.qualityplan</field>
        <field name="arch" type="xml">
            <list string="Quality Plan">
                <field name="name"/>
                <field name="total_controls"/>
                <field name="total_monitoring"/>
                <field name="total_percentage" widget="percentage"/>
            </list>
        </field>
    </record>

    <!-- Acción para abrir el menú de Quality Logs -->
    <record id="action_maintenance_qualityplan" model="ir.actions.act_window">
        <field name="name">Quality Plans</field>
        <field name="res_model">maintenance.qualityplan</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="model_maintenance_qualityplan" model="ir.model">
        <field name="name">Maintenance Quality Plan</field>
        <field name="model">maintenance.qualityplan</field>
    </record>


     <!-- Submenú para Quality Plan dentro de Maintenance -->
    <menuitem id="menu_maintenance_quality_root" name="Quality" parent="maintenance.menu_maintenance_title" sequence="6"/>

    <!-- Submenú para acceder a los Quality Plan -->
    <menuitem id="menu_maintenance_remediationplan" name="Quality Plans"
              parent="menu_maintenance_quality_root" action="action_maintenance_qualityplan" sequence="10"/>
</odoo>

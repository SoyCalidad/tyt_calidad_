<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_documents" name="Show Documents | Intranet" customize_show="True"
              inherit_id="tyt_intranet_portal.portal_my_home" priority="150">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">

        </xpath>
        <div id="portal_common_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/tyt_intranet_portal/static/src/img/rfq.svg'"/>
                <t t-set="title">Documentos</t>
                <t t-set="text">Acceda a sus documentos</t>
                <t t-set="url" t-value="'/documents/folder/share'"/>
                <t t-set="config_card" t-value="True" />
            </t>
        </div>
    </template>

    <template id="portal_document_inherit" inherit_id="portal.portal_my_home"
     priority="210">
            <xpath expr="(//t[@t-call='portal.portal_docs_entry'])[last()]" position="replace"/>
    </template>
</odoo>

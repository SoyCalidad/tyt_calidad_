<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_department_message" name="Show Messages | Intranet" customize_show="True"
              inherit_id="tyt_intranet_portal.portal_my_home" priority="160">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">

        </xpath>
        <div id="portal_common_category2" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/tyt_intranet_portal/static/src/img/rfq.svg'"/>
                <t t-set="title">Mensajes a departamentos</t>
                <t t-set="text">Acceda a sus mensajes</t>
                <t t-set="url" t-value="'/my/department_messages'"/>
            </t>
        </div>
    </template>
</odoo>

        <record id="view_mgmtsystem_infrastructure_tree" model="ir.ui.view">
            <field name="name">mgmtsystem.infrastructure.tree</field>
            <field name="model">mgmtsystem.infrastructure</field>
            <field name="arch" type="xml">
                <list string="Infraestructura">
                    <field name="name" />
                    <field name="numero" />
                    <field name="edition_id" />
                    <field name="lines_ids" />
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="view_mgmtsystem_infrastructure_form" model="ir.ui.view">
            <field name="name">mgmtsystem.infrastructure.form</field>
            <field name="model">mgmtsystem.infrastructure</field>
            <field name="arch" type="xml">
                <form string="Infraestructura">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="elaborate,review,validate,validate_ok" />
                        <button string="Enviar a Elaborar"
                                name="send_elaborate"
                                type="object"
                                class="btn-primary"
                                invisible="state in ['elaborate', 'validate', 'validate_ok', 'cancel']" />
                        <button string="Enviar a Revisar"
                                name="send_review"
                                type="object"
                                class="btn-primary"
                                invisible="state in ['review', 'validate_ok', 'cancel']" />
                        <button string="Enviar a Validar"
                                name="send_validate"
                                type="object"
                                class="btn-primary"
                                invisible="state in ['elaborate', 'validate', 'validate_ok', 'cancel']" />
                        <button string="Validar"
                                name="send_validate_ok"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ['validate']" />
                        <button string="Volver Obsoleto"
                                confirm="Esto volverá obsoleto el presente registro. ¿Está seguro(a)?"
                                name="send_cancel"
                                type="object"
                                class="btn-second"
                                invisible="state in ['cancel']" />
                    </header>
                    <sheet>
                        <group>
                            <label for="name" />
                            <div class="o_row">
                                <field name="name" placeholder="Nombre" colspan="3" readonly="state not in ['elaborate']" />
                                <field name="numero"
                                       colspan="1"
                                       nolabel="1"
                                       class="oe_inline"
                                       readonly="state not in ['elaborate']" />
                            </div>
                            <field name="edition_id" readonly="state in ['validate_ok', 'cancel']" />
                            <field name="have_equipment" invisible="1" readonly="state in ['validate_ok', 'cancel']" />
                        </group>
                        <notebook>
                            <page string="Inventario" invisible="have_equipment == False">
                                <button type="object" name="show_equipments" string="Añadir bienes" class="oe_link oe_right" />
                                <field name="lines_ids" readonly="state in ['validate_ok', 'cancel']">
                                    <list editable="bottom">
                                        <field name="equipment_id" column_invisible="parent.state == 'validate'" />
                                        <field name="name" string="Equipo" column_invisible="parent.state != 'validate'" />
                                        <field name="category_id" />
                                        <field name="cost" />
                                        <field name="employee_id" />
                                        <field name="department_id" />
                                        <field name="location" />
                                        <field name="assign_date" />
                                        <field name="scrap_date" />
                                        <field name="has_attachments" invisible="1" />
                                        <button name="action_see_attachments" type="object" icon="fa-files-o" invisible="has_attachments == False" />
                                        <button name="action_see_attachments" type="object" icon="fa-file" invisible="has_attachments == True" />
                                        <field name="observations" />
                                    </list>
                                </field>
                            </page>
                            <page string="Bienes" invisible="have_equipment == True">
                                <button type="object" name="action_send_equipments" string="✓ Empezar inventariado" class="oe_link oe_right" />
                                <field name="equipment_ids" readonly="state in ['validate_ok', 'cancel']">
                                    <list edit="False">
                                        <field name="name" />
                                        <field name="category_id" string="Categoría" />
                                        <field name="cost" />
                                        <field name="location" />
                                        <field name="assign_date" />
                                        <field name="scrap_date" />
                                    </list>
                                </field>
                            </page>
                            <page string="Información">
                                <group>
                                    <group>
                                        <field name="elaborate_ids" widget="many2many_tags" options="{ 'no_open': True, 'no_create_edit': True, 'no_create': True}" readonly="state not in ['elaborate']" required="state in ['elaborate']" />
                                        <field name="review_ids" widget="many2many_tags" options="{ 'no_open': True}" readonly="state not in ['elaborate', 'review']" required="state in ['elaborate']" />
                                        <field name="validate_ids" widget="many2many_tags" options="{ 'no_open': True}" readonly="state not in ['elaborate', 'review', 'validate']" required="state in ['review']" />
                                    </group>
                                    <group>
                                        <field name="date_elaborate" readonly="True" required="state in ['elaborate']" />
                                        <field name="date_review" invisible="state in ['elaborate']" readonly="True" required="state in ['review']" />
                                        <field name="date_validate" groups="base.group_no_one,base.group_system" invisible="state in ['elaborate', 'review']" />
                                    </group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>

                    <chatter/>

                </form>
            </field>
        </record>

        <record id="product_infrastructure_action" model="ir.actions.act_window">
            <field name="name">Inventariado</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mgmtsystem.infrastructure</field>
            
            <field name="view_mode">list,form,kanban</field>
        </record>

        <record id="product_infrastructure_action" model="ir.actions.act_window">
            <field name="name">Inventariado</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">mgmtsystem.infrastructure</field>
            
            <field name="view_mode">list,form,kanban</field>
        </record>


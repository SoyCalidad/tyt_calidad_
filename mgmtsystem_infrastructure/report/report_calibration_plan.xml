<?xml version='1.0' encoding='UTF-8'?>
<!--Estructura basica de reportes-->
<odoo>
  <data>
    <template id="calibration_plan_report" inherit_id="mgmtsystem_infrastructure.maintance_plan_report"/>
    <record id="action_calibration_plan_report" model="ir.actions.report">
      <field name="model">mgmtsystem.calibration.plan</field>
      <field name="name">Programa de calibraciones</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">mgmtsystem_infrastructure.calibration_plan_report</field>
      <field name="report_file">Programa de calibraciones</field>
      <field name="paperformat_id" ref="hola_calidad.landscape"/>
      <field name="binding_model_id" ref="model_mgmtsystem_calibration_plan" />
      <field name="binding_type">report</field>
    </record>
    <record id="calibration_plan_wizard_view_form" model="ir.ui.view">
      <field name="name">calibration.plan.wizard.view.form</field>
      <field name="model">calibration.plan.wizard</field>
      <field name="arch" type="xml">
        <form string="">
          <sheet>
            <group>
              <field name="calibration_plan_id" required="1"/>
            </group>
          </sheet>
          <footer>
            <button name="action_print" type="object" string="Descargar" class="oe_highlight" icon="fa-download"/>
          </footer>
        </form>
      </field>
    </record>
    <record id="action_report_calibration" model="ir.actions.act_window">
      <field name="name">Reporte de programa de calibraciones</field>
      <field name="type">ir.actions.act_window</field>
      <field name="res_model">calibration.plan.wizard</field>
      <field name="view_mode">form</field>
      <field name="view_id" ref="calibration_plan_wizard_view_form"/>
      <field name="target">new</field>
      <field name="binding_type">report</field>
    </record>
    <menuitem id="calibration_plan_wizard_menu" name="Programa de calibraciones" action="action_report_calibration" parent="mgmtsystem_infrastructure.soycalidad_maintenance_reporting" sequence="22"/>
  </data>
</odoo>

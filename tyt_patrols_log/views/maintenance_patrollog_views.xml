<odoo>
    <!-- Vista para el modelo Patrol Log -->
    <record id="view_maintenance_patrollog_form" model="ir.ui.view">
        <field name="name">maintenance.patrollog.form</field>
        <field name="model">maintenance.patrollog</field>
        <field name="arch" type="xml">
            <form string="Patrol Log">
                <header>
                    <button name="action_confirm" string="Save" type="object" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_link"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_draft" string="Edit" type="object" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                </header>
                <sheet attrs="{'readonly': [('state', '=', 'confirmed')]}">
                    <group>
                        <field name="name" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        <field name="user_id" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        <field name="production_date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        <field name="state" invisible="1"/> 
                    </group>

                    <notebook>
                        <page string="Development">
                            <field name="patrol_log_line_ids" attrs="{'readonly': [('state', '=', 'confirmed')]}">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="location"/>
                                    <field name="description"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Validation and version">
                            <field name="patrol_log_stages_ids" attrs="{'readonly': [('state', '=', 'confirmed')]}">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="stage"/>
                                    <field name="manager_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="observations" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para la lista de Patrol Logs -->
    <record id="view_maintenance_patrollog_tree" model="ir.ui.view">
        <field name="name">maintenance.patrollog.tree</field>
        <field name="model">maintenance.patrollog</field>
        <field name="arch" type="xml">
            <tree string="Patrol Logs">
                <field name="name"/>
                <field name="user_id"/>
                <field name="production_date"/>
            </tree>
        </field>
    </record>

    <record id="model_maintenance_patrollog" model="ir.model">
        <field name="name">Maintenance Patrol Log</field>
        <field name="model">maintenance.patrollog</field>
    </record>

    <!-- Acción para abrir el menú de Patrol Logs -->
    <record id="action_maintenance_patrollog" model="ir.actions.act_window">
        <field name="name">Patrol Logs</field>
        <field name="res_model">maintenance.patrollog</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Submenú para acceder a los Patrol Logs -->
    <menuitem id="menu_maintenance_patrolplan" name="Patrol Plans"
              parent="tyt_remediation_log.menu_maintenance_remediation_root" action="action_maintenance_patrollog" sequence="20"/>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>    
    <record id="report_nco_excel" model="ir.ui.view">
        <field name="name">non.conformity.output.wizard.form</field>
        <field name="model">non.conformity.output.wizard</field>
        <field name="arch" type="xml">
            <form string="Control of Non-Conforming Outputs">
                <group>
                    <field name="start_date" string="Start Date"/>
                    <field name="end_date" string="End Date"/>
                </group>
                <footer>
                    <button name="generate_report"
                            type="object"
                            string="Print"
                            class="oe_highlight"
                            icon="fa-download" />
                    <button string="Cancel" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="report_nco">
        <field name="name">Control of non-conforming outputs</field>
        <field name="res_model">non.conformity.output.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="report_nco_excel" />
        <field name="target">new</field>
    </record>
    
</odoo>

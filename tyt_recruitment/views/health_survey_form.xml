<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="template_health_survey_form" name="Public Form">
        <link rel="stylesheet" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"/>
        <style type="text/css">
            body {
                background-image: url(/tyt_recruitment/static/src/img/fondo_form.png);
            }
            .row{
                background: white;
            }
            h1 {
                background-color: #1f8296;
                padding: 10px;
                color: white;
            }
            h3 {
                background-color: #1f8296;
                padding: 10px;
                color: white;
                margin-left: -10px;
            }
            .cell1{
                background-color: white;
            }
        </style>

        <div class="container mt-4 mb-4">
            <form id="health-survey-form" 
                t-att-action="'/health_survey/submit?job_application_id=' + job_application_id" 
                method="post" 
                class="p-4 border cell1 rounded bg-light" >

                <input type="text" name="job_application_id" t-att-value="job_application_id" readonly="true" style="display:none"/>
                <h1 class="text-center">ENCUESTA DE SALUD</h1>
                <h6 class="text-center"> Favor de llenar las siguiente encuesta con sinceridad. Es importante para TYT Logistica y Servicios conocer tu estado de salud en que se encuentre todos sus posibles empleado, Cualquier omision o cambio sera responsabilidad de quien llene dicho formato.. </h6>
                <div id="first-part">
                    <section class="p-3">
                        <div class="row">
                            <div class="col-sm-6 col-md-4 col-lg-4 col-xl-4 col-xxl-4 p-4 border cell1">
                                <img src="/tyt_recruitment/static/src/img/logo_large.png" alt="Logo" style="width: 280px; height: auto; margin: auto; display: block;" />
                            </div>

                            <div class="col-sm-6 col-md-8 col-lg-8 col-xl-8 col-xxl-8 p-8 border cell1" style=" display: grid; place-items: center;">
                                <div class="row text-end">
                                    <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 p-4 border cell1">
                                        <label for="request_date" class="form-label">Fecha</label>
                                        <input type="date" class="form-control" id="request_date" name="request_date" required="required"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="p-3">
                        <h3>DATOS GENERALES</h3>
                        <div class="row">
                            <!-- Nombre -->
                            <div class="col-sm-6 col-md-4 col-lg-4 col-xl-4 col-xxl-4 p-4 border cell1">
                                <label for="name" class="form-label">Nombre:</label>
                                <input type="text" class="form-control" id="name" name="name" t-att-value="name" readonly="true" />
                            </div>

                            <!-- Apellido Paterno -->
                            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3 col-xxl-3 p-4 border cell1">
                                <label for="last_name_father" class="form-label">Apellido Paterno:</label>
                                <input type="text" class="form-control" id="last_name_father" name="last_name_father" t-att-value="last_name_father" readonly="true"/>
                            </div>

                            <!-- Apellido Materno -->
                            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3 col-xxl-3 p-4 border cell1">
                                <label for="last_name_mother" class="form-label">Apellido Materno:</label>
                                <input type="text" class="form-control" id="last_name_mother" name="last_name_mother" t-att-value="last_name_mother" readonly="true"/>
                            </div>

                            <!-- Sexo -->
                            <div class="col-sm-6 col-md-2 col-lg-2 col-xl-2 col-xxl-2 p-4 border cell1">
                                <label for="gender" class="form-label">Sexo:</label>
                                <input type="text" class="form-control" id="gender" name="gender" t-att-value="gender" readonly="true"/>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Lugar de Nacimiento -->
                            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3 col-xxl-3 p-4 border cell1">
                                <label for="birthplace" class="form-label">Lugar de Nacimiento:</label>
                                <input type="text" class="form-control" id="birthplace" name="birthplace" t-att-value="birthplace" readonly="true"/>
                            </div>

                            <!-- Fecha de Nacimiento -->
                            <div class="col-sm-6 col-md-3 col-lg-3 col-xl-3 col-xxl-3 p-4 border cell1">
                                <label for="birthdate" class="form-label">Fecha de Nacimiento:</label>
                                <input type="date" class="form-control" id="birthdate" name="birthdate" t-att-value="birthdate" readonly="true"/>
                            </div>

                            <!-- Nacionalidad -->
                            <div class="col-sm-6 col-md-2 col-lg-2 col-xl-2 col-xxl-2 p-4 border cell1">
                                <label for="nationality" class="form-label">Nacionalidad:</label>
                                <input type="text" class="form-control" id="nationality" name="nationality" t-att-value="nationality" readonly="true"/>
                            </div>

                            <!-- Edad -->
                            <div class="col-sm-6 col-md-2 col-lg-2 col-xl-2 col-xxl-2 p-4 border cell1">
                                <label for="age" class="form-label">Edad</label>
                                <input type="number" class="form-control" id="age" min="18" name="age" t-att-value="age" readonly="true" />
                            </div>

                            <!-- Estado Civil -->
                            <div class="col-sm-6 col-md-2 col-lg-2 col-xl-2 col-xxl-2 p-4 border cell1">
                                <label for="marital_status" class="form-label">Estado Civil:</label>
                                <input type="text" class="form-control" id="marital_status" min="18" name="marital_status" t-att-value="marital_status" readonly="true" />
                            </div>
                        </div>
                    </section>

                    <section class="p-3">
                        <h3>CUESTIONARIO</h3>
                        <div class="row">
                            <!-- Lista de preguntas -->
                            <t t-foreach="health_questions_json" t-as="question">
                                <div class="col-sm-12 col-md-12 col-lg-12 col-xl-12 col-xxl-12 p-4 border cell1">
                                    <label t-att-for="question['id']" class="form-label text-muted">
                                        <t t-esc="question['title']"/>
                                    </label>
                                    <t t-if="question['question_type'] == 'simple_choice'">
                                        <div class="row">
                                            <div class="col-8">
                                                <select class="form-select" t-att-name="question['id']" required="required">
                                                    <option value="">Seleccione una opción</option>
                                                    <t t-foreach="question['options']" t-as="option">
                                                        <option t-att-value="option['value']">
                                                            <t t-esc="option['value']"/>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                            <t t-if="question['extra_input_enabled']">
                                                <div class="col-4">
                                                    <textarea class="form-control"
                                                        t-att-name="'extra_' + str(question['id'])"
                                                        t-att-placeholder="question['extra_input']"
                                                        style="height: 100%;"></textarea>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <t t-elif="question['question_type'] == 'multiple_choice'">
                                        <div class="row">
                                            <div class="col-4">
                                                <t t-foreach="question['options'][:len(question['options'])//2+1]" t-as="option">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" 
                                                            t-att-name="option['id']"
                                                            t-att-value="option['value']"/>
                                                        <label t-att-for="option['value']" class="form-check-label">
                                                            <t t-esc="option['value']"/>
                                                        </label>
                                                    </div>
                                                </t>
                                            </div>
                                            <div class="col-4">
                                                <t t-foreach="question['options'][len(question['options'])//2+1:]" t-as="option">
                                                    <div class="form-check">
                                                        <input type="checkbox" class="form-check-input" 
                                                            t-att-name="option['id']"
                                                            t-att-value="option['value']"/>
                                                        <label t-att-for="option['value']" class="form-check-label">
                                                            <t t-esc="option['value']"/>
                                                        </label>
                                                    </div>
                                                </t>
                                            </div>
                                            <t t-if="question['extra_input_enabled']">
                                                <div class="col-4">
                                                    <textarea class="form-control"
                                                        t-att-name="'extra_' + str(question['id'])"
                                                        t-att-placeholder="question['extra_input']"
                                                        style="height: 100%;"></textarea>
                                                </div>
                                            </t>
                                        </div>
                                    </t>

                                    <t t-if="question['question_type'] == 'text_box'">
                                        <textarea class="form-control"
                                            t-att-name="question['id']"
                                            t-att-placeholder="'Ingrese su respuesta'"
                                            style="height: 100%;"></textarea>
                                    </t>

                                    <t t-if="question['question_type'] == 'char_box'">
                                        <input type="text" class="form-control"
                                            t-att-name="question['id']" 
                                            t-att-placeholder="'Ingrese su respuesta'" 
                                            required="required"/>
                                    </t>

                                    <t t-if="question['question_type'] == 'numerical_box'">
                                        <input type="number" class="form-control"
                                            t-att-name="question['id']" 
                                            t-att-placeholder="'Ingrese su respuesta'" 
                                            required="required"/>
                                    </t>

                                    <t t-if="question['question_type'] == 'date'">
                                        <input type="date" class="form-control"
                                            t-att-name="question['id']" 
                                            t-att-placeholder="'Ingrese su respuesta'" 
                                            required="required"/>
                                    </t>

                                    <t t-if="question['question_type'] == 'datetime'">
                                        <input type="datetime-local" class="form-control"
                                            t-att-name="question['id']" 
                                            t-att-placeholder="'Ingrese su respuesta'" 
                                            required="required"/>
                                    </t>

                                    <t t-if="question['question_type'] == 'matrix'">
                                        <input type="text" class="form-control"
                                            t-att-name="question['id']" 
                                            t-att-placeholder="'Ingrese su respuesta'" 
                                            required="required"/>
                                    </t>
                                </div>
                            </t>
                        </div>
                    </section>

                    <section class="p-3">
                        <h3>COMENTARIOS DEL RECLUTADOR</h3>
                        <div class="row">
                            <div class="col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6 p-4 border cell1">
                                
                                <textarea class="form-control" id="recruiter_comments" name="recruiter_comments" style="height: 100%;"></textarea>
                            </div>
                            <div class="col-sm-6 col-md-6 col-lg-6 col-xl-6 col-xxl-6 p-4 border cell1">
                                <label for="signature" class="form-label">Firma del solicitante:</label>
                                <canvas id="signature-pad" class="signature-pad border cell1" width="400" height="200"></canvas>
                                <input type="hidden" id="signature" name="signature" />
                                <button type="button" class="btn btn-secondary mt-2" id="clear-signature">Borrar firma</button>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col p-3 text-center border cell1">
                                La empresa no se compromete a aceptar al solicitante como empleado por el solo hecho de recibir esta solicitud.
                            </div>
                        </div>
                    </section>                

                    <div class="row mt-4">
                        <div class="col text-end">
                            <button type="submit" class="btn btn-primary btn-lg">
                                Enviar
                            </button>
                        </div>
                    </div>
                </div>  

                <div class="position-fixed bottom-0 end-0 m-4" >
                    <a href="#" class="btn btn-info btn-lg" id="back-to-top" title="Volver al inicio">
                        <i class="bi bi-arrow-up"></i>
                    </a>
                </div>     
            </form>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/signature_pad@2.3.2/dist/signature_pad.min.js"></script>
        <script>

            // FECHA ACTUAL
            document.addEventListener("DOMContentLoaded", function() {
                const today = new Date().toISOString().split('T')[0];
                document.getElementById("request_date").value = today;
            });

            // OTRO MEDIO DE REFERENCIA
            window.onscroll = function() {
                var button = document.getElementById("back-to-top");
                if (document.body.scrollTop > 100 || document.documentElement.scrollTop > 100) {
                    button.style.display = "block";
                } else {
                    button.style.display = "none";
                }
            };

            // FIRMA
            // Inicializar el Signature Pad
            var canvas = document.getElementById('signature-pad');
            var signaturePad = new SignaturePad(canvas);

            // Botón para limpiar la firma
            document.getElementById('clear-signature').addEventListener('click', function () {
                signaturePad.clear();
            });

            // Guardar la firma como una imagen base64 en el campo oculto
            document.querySelector('form').addEventListener('submit', function (event) {
                if (!signaturePad.isEmpty()) {
                    var signatureData = signaturePad.toDataURL('image/png');
                    document.getElementById('signature').value = signatureData;
                } else {
                    alert("Por favor, firme antes de enviar.");
                    event.preventDefault();  // Evita el envío si no hay firma
                }
            });
        </script>

    </template>

    <template id="template_health_survey_success" name="Form Submission Success">
        <div class="container text-center mt-5">
            <h4>¡Gracias por enviar el formulario!</h4>
        </div>
    </template>
</odoo>
<odoo>
  <data>

    <!-- Job Application List -->
    <record model="ir.ui.view" id="tyt_recruitment_job_application_list">
      <field name="name">Lista de Solicitudes</field>
      <field name="model">tyt_recruitment.job_application</field>
      <field name="arch" type="xml">
        <tree string="Lista de Preguntas">
          <field name="id"/>
          <field name="request_date"/>
          <field name="requisition"/>
          <field name="site"/>
          <field name="campaign_id"/>
          <field name="applicant_id"/>
          <field name="complete_survey_id"/>
          <field name="has_complete_survey"/>
          <button 
            name="action_open_health_survey" 
            string="Encuesta de salud" 
            type="object" 
            class="oe_highlight"
            attrs="{'invisible': [('has_complete_survey', '=', True)]}" />
        </tree>
      </field>
    </record>

    <!-- Question List -->
    <record model="ir.ui.view" id="tyt_recruitment_question_list">
      <field name="name">Lista de preguntas</field>
      <field name="model">tyt_recruitment.question</field>
      <field name="arch" type="xml">
        <tree string="Lista de Preguntas">
          <field name="text"/>
          <field name="type"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Formulario para encuesta completa -->
    <record model="ir.ui.view" id="tyt_recruitment_complete_survey_form">
      <field name="name">Formulario Encuesta de Salud completa</field>
      <field name="model">tyt_recruitment.complete_survey</field>
      <field name="arch" type="xml">
        <form string="Encuesta de Salud">
          <sheet>
            <group string="Información de la Encuesta">
              <field name="id" string="Fecha"/>
              <field name="state" string="Estado"/>
            </group>

            <group string="Respuestas">
              <field name="survey_answer_ids" mode="tree,form" string="Respuestas">
                <tree editable="bottom">
                  <field name="id" />
                  <field name="text" />
                  <field name="question_id" />
                  <field name="multiple_ids" />
                </tree>
              </field>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Job Application form -->
    <record model="ir.ui.view" id="tyt_recruitment_job_application_form">
      <field name="name">Formulario de Solicitud</field>
      <field name="model">tyt_recruitment.job_application</field>
      <field name="arch" type="xml">
        <form string="Formulario de Pregunta">
          <sheet>
            <group string="Información General">
              <field name="request_date"/>
              <field name="requisition"/>
              <field name="site"/>
              <field name="campaign_id"/>
              <field name="applicant_id"/>
            </group>

            <group string="Encuesta de Salud" colspan="2">
              <field name="has_complete_survey"/>
              <field name="complete_survey_id">
                <tree>
                  <field name="id" width="80px"/>
                  <field name="state" />
                </tree>
              </field>
            </group>
            
            <!-- Sección de Detalles adicionales (si los necesitas en el futuro) -->
            <notebook>
              <page string="Hijos">
                <field name="children_ids" mode="tree,kanban,form"/>
              </page>
              <page string="Historial Laboral">
                <field name="job_history_ids" mode="tree,kanban,form"/>
              </page>
              <page string="Referencias">
                <field name="reference_ids" mode="tree,kanban,form"/>
              </page>
              <page string="Datos Familiares">
                <group>
                  <field name="father_data_id"/>
                  <field name="mother_data_id"/>
                  <field name="spouse_data_id"/>
                </group>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Question form -->
    <record model="ir.ui.view" id="tyt_recruitment_question_form">
      <field name="name">Formulario de Pregunta</field>
      <field name="model">tyt_recruitment.question</field>
      <field name="arch" type="xml">
        <form string="Formulario de Pregunta">
          <group>
            <field name="text" />
            <field name="type" />
            <field name="state" />
          </group>
        </form>
      </field>
    </record>

    <!-- Action opening the question list -->
    <record model="ir.actions.act_window" id="tyt_recruitment_action_window_question">
      <field name="name">Lista de Preguntas</field>
      <field name="res_model">tyt_recruitment.question</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="tyt_recruitment_question_list"/>
    </record>

    <record model="ir.actions.act_window" id="tyt_recruitment_action_window_job_application">
      <field name="name">Lista de Solicitudes</field>
      <field name="res_model">tyt_recruitment.job_application</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="tyt_recruitment_job_application_list"/>
    </record>

    <!-- Top menu item -->
    <menuitem id="menu_custom_question"
      name="Preguntas"
      parent="menu_custom_recruitment"
      action="tyt_recruitment_action_window_question" 
    />
    <menuitem id="menu_custom_job_application"
      name="Solicitudes"
      parent="menu_custom_recruitment"
      action="tyt_recruitment_action_window_job_application" 
    />
  </data>
</odoo>
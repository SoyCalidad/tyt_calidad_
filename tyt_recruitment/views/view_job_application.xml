<odoo>
  <data>
    <!-- Job Application List -->
    <record model="ir.ui.view" id="tyt_recruitment_job_application_list">
      <field name="name">Lista de Solicitudes</field>
      <field name="model">tyt_recruitment.job_application</field>
      <field name="arch" type="xml">
        <tree string="Lista de Preguntas">
          <field name="id"/>
          <field name="applicant_last_name_father" />
          <field name="applicant_last_name_mother" />
          <field name="applicant_name" />
          <field name="applicant_employee_number" />
          <field name="applicant_number_phone" />
          <field name="applicant_birthdate" />
          <field name="applicant_birthplace" />
          <field name="applicant_rfc" />
          <field name="applicant_curp" />
          <field name="applicant_social_security_number" />

          <field name="campaign_id"/>
          <field name="campaign_turn"/>
          <field name="recruiter_id"/>

          <field name="site"/>
          <field name="requisition"/>

          <field name="expedient_status" />
          <field name="has_complete_survey"/>
          <field name="applicant_status"/>
          <button 
            name="action_open_health_survey" 
            string="Encuesta de salud" 
            type="object" 
            class="oe_highlight"
            attrs="{'invisible': [('has_complete_survey', '=', True)]}" />
        </tree>
      </field>
    </record>

    <!-- Question List -->
    <record model="ir.ui.view" id="tyt_recruitment_question_list">
      <field name="name">Lista de preguntas</field>
      <field name="model">tyt_recruitment.question</field>
      <field name="arch" type="xml">
        <tree string="Lista de Preguntas">
          <field name="text"/>
          <field name="type"/>
          <field name="state"/>
        </tree>
      </field>
    </record>

    <!-- Question List -->
    <record model="ir.ui.view" id="tyt_recruitment_parent_list">
      <field name="name">Lista de parientes</field>
      <field name="model">tyt_recruitment.family_data_detail</field>
      <field name="arch" type="xml">
        <tree string="Lista de Parientes">
          <field name="name" />
          <field name="occupation" width="200px" />
          <field name="phone_number" width="200px" />
        </tree>
      </field>
    </record>

    <!-- Encuesta completa -->
    <record model="ir.ui.view" id="tyt_recruitment_complete_survey_form">
      <field name="name">Formulario Encuesta de Salud completa</field>
      <field name="model">tyt_recruitment.complete_survey</field>
      <field name="arch" type="xml">
        <form string="Encuesta de Salud">
          <sheet>
            <group string="Información de la Encuesta">
              <field name="id" string="Fecha"/>
              <field name="state" string="Estado" />
            </group>

            <group string="Respuestas">
              <field name="survey_answer_ids" mode="tree,form" string="Respuestas" readonly="1">
                <tree editable="bottom">
                  <field name="id" />
                  <field name="question_id" />
                  <field name="text" />
                  <field name="extra_text" />
                  <field name="multiple_ids" />
                </tree>
              </field>
            </group>
            <group string="Comentarios del reclutador">
              <field name="recruiter_comments" attrs="{'readonly': False}" />
            </group>
            <group>
              <field name="signature_image" widget="image" class="oe_avatar" style="width: 300px; height: auto;" />
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Job Application form -->
    <record model="ir.ui.view" id="tyt_recruitment_job_application_form">
      <field name="name">Formulario de Solicitud</field>
      <field name="model">tyt_recruitment.job_application</field>
      <field name="arch" type="xml">
        <form string="Formulario de Pregunta">
          <sheet>
            <group string="Información General">
              <group>
                <field name="request_date"/>
                <field name="requisition"/>
                <field name="site"/>
                <field name="campaign_id"/>
                <field name="applicant_id"/>
              </group>
              <group>
                <field name="applicant_status" widget="toggle" />
                <field name="signature_image" widget="image" class="oe_avatar" style="width: 300px; height: auto;" />
                <field name="recruiter_id"/>
              </group>
            </group>

            <group string="Encuesta de Salud" colspan="2">
              <field name="has_complete_survey" widget="toggle" />
              <field name="complete_survey_id">
                <tree create="false">
                  <field name="id" width="120px"/>
                  <field name="survey_answer_ids" /> 
                  <field name="state" />
                </tree>
              </field>
            </group>
            
            <notebook>
              <page string="Formación académica">
                <field name="academics_ids" mode="tree,kanban,form" readonly="1" >
                  <tree readonly="1">
                    <field name="degree" width="200px" />
                    <field name="institution" width="200px" />
                    <field name="specification" width="200px" />
                  </tree>
                </field>
              </page>
              <page string="Hijos">
                <field name="children_ids" mode="tree,kanban,form" readonly="1" >
                  <tree readonly="1">
                    <field name="name" width="200px" />
                    <field name="age" width="200px" />
                  </tree>
                </field>
              </page>
              <page string="Historial Laboral">
                <field name="job_history_ids" mode="tree,kanban,form" readonly="1" >
                  <tree readonly="1">
                    <field name="company_name" />
                    <field name="start_date" width="200px" />
                    <field name="end_date" width="200px" />
                    <field name="separation_reason" width="200px" />
                    <field name="weekly_salary" width="200px" />
                  </tree>
                </field>
              </page>
              <page string="Referencias">
                <field name="reference_ids" mode="tree,kanban,form" readonly="1" >
                  <tree readonly="1">
                    <field name="name" />
                    <field name="type" width="200px" />
                    <field name="occupation" width="200px" />
                    <field name="phone_number" width="200px" />
                  </tree>
                </field>
              </page>
              <page string="Datos Familiares">
                <group>
                  <field name="father_data_id" readonly="1" />
                  <field name="mother_data_id" readonly="1" />
                  <field name="spouse_data_id" widget="monochrome" readonly="1" />

                  <span invisible="expedient_status == True"> En proceso </span>
                  <field name="status_loaded" widget="progressbar" />
                  <h3>Estatus de aprobación</h3>
                  <span invisible="applicant_status == False"> Completo </span>
                  <span invisible="applicant_status == True"> En proceso </span>
                  <field name="status_approved" widget="progressbar" />
                </div>
                <div class="oe_text">

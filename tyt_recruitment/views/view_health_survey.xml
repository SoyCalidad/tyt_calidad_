<odoo>
  <data>

    <!-- Health Survey List -->
    <record model="ir.ui.view" id="tyt_recruitment_health_survey_list">
      <field name="name">Lista de encuestas</field>
      <field name="model">tyt_recruitment.health_survey</field>
      <field name="arch" type="xml">
        <tree string="Lista de encuestas de salud">
          <field name="id" width="100px"/>
          <field name="name"/>
          <field name="code"/>
        </tree>
      </field>
    </record>

    <!-- Health Survey form -->
    <record model="ir.ui.view" id="tyt_recruitment_health_survey_form">
      <field name="name">Formulario de encuestas</field>
      <field name="model">tyt_recruitment.health_survey</field>
      <field name="arch" type="xml">
        <form string="Encuesta de salud">
          <sheet>
            <group>
              <field name="id"/>
              <field name="name"/>
              <field name="code"/>
            </group>
            <notebook>
              <page string="Preguntas">
                <field name="question_ids" nolabel="1" widget="question_page_one2many" >
                  <tree editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="title" widget="survey_description_page"/>
                    <field name="background_image" invisible="1"/>
                    <field name="question_type"/>
                    <field name="is_page" invisible="1"/>
                    <control>
                      <create name="add_question_control" string="Agregar pregunta"/>
                    </control>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
          <div class="oe_chatter">
            <field name="message_follower_ids" widget="mail_followers" />
            <field name="activity_ids" widget="mail_activity" />
            <field name="message_ids" widget="mail_thread" />
          </div>
        </form>
      </field>
    </record>

    <record model="ir.actions.act_window" id="tyt_recruitment_action_window_health_survey">
      <field name="name">Lista de encuestas</field>
      <field name="res_model">tyt_recruitment.health_survey</field>
      <field name="view_mode">tree,form</field>
      <field name="view_id" ref="tyt_recruitment_health_survey_list"/>
    </record>

    <menuitem id="menu_custom_health_survey"
      name="Configuración de encuestas"
      parent="menu_custom_recruitment"
      action="tyt_recruitment_action_window_health_survey" 
    />
  </data>
</odoo>
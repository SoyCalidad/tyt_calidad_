<odoo>
    <data>
        <!-- list evaluation_rubric -->
        <record model="ir.ui.view" id="tyt_recruitment_evalutation_rubric_list">
            <field name="name">Lista de rúbricas</field>
            <field name="model">tyt_recruitment.evaluation_rubric</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="id" />
                    <field name="week" />
                    <field name="date" />
                    <field name="auditor" />
                    <field name="coach" />
                    <field name="campaign" />
                </tree>
            </field>
        </record>

        <record id="evaluation_signature_wizard_form" model="ir.ui.view">
            <field name="name">Wizard Firma Evaluación</field>
            <field name="model">tyt_recruitment.evaluation_signature_wizard</field>
            <field name="arch" type="xml">
                <form string="Capturar Firma">
                    <group>
                        <field name="signature" widget="signature"/>
                    </group>
                    <footer>
                        <button name="action_save_signature" string="Guardar" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- form evaluation_rubric -->
        <record id="view_evaluation_rubric_form" model="ir.ui.view">
            <field name="name">Formulario de rúbrica</field>
            <field name="model">tyt_recruitment.evaluation_rubric</field>
            <field name="arch" type="xml">
                <form string="Requisición">
                <header>
                    <field name="state" invisible="1"/>
                    <button 
                        name="action_view_validate_and_notify" 
                        string="Validar y notificar" 
                        type="object" 
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'doing')]}"    
                    />   
                    <button 
                        name="action_view_signature" 
                        string="Firmar" 
                        type="object" 
                        class="oe_highlight"
                        attrs="{'invisible': [('state', '!=', 'validated_notified')]}"
                    />
                    <field name="state" widget="statusbar"/>
                </header>

                <sheet>  
                    <group>
                        <field name="week" />
                        <field name="date" />
                        <field name="auditor" />
                        <field name="coach" />
                        <field name="campaign" />
                    </group>
                    <notebook>
                        <page string="Detalles de la rúbrica">
                            <field name="status_approved" widget="progressbar" />
                            <field name="input_evaluation_rubric_ids" nolabel="1"> 
                                <tree editable="bottom">
                                    <field name="weighing" width="10px"/>
                                    <field name="concept" width="30px"/>
                                    <field name="description" width="200px"/>
                                    <field name="compliance" width="20px" />
                                    <field name="comment" />
                                </tree>
                            </field>
                        </page>
                        <page string="Firma" >
                            <field name="signature" widget="signature" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                </form>
            </field>
        </record>

        <!-- list evaluation_rubric -->

        <record model="ir.ui.view" id="tyt_recruitment.list">
            <field name="name">Lista de detalles de rúbrica para evaluación</field>
            <field name="model">tyt_recruitment.detail_evaluation_rubric</field>
            <field name="arch" type="xml">
                <tree>
                <field name="id" />
                <field name="weighing" />
                <field name="concept" />
                <field name="description" />
                </tree>
            </field>
        </record>

        <!-- actions opening views on models -->

        <record model="ir.actions.act_window" id="tyt_recruitment.action_window_rubric">
            <field name="name">Lista de rúbricas</field>
            <field name="res_model">tyt_recruitment.evaluation_rubric</field>
            <field name="view_mode">tree,form</field>
        </record>

        <record model="ir.actions.act_window" id="tyt_recruitment.action_window_detail_rubric">
            <field name="name">Lista de rúbricas</field>
            <field name="res_model">tyt_recruitment.detail_evaluation_rubric</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Top menu item -->

        <menuitem id="menu_custom_rubric"
            name="Rúbricas"
            parent="hr_recruitment.menu_hr_recruitment_root"
            sequence="24"
        />

        <menuitem id="menu_custom_evaluation_rubric"
            name="Lista de rúbricas"
            parent="menu_custom_rubric"
            action="tyt_recruitment.action_window_rubric"
        />

        <menuitem id="menu_custom_detail_evaluation_rubric"
            name="Componentes de rúbrica"
            parent="menu_custom_rubric"
            action="tyt_recruitment.action_window_detail_rubric"
        />
    </data>
</odoo>

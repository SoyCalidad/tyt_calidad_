<odoo>
    <data>
        <!-- Applicant List -->
        <record id="view_applicant_tree" model="ir.ui.view">
        <field name="name">Applicant Tree</field>
        <field name="model">tyt_recruitment.applicant</field>
        <field name="arch" type="xml">
            <tree>
                <field name="last_name_father"/>
                <field name="last_name_mother"/>
                <field name="name"/>
                <field name="social_security_number"/>
                <field name="number_phone"/>
                <field name="birthdate"/>
                <field name="birthplace"/>
                <field name="rfc"/>
                <field name="curp"/>
            </tree>
        </field>
        </record>

        <!-- Applicant template view -->
        <record id="template_applicants" model="ir.ui.view">
            <field name="name">tyt_recruitment.model.applicants.form</field>
            <field name="model">tyt_recruitment.applicant</field>
            <field name="arch" type="xml">
                <tree string="Lista">
                <field name="last_name_father"/>
                <field name="last_name_mother"/>
                <field name="name"/>
                <field name="employee_number"/>
                <field name="number_phone"/>
                <field name="birthdate"/>
                <field name="birthplace"/>
                <field name="rfc"/>
                <field name="curp"/>
                <field name="social_security_number"/>

                <field name="campaign_id"/>
                <field name="campaign_turn"/>
                <field name="recruiter_id"/>

                <field name="campaign_requsition"/>

                <field name="expedient_status" />
                <field name="has_complete_survey"/>
                <field name="status"/>
                <button 
                    name="show_job_application" 
                    string="Ver aplicación" 
                    type="object" 
                    class="oe_highlight" />
                </tree>
            </field>
        </record>

        <!-- Applicant form -->
        <record model="ir.ui.view" id="tyt_recruitment_applicant_form">
            <field name="name">Formulario  de aplicante</field>
            <field name="model">tyt_recruitment.applicant</field>
            <field name="priority" eval="10"/>
            <field name="arch" type="xml">
                <form string="Archivo">
                <sheet>
                    <separator string="Información general" />
                    <group>
                        <group>
                            <field name="name" />
                            <field name="last_name_father" />
                            <field name="last_name_mother" />
                        </group>
                        <group>
                            <field name="nationality" />
                            <field name="birthdate" />
                            <field name="birthplace" />
                        </group>
                    </group>
                    <separator string="Información social" />
                    <group>
                        <group>
                            <field name="reference" />
                            <field name="gender" />
                            <field name="age" />
                            <field name="marital_status" />
                        </group>
                        <group>
                            <field name="social_security_number" />
                            <field name="rfc" />
                            <field name="curp" />
                            <field name="employee_number" />
                        </group>
                    </group>
                    <separator string="Información de dirección" />
                    <group>
                        <group>
                            <field name="address_street" />
                            <field name="address_neighborhood" />
                            <field name="address_city" />
                        </group>
                        <group>
                            <field name="number_phone" />
                            <field name="personal_email" />
                            <field name="live_with" />
                        </group>
                    </group>
                    <separator string="Información adicional" />
                    <group>
                        <group>
                            <field name="rent_amount" />
                            <field name="infonavit_credit_amount" />
                            <field name="transports" />
                            <field name="requested_job_position" />
                            <field name="monthly_expenses" />
                        </group>
                        <group>
                            <field name="availability" />
                            <field name="dependents" />
                            <field name="live_with" />
                            <field name="foreign_nationality" />
                            <field name="daily_activities" />
                        </group>
                    </group>
                    <separator string="Reclutador" />
                    <group>
                        <field name="recruiter_comments" />
                    </group>
                </sheet>
                </form>
            </field>
        </record>

        <!-- Applicant Form -->
        <record model="ir.ui.view" id="tyt_recruitment_prospect_view_form">
            <field name="name">Formulario aplicante en asistencia</field>
            <field name="model">tyt_recruitment.applicant</field>
            <field name="priority" eval="20"/>
            <field name="arch" type="xml">
                <form string="Aplicante">
                    <!-- <header>
                        <button name="388" string="Launch Plan" type="action" modifiers="{&quot;invisible&quot;: [[&quot;active&quot;, &quot;=&quot;, false]]}"/>
                    </header> -->
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="open_requisition_view" type="object" class="oe_stat_button" icon="fa-check-square-o">
                                Requisición
                            </button>
                            <button 
                                name="open_user_input_view" 
                                type="object"
                                class="oe_stat_button" 
                                icon="fa-check-square-o">
                                Exámenes
                            </button>
                        </div>
                        <field name="rfc" modifiers="{&quot;invisible&quot;: true, &quot;readonly&quot;: true}"/>
                        <div class="o_employee_avatar">
                            <div id="hr_presence_status" class="d-flex align-items-end fs-6 o_employee_availability">
                                <!-- Employee is present/connected and it is normal according to his work schedule  -->
                                <small role="img" class="fa fa-fw fa-circle text-success o_button_icon hr_presence align-middle" aria-label="Present" title="Present" modifiers="{&quot;invisible&quot;: [[&quot;hr_icon_display&quot;, &quot;!=&quot;, &quot;presence_present&quot;]]}"/>
                                <!-- Employee is not present and it is normal according to his work schedule -->
                                <small role="img" class="fa fa-fw fa-circle-o text-muted o_button_icon hr_presence align-middle" aria-label="Absent" title="Absent" name="presence_absent" modifiers="{&quot;invisible&quot;: [[&quot;hr_icon_display&quot;, &quot;!=&quot;, &quot;presence_absent&quot;]]}"/>
                                <!-- Employee is connected but according to his work schedule, he should not work for now  -->
                                <small role="img" class="fa fa-fw fa-circle-o text-success o_button_icon hr_presence align-middle" aria-label="Present but not active" title="Present but not active" name="presence_absent_active" modifiers="{&quot;invisible&quot;: [[&quot;hr_icon_display&quot;, &quot;!=&quot;, &quot;presence_absent_active&quot;]]}"/>
                                <!-- Employee is not here but according to his work schedule, he should be connected -->
                                <small role="img" class="fa fa-fw fa-circle text-warning o_button_icon hr_presence align-middle" aria-label="To define" title="To define" name="presence_to_define" modifiers="{&quot;invisible&quot;: [[&quot;hr_icon_display&quot;, &quot;!=&quot;, &quot;presence_to_define&quot;]]}"/>
                            </div>
                        </div>
                        <div class="oe_title">
                            <separator string="Información personal" />
                            <h3>
                                <div>
                                    <field name="computed_name" />
                                </div>
                            </h3>
                            <separator string="Información adicional" />
                            <group>
                                <field name="social_security_number" />
                                <field name="rfc" />
                                <field name="curp" />
                                <field name="employee_number" />
                            </group>
                        </div>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" options="{'post_refresh': 'recipients'}"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>   
    </data>
</odoo>
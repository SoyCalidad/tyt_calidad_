<odoo>
  <data>
    <!-- list attendance -->
    <record model="ir.ui.view" id="tyt_recruitment.attendance_list">
      <field name="name">Lista de asistencia</field>
      <field name="model">tyt_recruitment.attendance</field>
      <field name="arch" type="xml">
        <tree>
          <field name="id"/>
          <field name="campaign_id"/>
          <field name="requisition_id"/>
          <field name="trainer"/>
          <field name="recruiter"/>
          <field name="turn"/>
          <button 
            name="action_view_evaluation_rubric" 
            string="Ver rúbrica de evaluación" 
            type="object" class="oe_highlight" 
            groups="tyt_recruitment.group_quality_user"
            attrs="{'invisible': [('trainer', '=', False)]}"
          />
        </tree>
      </field>
    </record>

    <!-- form attendance -->
    <record id="view_attendance_form" model="ir.ui.view">
      <field name="name">Formulario de Asistencia</field>
      <field name="model">tyt_recruitment.attendance</field>
      <field name="arch" type="xml">
        <form string="Asistencia">

            <field name="view_kardex" invisible="1" />
            <field name="view_kardex_certificate" invisible="1" />

            <header>
              <button name="action_view_kardex" string="Ver Kardex" type="object" class="oe_highlight" />
              <button name="action_view_kardex_certificate" string="Ver Certificación Kardex" type="object" class="oe_highlight" />
              <button name="action_send_concession" string="Enviar concesión" type="object" class="oe_highlight" />
              <field name="state" widget="statusbar"/>
            </header>

            <group col="6">
              <group >
                <field name="trainer"/>
                <field name="center"/>
                <field name="campaign_id" invisible="1" />
                <field name="campaign_ids" />
                <field name="week"/>
                <field name="turn"/>
                <field name="days"/>
                <field name="survey_counter"/>
              </group>
              <group >
                <field name="income"/>
              </group>
              <group >
                <field name="returns"/>
              </group>
              <group >
                <field name="desertion"/>
              </group>
            </group>
            <notebook>
            <page string="Lista de asistencia">
              <field name="attendance_days_of_week_ids" nolabel="1" options="{'no_create': True}">
                <tree editable="bottom">
                  <field name="login" width="30px" string="Número de empleado"/>
                  <field name="full_name" width="30px" />
                  <field name="day1" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 1)]}"/>
                  <field name="day2" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 2)]}"/>
                  <field name="day3" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 3)]}"/>
                  <field name="day4" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 4)]}"/>
                  <field name="day5" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 5)]}"/>
                  <field name="day6" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 6)]}"/>
                  <field name="day7" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 7)]}"/>
                  <field name="day8" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 8)]}" />
                  <field name="day9" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 9)]}" />
                  <field name="day10" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 10)]}" />
                  <field name="day11" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 11)]}" />
                  <field name="day12" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 12)]}" />
                  <field name="day13" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 13)]}" />
                  <field name="day14" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 14)]}" />
                  <field name="day15" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 15)]}" />
                  <field name="day16" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 16)]}" />
                  <field name="day17" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 17)]}" />
                  <field name="day18" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 18)]}" />
                  <field name="day19" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 19)]}" />
                  <field name="day20" width="30px" attrs="{'column_invisible': [('parent.days', '&lt;', 20)]}" />

                  <field name="opday1" width="30px" />
                  <field name="opday2" width="30px" />

                  <field name="campaign_id" />

                  <field name="recruiter" width="30px" />
                  <field name="prospect_turn" width="30px" />
                  <field name="right_turn" width="30px" />
                  <field name="observations" width="30px" />
                  <field name="experience" width="30px" />
                  <field name="reason_for_withdrawal" width="30px" />
                  <button 
                    name="show_applicant_details" 
                    string="Ver" 
                    type="object" 
                    class="oe_highlight" />
                </tree>
              </field>                  
            </page>
            <page string="Exámenes">
              <field name="surveys_ids" nolabel="1"> 
                <tree editable="bottom">
                  <field name="id" width="30px" />
                  <field name="survey_id" />
                </tree>
              </field>
            </page>
            <page string="Kardex" attrs="{'invisible': [('view_kardex', '=', False)]}" >
              <field name="kardex_by_applicant_ids" nolabel="1" options="{'no_create': True}">
                <tree editable="bottom">
                  <field name="login" width="30px" string="Número de empleado"/>
                  <field name="applicant_name" width="30px" />

                  <field name="experience" width="30px" />
                  <field name="time" width="30px" />
                  <field name="marital_status" width="30px" />
                  <field name="exam1" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 1)]}"/>
                  <field name="exam2" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 2)]}"/>
                  <field name="exam3" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 3)]}"/>
                  <field name="exam4" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 4)]}"/>
                  <field name="exam5" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 5)]}"/>
                  <field name="exam6" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 6)]}"/>
                  <field name="exam7" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 7)]}"/>
                  <field name="exam8" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 8)]}" />
                  <field name="exam9" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 9)]}" />
                  <field name="exam10" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 10)]}" />
                  <field name="exam11" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 11)]}" />
                  <field name="exam12" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 12)]}" />
                  <field name="exam13" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 13)]}" />
                  <field name="exam14" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 14)]}" />
                  <field name="exam15" width="30px" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 15)]}" />

                  <field name="average" width="30px" />
                  <field name="comments" width="30px" />
                </tree>
              </field>
            </page>
            <page string="Kardex - Certificación" groups="tyt_recruitment.group_quality_user" attrs="{'invisible': [('view_kardex_certificate', '=', False)]}">
              <field name="kardex_by_applicant_two_ids" nolabel="1" options="{'no_create': True}">
                <tree editable="bottom">
                  <field name="applicant_name" width="30px" readonly="1"/>
                  <field name="experience" width="30px" readonly="1"/>
                  <field name="time" width="30px" readonly="1"/>
                  <field name="marital_status" width="30px" readonly="1"/>

                  <field name="exam1" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 1)]}"/>
                  <field name="exam2" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 2)]}"/>
                  <field name="exam3" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 3)]}"/>
                  <field name="exam4" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 4)]}"/>
                  <field name="exam5" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 5)]}"/>
                  <field name="exam6" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 6)]}"/>
                  <field name="exam7" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 7)]}"/>
                  <field name="exam8" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 8)]}"/>
                  <field name="exam9" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 9)]}"/>
                  <field name="exam10" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 10)]}"/>
                  <field name="exam11" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 11)]}"/>
                  <field name="exam12" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 12)]}"/>
                  <field name="exam13" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 13)]}"/>
                  <field name="exam14" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 14)]}"/>
                  <field name="exam15" width="30px" readonly="1" attrs="{'column_invisible': [('parent.survey_counter', '&lt;', 15)]}"/>

                  <field name="average" width="30px" readonly="1"/>
                  <field name="comments" width="30px" readonly="1"/>

                  <field name="certification1" width="30px" />
                  <field name="certification2" width="30px" />
                  <field name="certification3" width="30px" />
                  <field name="highest_score" width="30px" />
                  <field name="comments_quality" width="30px" />
                  
                  <field name="accreditation_status" width="30px" />
                  <field name="concession" width="30px" />
                  <field name="observation" width="30px" />
                  <field name="has_certification_feedback" invisible="1" />
                  <button 
                    name="action_message_certification_feedback" 
                    title=" "
                    icon="fa-check" 
                    type="object" 
                    class="oe_highlight" 
                    attrs="{'invisible': [('has_certification_feedback', '=', False)]}"
                  />
                  <button 
                    name="action_new_certification_feedback" 
                    icon="fa-pencil" 
                    title=" "
                    type="object" 
                    class="oe_highlight" 
                    attrs="{'invisible': [('has_certification_feedback', '!=', False)]}"
                  />
                  <button 
                    name="action_open_certification_feedback_form" 
                    string="Retroalimentación" 
                    type="object" 
                    class="oe_highlight" 
                    attrs="{'invisible': [('has_certification_feedback', '=', False)]}"
                  />
                </tree>
              </field>
            </page>
          </notebook>
        </form>
      </field>
    </record>
    
    <!-- list tag attendance -->
    <record model="ir.ui.view" id="tyt_recruitment.tag_attendance_list">
      <field name="name">Lista de estados de asistencia</field>
      <field name="model">tyt_recruitment.tag_attendance</field>
      <field name="arch" type="xml">
        <tree>
          <field name="id"/>
          <field name="name"/>
          <field name="tag"/>
        </tree>
      </field>
    </record>

    <!-- actions opening views on models -->

    <record model="ir.actions.act_window" id="tyt_recruitment_action_window_attendance">
      <field name="name">Asistencias</field>
      <field name="res_model">tyt_recruitment.attendance</field>
      <field name="view_mode">tree,form</field>
    </record>

    <record model="ir.actions.act_window" id="tyt_recruitment_action_window_tag_attendance">
      <field name="name">Etiqueta de asistencia </field>
      <field name="res_model">tyt_recruitment.tag_attendance</field>
      <field name="view_mode">tree,form</field>
    </record>

    <!-- Top menu item -->

    <menuitem id="menu_custom_attendance"
      name="Capacitación"
      parent="hr_recruitment.menu_hr_recruitment_root"
      sequence="22"
    />

    <menuitem id="menu_custom_attendance_lista"
      name="Lista de asistencia"
      parent="menu_custom_attendance"
      action="tyt_recruitment_action_window_attendance"
    />

    <menuitem id="menu_custom_attendance_tag"
      name="Etiqueta de asistencia"
      parent="menu_custom_attendance"
      action="tyt_recruitment_action_window_tag_attendance"
    />
  </data>
</odoo>
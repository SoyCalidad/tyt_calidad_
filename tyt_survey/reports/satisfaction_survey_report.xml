<odoo>
    <data>
        <!-- Reporte para Satisfaction Survey -->
        <record id="action_report_satisfaction_survey_xlsx" model="ir.actions.report">
            <field name="name">Resultados de la satisfacción del cliente</field>
            <field name="model">tyt.satisfaction.survey</field>
            <field name="report_type">xlsx</field>
            <field name="report_name">tyt_survey.satisfaction_survey_report</field>
            <field name="report_file">tyt_survey.satisfaction_survey_report</field>
            <field name="binding_model_id" ref="model_tyt_satisfaction_survey"/>
            <field name="binding_type">report</field>
            <field name="attachment_use" eval="False"/>
        </record>

        <!-- Acción para Imprimir Encuestas -->
        <record id="action_print_satisfaction_survey" model="ir.actions.server">
            <field name="name">Imprimir Encuestas</field>
            <field name="model_id" ref="model_tyt_satisfaction_survey"/>
            <field name="state">code</field>
            <field name="code">
                action = env['ir.actions.report']._get_report_from_name('tyt_survey.satisfaction_survey_report').report_action(records)
            </field>
        </record>
    </data>
</odoo>

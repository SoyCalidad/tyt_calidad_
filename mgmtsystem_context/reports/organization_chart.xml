<?xml version='1.0' encoding='UTF-8'?>
<odoo>
  <data>
    <record id="action_report_organization_chart" model="ir.actions.report">
      <field name="model">mgmtsystem.context.organization_chart</field>
      <field name="name">Organigrama</field>
      <field name="report_type">qweb-pdf</field>
      <field name="report_name">mgmtsystem_context.organization_chart_report</field>
      <field name="report_file">mgmtsystem_context.organization_chart_report</field>
      <field name="groups_id" eval="[(6, 0, [ref('base.group_no_one'), ref('mgmtsystem_context.group_context_onlyread_printreport'), ref('mgmtsystem_context.group_context_write_printreport'), ref('mgmtsystem_context.group_context_all')])]"/>
    </record>
    <template id="organization_chart_report">
      <t t-call="web.html_container">
        <t t-foreach="docs" t-as="doc">
          <t t-call="web.external_layout">
            <div class="page">
              <h1>
                                Organigrama
                            </h1>
            </div>
          </t>
        </t>
      </t>
    </template>
  </data>
</odoo>

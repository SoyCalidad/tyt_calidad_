<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="system_process_edition_form_view_inherit_2" model="ir.ui.view">
        <field name="name">process.edition.view.form.inherit</field>
        <field name="model">process.edition</field>
        <field name="inherit_id" ref="mgmtsystem_process.system_process_edition_form_view_inherit"/>
        <field name="arch" type="xml">
            <field name="version" position="before">
                <separator string="Elaboración"/>
                <field name="elaboration_step" colspan="2" nolabel="1" readonly="state not in ['elaborate']"/>
                <separator string="Revisión"/>
                <field name="review_step" colspan="2" nolabel="1" 
                readonly="state not in ['elaborate', 'review']"/>
                <separator string="Validación"/>
                <field name="validation_step" colspan="2" nolabel="1" 
                readonly="state not in ['elaborate', 'review', 'validate']"/>
                <field name="date_elaborate" required="state in ['elaborate']"
                readonly="1"/>
                <field name="date_review" 
                required="state in ['review']" readonly="1" invisible="state in ['elaborate']"/>
                <field name="date_validate" groups="base.group_no_one,base.group_system" invisible="state in ['elaborate','review']"/>
                <field name="elaboration_users_check" invisible="1" />
                <field name="review_users_check" invisible="1" />
                <field name="validation_users_check" invisible="1" />
            </field>
        </field>
    </record>

</odoo>

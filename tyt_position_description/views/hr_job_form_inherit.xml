<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_hr_job_form_inherit" model="ir.ui.view">
            <field name="name">hr.job.form.inherit</field>
            <field name="model">hr.job</field>
            <field name="inherit_id" ref="hr.view_hr_job_form"/>
            <field name="arch" type="xml">
                <xpath expr="/form/sheet/notebook" position="inside">
                    <page string="Informacion">
                        <group>
                            <!-- Filosofía Organizacional -->
                            <field name="filosofia_organizacional" string="Filosofía Organizacional" widget="text"/>

                            <!-- Relación Interna -->
                            <field name="relacion_interna" string="Relación Interna" widget="text"/>

                            <!-- Relación Externa -->
                            <field name="relacion_externa" string="Relación Externa" widget="text"/>

                            <!-- Valores -->
                            <field name="valores" string="Valores" widget="text"/>

                            <!-- Plan Estratégico -->
                            <field name="plan_estrategico" string="Plan Estratégico" widget="text"/>
                        </group>

                        <group string="OMEM (Balance Scorecard)">
                            <!-- Finanzas -->
                            <field name="finanzas_indicador" string="Indicador Finanzas"/>
                            <field name="finanzas_meta" string="Meta Finanzas (%)"/>

                            <!-- Cliente -->
                            <field name="cliente_indicador" string="Indicador Cliente"/>
                            <field name="cliente_meta" string="Meta Cliente (%)"/>

                            <!-- Procesos -->
                            <field name="procesos_indicador" string="Indicador Procesos"/>
                            <field name="procesos_meta" string="Meta Procesos (%)"/>

                            <!-- Gente -->
                            <field name="gente_indicador" string="Indicador Gente"/>
                            <field name="gente_meta" string="Meta Gente (%)"/>
                        </group>

                        <group string="KPI´s">
                            <!-- Estratégico -->
                            <field name="estrategico_indicador" string="Indicador Estratégico"/>
                            <field name="estrategico_meta" string="Meta Estratégico (%)"/>

                            <!-- Costo -->
                            <field name="costo_indicador" string="Indicador Costo"/>
                            <field name="costo_meta" string="Meta Costo (%)"/>

                            <!-- Velocidad de Respuesta -->
                            <field name="velocidad_respuesta_indicador" string="Indicador Velocidad de Respuesta"/>
                            <field name="velocidad_respuesta_meta" string="Meta Velocidad de Respuesta (%)"/>

                            <!-- Disponibilidad -->
                            <field name="disponibilidad_indicador" string="Indicador Disponibilidad"/>
                            <field name="disponibilidad_meta" string="Meta Disponibilidad (%)"/>

                            <!-- Efectividad de Proceso -->
                            <field name="efectividad_proceso_indicador" string="Indicador Efectividad de Proceso"/>
                            <field name="efectividad_proceso_meta" string="Meta Efectividad de Proceso (%)"/>
                        </group>

                        <group string="Datos">
                            <field name="puntos_valuacion" string="Puntos (Valuación)" />
                            <field name="categoria" string="Categoría" />
                            <field name="nivel_organizacional" string="Nivel Organizacional" />
                        </group>
                    </page>
                </xpath>

                <xpath expr="/form/sheet/notebook" position="inside">
                    <page string="Beneficios">
                        <group>
                            <field name="fondo_ahorro"/>
                            <field name="beca_estudiantil"/>
                            <field name="r_casa"/>
                            <field name="v_despensa"/>
                            <field name="v_gasolina"/>
                            <field name="seguro_medico_mayor"/>
                            <field name="auto"/>
                        </group>
                    </page>

                    <page string="Objetivos">
                        <group>
                            <field name="objetivo_general"/>
                            <field name="objetivo_puesto"/>
                        </group>
                    </page>
                </xpath>

            </field>
        </record>

        <record id="your_custom_applicant_view_form" model="ir.ui.view">
            <field name="name">hr.applicant.form.inherit</field>
            <field name="model">hr.applicant</field>
            <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='job_id']" position="after">
                    <field name="first_option"/>
                            <field name="second_option"/>
                            <field name="third_option"/>
                            <field name="curso"/>   
                </xpath>

                <xpath expr="//field[@name='priority']" position="after">
                    <field name="tiempo_graduacion" string="Tiempo de Graduación"/>
                    <field name="salario_fijo" string="Salario Fijo"/>
                    <field name="salario_variable" string="Salario Variable"/>
                    <field name="salario_integral" string="Salario Integral"/>
                    <field name="ratio_vacante" string="Ratio p/ Vacante"/>
                    <field name="personal_directo" string="Personal Directo"/>
                    <field name="personal_indirecto" string="Personal Indirecto"/>
                    <field name="escolaridad" string="Escolaridad"/>
                    <field name="edad_minima" string="Edad Mínima"/>
                    <field name="idiomas" string="Idiomas"/>
                </xpath>

                
            </field>
        </record>
    </data>
</odoo>


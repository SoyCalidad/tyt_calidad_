<?xml version="1.0"?>
<odoo>

    <data noupdate="0">

        <record id="email_template_mgmtsystem_audit" model="mail.template">
            <field name="name">Inspección: Enviar por correo electrónico</field>
            <field name="model_id" ref="mgmtsystem_audit.model_audit_audit" />
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email) }}&gt;</field>
            <field name="subject">{{ object.company_id.name }} Cronograma auditoría {{ object.audit_date }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Estimado/a,
                    </p>
                    <p>
                        Le hago llegar el cronograma de auditoría que se realizará el <t t-out="object.audit_date or ''"/>
                    </p>
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <!-- <field name="report_template" ref="mgmtsystem_audit.action_report_audit" /> -->
            <field name="report_template_ids" eval="[(6,0,[
                ref('mgmtsystem_audit.action_report_audit')
            ])]" />
            <field name="auto_delete" eval="True" />
        </record>
    </data>

</odoo>

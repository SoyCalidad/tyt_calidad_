<odoo>
    <data>

        <record id="report_line_view_form" model="ir.ui.view">
            <field name="name">report.line.view.form</field>
            <field name="model">report.line</field>
            <field name="arch" type="xml">
                <form string="Lineas de reporte de auditoría">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" />
                            <h1>
                                <field name="name" />
                            </h1>
                        </div>
                        <group cols="4">
                            <field name="date_audit" />
                            <field name="employee_id" />
                            <field name="datetime" />
                            <field name="found" style="display:block;max-width:480px;overflow-wrap:break-word;" colspan="4" />
                            <field name="observations" style="display:block;max-width:480px;overflow-wrap:break-word;" colspan="4" />
                            <field name="image_attached" />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="report_line_view_tree" model="ir.ui.view">
            <field name="name">report.line.view.tree</field>
            <field name="model">report.line</field>
            <field name="arch" type="xml">
                <list string="Lineas de reporte de auditoría">
                    <field name="name" />
                    <field name="date_audit" />
                    <field name="employee_id" />
                    <field name="datetime" />
                    <field name="found" />
                    <field name="image_attached" />
                </list>
            </field>
        </record>

        <record id="report_line_action" model="ir.actions.act_window">
            <field name="name">Líneas de reporte de auditoría</field>
            <field name="res_model">report.line</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
            <field name="help" type="html">
                <p>
                    <b>Líneas de reporte de auditoría</b>
                </p>
            </field>
        </record>

        <record model="ir.ui.view" id="view_document_file_kanban_report_line">
            <field name="name">view.document.file.kanban.training</field>
            <field name="model">report.line.document</field>
            <field name="arch" type="xml">
                <kanban>
                    <field name="ir_attachment_id" />
                    <field name="mimetype" />
                    <field name="type" />
                    <field name="name" />
                    <field name="priority" />
                    <templates>
                        <t t-name="card">
                            <main class="oe_kanban_global_click">
                                <div class="oe_kanban_vignette">
                                    <div class="oe_attachment">
                                        <div class="row">
                                            <div class="col-xs-4 o_kanban_primary_left" t-if="record.type.raw_value == 'binary'">
                                                <a t-attf-href="/web/content/#{record.ir_attachment_id.raw_value}?download=1">
                                                    <t t-set="webimage" t-value="new RegExp('image.*(gif|jpeg|jpg|png)').test(record.mimetype.value)" />
                                                    <div t-if="!webimage" class="o_image" t-att-data-mimetype="record.mimetype.value" />
                                                    <div t-if="webimage" class="o_attachment_image">
                                                        <img t-attf-src="/web/image/#{record.ir_attachment_id.raw_value}?download=1" alt="Archivo adjunto"/>
                                                    </div>
                                                </a>
                                            </div>
                                            <div class="col-xs-8">
                                                <strong>
                                                    <field name="name" />
                                                </strong>
                                                <br />
                                                <div class="mt8">
                                                    <field name="priority" widget="priority" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </main>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
        <!--
        <record id="view_document_form" model="ir.ui.view">
            <field name="name">report.line.document.form</field>
            <field name="model">report.line.document</field>
            <field name="inherit_id" ref="base.view_attachment_form" />
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='mimetype']" position="after">
                    <field name="priority" widget="priority" />
                </xpath>
            </field>
        </record>
        -->
        <record id="view_audit_report_search" model="ir.ui.view">
            <field name="name">audit.report.search</field>
            <field name="model">audit.report</field>
            <field name="arch" type="xml">
                <search>
                    <field name="audit_id" />
                </search>
            </field>
        </record>

        <record id="view_audit_report_tree" model="ir.ui.view">
            <field name="name">audit.report.tree</field>
            <field name="model">audit.report</field>
            <field name="arch" type="xml">
                <list string="Informe" >
                    <field name="audit_id" />
                    <field name="name" />
                    <field name="location" />
                    <field name="auditor_id" />
                    <field name="team_id" />
                    <field name="create_date" string="Fecha de creación" />
                </list>
            </field>
        </record>

        <record id="view_audit_report_form" model="ir.ui.view">
            <field name="name">audit.report.form</field>
            <field name="model">audit.report</field>
            <field name="arch" type="xml">
                <form string="Informe">
                    <header>
                        <field name="state" widget="statusbar" />
                        <button string="Finalizar"
                                name="send_final"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ['draft', 'in_process']" />
                    </header>
                    <sheet>
                        <div name="button_box" class="oe_button_box"></div>
                        <h1>
                            <field name="code" />
                        </h1>
                        <div class="oe_title">
                            <label for="name" />
                            <h2>
                                <field name="name" readonly="state not in ['draft']" />
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="location" readonly="state not in ['draft', 'in_process']" />
                                <field name="standard" readonly="state not in ['draft', 'in_process']" invisible="1" />
                                <field name="auditor_id" readonly="state not in ['draft', 'in_process']" />
                            </group>
                            <group>
                                <field name="team_id" readonly="state not in ['draft', 'in_process']" />
                                <field name="audit_id" readonly="state not in ['draft']" />
                            </group>
                        </group>
                        <group>
                            <field name="scope" string="Alcance" readonly="state not in ['draft', 'in_process']" />
                        </group>
                        <group>
                            <field name="golds" string="Objetivos" readonly="state not in ['draft', 'in_process']" />
                        </group>
                        <notebook>
                            <page string="Lineas">
                                <field name="line_ids" readonly="state not in ['draft']">
                                    <list>
                                        <field name="name" />
                                        <field name="employee_id" />
                                        <field name="datetime" />
                                        <field name="found"  />
                                        <field name="image_attached" string="Adjuntos" />
                                    </list>
                                </field>
                            </page>
                            <page name="conclusions" string="Conclusiones">
                                <group>
                                    <field name="conclusions" />
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="img_adjunt_form" model="ir.ui.view">
            <field name="name">img_adjunt.form</field>
            <field name="model">img.adjunt</field>
            <field name="arch" type="xml">
                <form string="Adjunto">
                    <group>
                        <field name="name" />
                    </group>
                    <group>
                        <field name="image_attached" />
                        <field name="report_line_id" invisible="True" />
                    </group>
                </form>

            </field>
        </record>

        <record id="view_audit_audit_tree" model="ir.ui.view">
            <field name="name">audit.audit.tree</field>
            <field name="model">audit.audit</field>
            <field name="arch" type="xml">
                <list string="Plan de auditoría">
                    <field name="name" />
                    <field name="auditor_id" />
                    <field name="location" />
                    <field name="month_training" />
                    <field name="date_init" />
                    <field name="date_fin" />
                    <field name="duration" widget="float_time" />
                    <field name="type" />
                    <field name="state" />
                    <field name="create_date" string="Fecha de creación" />
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="show_audit_report_action">
            <field name="name">Informes</field>
            <field name="res_model">audit.report</field>
            <field name="view_mode">list,form</field>
            <field name="context">{"search_default_audit_id": active_id, "default_audit_id": active_id}</field>
            <field name="search_view_id" ref="view_audit_report_search" />
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">No existen informes para este plan de auditoría, cree una.</p>
            </field>
        </record>

        <!-- audit.report action window -->
        <record id="audit_report_action" model="ir.actions.act_window">
            <field name="name">Informes de auditoría</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">audit.report</field>
            <field name="view_mode">list,form</field>

        </record>

        <record id="view_audit_audit_form" model="ir.ui.view">
            <field name="name">audit.audit.form</field>
            <field name="model">audit.audit</field>
            <field name="arch" type="xml">
                <form string="Plan de auditoría">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="elaborate,review,validate,validate_ok,final" />
                        <!-- <button string="Enviar a Elaborar" name="send_elaborate" type="object" class="btn-primary" attrs="{'invisible':[(''))]}"/> -->
                        <button string="Enviar a Revisar"
                                name="send_review"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'elaborate'" />
                        <button string="Enviar a Validar"
                                name="send_validate"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'review'" />
                        <button string="Validar"
                                name="send_validate_ok"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'validate'" />
                        <button string="Notificar empleados"
                                name="action_notify_employee"
                                type="object"
                                class="btn-success"
                                invisible="state not in ['validate_ok']" />
                        <button name="action_mail_send"
                                string="Notificar por email"
                                type="object"
                                class="oe_highlight"
                                invisible="state != 'validate_ok'" />
                        <button string="Finalizar"
                                name="send_final"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'validate_ok'" />
                        <button name="button_new_version"
                                type="object"
                                string="Nueva versión"
                                invisible="state != 'final'"
                                class="oe_highlight" />
                        <button string="Crear informe de auditoría"
                                name="open_audit_report_form"
                                type="object"
                                class="oe_highlight"
                                invisible="state not in ['send']" />
                        <button string="Volver Obsoleto"
                                confirm="Esto volverá obsoleto el presente registro. ¿Está seguro(a)?"
                                name="send_cancel"
                                type="object"
                                class="btn-second"
                                invisible="state == 'cancel'" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="action" name="%(show_audit_report_action)d" class="oe_stat_button" icon="fa-briefcase">
                                <field name="report_count" widget="statinfo" string="Informes de auditoría" />
                            </button>
                            <button type="object"
                                    name="action_open_older_versions"
                                    class="oe_stat_button"
                                    icon="fa-archive"
                                    style="white-space: nowrap;"
                                    string="Versiones antiguas" />
                        </div>
                        <div class="oe_title">
                            <label for="code" />
                            <h2>
                                <field name="code" />
                            </h2>
                            <label for="name" />
                            <h2>
                                <field name="name" readonly="state not in ['elaborate']" />
                            </h2>
                        </div>
                        <group readonly="state in ['send', 'final', 'cancel']">
                            <group>
                                <field name="auditor_id"  />
                                <field name="team_id"  />
                                <field name="plan_id"  />
                                <field name="process_id"  />
                                <field name="type"  />
                                <field name="location"  />
                                <field name="responsable_id" />
                            </group>
                            <group>
                                <field name="month_training"  />
                                <field name="date_init" required="state in ['validate_ok']" />
                                <field name="date_fin" required="state in ['validate_ok']" />
                                <field name="duration" widget="float_time"  />
                            </group>
                        </group>
                        <group>
                            <group>
                                <field name="observations" string="Alcance"  />
                            </group>
                            <group>
                                <field name="golds" string="Objetivos"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Planificación">
                                <field name="line_ids"  context="{'default_datetime': date_init}">
                                    <list editable="bottom">
                                        <field name="sequence" widget="handle" readonly="False" />
                                        <field name="name" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                        <field name="datetime" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                        <field name="department_id" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                        <field name="employee_id" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                        <field name="auditor_ids" widget="many2many_tags" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                        <field name="observations" readonly="parent.state in ['cancel']" />
                                    </list>
                                </field>
                            </page>
                            <page name="validation" string="Validación y versión">
                                <group col="4">
                                    <group colspan="4">
                                        <field name="version" />
                                    </group>
                                    <group colspan="4">
                                        <separator string="Elaboración" />
                                        <field name="elaboration_step" colspan="2" nolabel="1" readonly="state not in ['elaborate']" />
                                        <separator string="Revisión" />
                                        <field name="review_step" colspan="2" nolabel="1" readonly="state not in ['elaborate', 'review']" />
                                        <separator string="Validación" />
                                        <field name="validation_step" colspan="2" nolabel="1" readonly="state not in ['elaborate', 'review', 'validate']" />
                                    </group>
                                    <group colspan="4">
                                        <field name="date_elaborate" readonly="True" required="state in ['elaborate']" />
                                        <field name="date_review" invisible="state in ['elaborate']" readonly="True" required="state in ['review']" />
                                        <field name="date_validate" groups="base.group_no_one,base.group_system" invisible="state in ['elaborate', 'review']" />
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="audit_audit_action" model="ir.actions.act_window">
            <field name="name">Plan de auditorías</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">audit.audit</field>
            <field name="view_mode">list,form,kanban,graph,pivot</field>
        </record>

        <menuitem id="audit_audit_item"
                  name="Plan de Auditorías"
                  parent="menu_audit_root"
                  sequence="2"
                  action="audit_audit_action" />

        <menuitem id="audit_report_items"
                  name="Informe de auditoría"
                  parent="menu_audit_root"
                  sequence="3"
                  action="audit_report_action" />
    </data>
</odoo>

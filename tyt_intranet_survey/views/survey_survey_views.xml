<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_survey_view_form" model="ir.ui.view">
        <field name="name">survey.survey.view.form.inherit</field>
        <field name="model">survey.survey</field>
        <field name="inherit_id" ref="survey.survey_survey_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='users_can_go_back']" position="after">
                <field name="questions_mandatory"/>
                <field name="publish_state" invisible="1"/>
            </xpath>
            <xpath expr="//group[@name='participants']//field[@name='access_mode']" position="attributes">
                <attribute name="readonly">publish_state == 'published'</attribute>
            </xpath>
            <xpath expr="//field[@name='users_login_required']" position="attributes">
                <attribute name="invisible">access_mode == 'intranet'</attribute>
            </xpath>
            <xpath expr="//label[@for='is_attempts_limited']" position="attributes">
                
                <attribute name="invisible">(access_mode == "intranet" or (access_mode == "public" and users_login_required == False))</attribute>
            </xpath>
            <xpath expr="//field[@name='is_attempts_limited']" position="attributes">
                <attribute name="invisible">(access_mode == "intranet" or (access_mode == "public" and users_login_required == False))</attribute>
            </xpath>
            <xpath expr="//field[@name='question_and_page_ids']" position="attributes">
                <attribute name="context">{
                        'default_survey_id': context.get('active_id'),
                        'default_questions_selection': questions_selection,
                        'default_constr_mandatory': questions_mandatory,
                    }
                </attribute>
            </xpath>
        </field>
    </record>

    <record id="survey_survey_view_search" model="ir.ui.view">
        <field name="name">survey.survey.search</field>
        <field name="model">survey.survey</field>
        <field name="arch" type="xml">
            <search string="Survey">
                <field string="Survey" name="title"/>
                <filter string="Published Start Date" name="published_start_date" date="published_start_date"/>
                <filter string="Published End Date" name="published_end_date" date="published_end_date"/>
                <group expand="0" string="Group By">
                    <filter string="Job Position" name="job_id" context="{'group_by':'job_id'}"/>
                    <filter string="Department" name="department_id" context="{'group_by':'department_id'}"/>
                </group>
                <searchpanel>
                    <field name="job_id" icon="fa-users" enable_counters="1"/>
                    <field name="department_id" icon="fa-users" enable_counters="1"/>
                </searchpanel>
            </search>
        </field>
    </record>

    <record id="survey_survey_action" model="ir.actions.act_window">
        <field name="name">Surveys</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">kanban,list,form,graph,pivot</field>
        <field name="context">{
                'default_access_mode': 'intranet',
                'default_questions_mandatory': True,
                'default_scoring_type': 'scoring_without_answers',
                'default_scoring_success_min': 0.0,
                'default_users_login_required': True,
            }
        </field>
    </record>

    <record id="survey_survey_view_tree_management" model="ir.ui.view">
        <field name="name">survey.survey.view.tree.management</field>
        <field name="model">survey.survey</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="false" delete="false">
                <field name="title" readonly="publish_state == 'published'"/>
                <field name="user_id" widget="many2one_avatar_user" readonly="publish_state == 'published'"/>
                <field name="job_id" readonly="publish_state == 'published'"/>
                <field name="department_id" readonly="publish_state == 'published'"/>
                <field name="gps" widget="boolean_toggle" readonly="publish_state == 'published'"/>
                <field name="group_ids" widget="many2many_tags" readonly="publish_state == 'published'"/>
                <field name="published_start_date" readonly="1"/>
                <field name="published_end_date" readonly="1"/>
                <field name="publish_state" widget="badge" decoration-info="publish_state == 'draft'" decoration-success="publish_state == 'published'"/>
            </list>
        </field>
    </record>

    <record id="survey_survey_action_management" model="ir.actions.act_window">
        <field name="name">Survey Management</field>
        <field name="res_model">survey.survey</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="survey_survey_view_search"/>
        <field name="context">{'list_view_ref': 'tyt_intranet_survey.survey_survey_view_tree_management'}</field>
        <field name="domain">[('access_mode', '=', 'intranet')]</field>
    </record>

    <record id="tyt_x_area_encuesta_view_form" model="ir.ui.view">
        <field name="name">x_area_encuesta.view.form</field>
        <field name="model">x_area_encuesta</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tyt_x_area_encuesta_view_tree" model="ir.ui.view">
        <field name="name">x_area_encuesta.view.tree</field>
        <field name="model">x_area_encuesta</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <record id="tyt_x_area_encuesta_action" model="ir.actions.act_window">
        <field name="name">Areas - Typification</field>
        <field name="res_model">x_area_encuesta</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'list_view_ref': 'tyt_intranet_survey.tyt_x_area_encuesta_view_tree',
            'form_view_ref': 'tyt_intranet_survey.tyt_x_area_encuesta_view_form',
        }
        </field>
    </record>

    <record id="tyt_x_tipo_encuesta_view_form" model="ir.ui.view">
        <field name="name">x_tipo_encuesta.view.form</field>
        <field name="model">x_tipo_encuesta</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="x_name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tyt_x_tipo_encuesta_view_tree" model="ir.ui.view">
        <field name="name">x_tipo_encuesta.view.tree</field>
        <field name="model">x_tipo_encuesta</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="x_name"/>
            </list>
        </field>
    </record>

    <record id="tyt_x_tipo_encuesta_action" model="ir.actions.act_window">
        <field name="name">Tipos - Typification</field>
        <field name="res_model">x_tipo_encuesta</field>
        <field name="view_mode">list,form</field>
        <field name="context">{
            'list_view_ref': 'tyt_intranet_survey.tyt_x_tipo_encuesta_view_tree',
            'form_view_ref': 'tyt_intranet_survey.tyt_x_tipo_encuesta_view_form',
        }
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="survey_question_form" model="ir.ui.view">
        <field name="name">survey.question.form.inherit</field>
        <field name="model">survey.question</field>
        <field name="inherit_id" ref="survey.survey_question_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='options']" position="inside">
                <group>
                    <group string="Typification" name="typification">
                        <field name="survey_publish_state" invisible="1"/>
                        <field name="area_encuesta_id" widget="selection" readonly="survey_publish_state == 'published'"/>
                        <field name="tipo_encuesta_id" widget="selection" readonly="survey_publish_state == 'published'"/>
                    </group>
                    <group>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="tyt_survey_question_answer_view_form" model="ir.ui.view">
        <field name="name">tyt.survey.question.answer.view.form</field>
        <field name="model">tyt.survey.question.answer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="value"/>
                        <field name="answer_score"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="tyt_survey_question_answer_view_tree" model="ir.ui.view">
        <field name="name">tyt.survey.question.answer.view.tree</field>
        <field name="model">tyt.survey.question.answer</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="value"/>
                <field name="answer_score"/>
            </list>
        </field>
    </record>

    <record id="tyt_survey_question_answer_action" model="ir.actions.act_window">
        <field name="name">Suggested Answers</field>
        <field name="res_model">tyt.survey.question.answer</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

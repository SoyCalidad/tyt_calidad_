<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <template id="portal_my_home_survey"
              name="survey" customize_show="True"
              inherit_id="portal.portal_my_home" priority="55">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Survey</t>
                <t t-set="url" t-value="'/my/surveys'"/>
                <t t-set="placeholder_count" t-value="'survey_count'"/>
            </t>
        </xpath>
    </template>

    <template id="portal_my_home_menu_survey" name="Portal layout : survey menu entry" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'survey'" class="breadcrumb-item active">
                Surveys
            </li>
        </xpath>
    </template>

    <template id="portal_my_surveys" name="Surveys">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Surveys</t>
            </t>
            <t t-if="not surveys">
                <div class="alert alert-warning" role="alert">There are currently no surveys for your account.</div>
            </t>
            <div class="container">
                <div class="row">
                    <t t-foreach="surveys" t-as="survey">
                        <div class="col-12 col-sm-6 d-flex align-items-stretch mb-4">
                            <div class="card w-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">
                                        <strong>
                                            <t t-esc="survey.title"/>
                                        </strong>
                                    </h5>
                                    <p class="card-text mt-2">
                                        <i class="fa fa-fw fa-clock-o" title="Fecha de publicación"/>
                                        <t t-esc="survey.published_start_date"/>
                                        <span class="fa fa-long-arrow-right"/>
                                        <t t-esc="survey.published_end_date"/>
                                    </p>
<!--                                    <div class="d-flex justify-content-between align-items-center mt-auto">-->
<!--                                        <a t-att-href="'/survey/start/%s' % data['access_token']"-->
<!--                                           t-att-class="'btn btn-primary ' + ('disabled' if data['has_answered'] else '')">-->
<!--                                            Participar-->
<!--                                        </a>-->
<!--                                        <span t-att-class="'badge o_wslides_channel_tag bg-' + data['color_state']">-->
<!--                                            <t t-esc="data['answer_state']"/>-->
<!--                                        </span>-->
<!--                                    </div>-->
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_menu_survey" name="Portal layout : survey menu entry" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'survey'" class="breadcrumb-item active">
                Surveys
            </li>
        </xpath>
    </template>

    <template id="portal_my_surveys" name="Surveys">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Surveys</t>
            </t>
            <t t-if="not survey_data">
                <div class="alert alert-warning" role="alert">There are currently no surveys for your account.</div>
            </t>
            <div class="container">
                <div class="row">
                    <t t-foreach="survey_data" t-as="data">
                        <t t-if="data['answer_token']">
                            <div class="col-12 col-sm-6 d-flex align-items-stretch mb-4">
                                <div class="card w-100">
                                    <div class="card-body d-flex flex-column">
                                        <h4 class="card-title">
                                            <t t-esc="data['survey'].title"/>
                                        </h4>
                                        <p class="card-text mt-2">
                                            <i class="fa fa-fw fa-clock-o" title="Published Date" alt="Published Date"/>
                                            <time>
                                                <span t-field="data['survey'].published_start_date" t-options="{'format':'d MMM yyyy'}"/>
                                            </time>
                                            <span class="fa fa-long-arrow-right"/>
                                            <time>
                                                <span t-field="data['survey'].published_end_date" t-options="{'format':'d MMM yyyy'}"/>
                                            </time>
                                        </p>
                                        <div class="d-flex justify-content-between align-items-center mt-auto">
                                            <a t-att-href="'/survey/start/%s?answer_token=%s' % (data['survey'].access_token, data['answer_token'])"
                                               class="btn btn-primary mt-auto">
                                                Participate
                                            </a>
                                            <span t-att-class="'badge o_wslides_channel_tag bg-' + data['answer_color_state']">
                                                <t t-esc="data['answer_state']"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </t>
                </div>
            </div>
        </t>
    </template>
</odoo>

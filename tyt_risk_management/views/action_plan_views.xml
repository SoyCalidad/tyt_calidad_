<odoo>
    <record id="view_risk_action_plan_form" model="ir.ui.view">
        <field name="name">tyt.risk.action.plan.form</field>
        <field name="model">tyt.risk.action.plan</field>
        <field name="arch" type="xml">
            <form string="Plan de acción">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="user_id" />
                        <field name="remediation_date" required="True" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

   

    <record id="view_risk_action_plan_list" model="ir.ui.view">
        <field name="name">tyt.risk.action.plan.list</field>
        <field name="model">tyt.risk.action.plan</field>
        <field name="arch" type="xml">
            <list string="Plan de acción" create="0">
                <field name="risk_id_id"  />
                <field name="mitigation_id_period_str" />
                <field name="risk_id_domain_id" />
                <field name="risk_id_process_id" />
                <field name="risk_id_subprocess_id" />
                <field name="sequence" />
                <field name="name" />
                <field name="create_uid" string="Creado por" />
                <field name="user_id" />
                <field name="remediation_date" />
                <field name="status"
                    decoration-warning="status=='under_review'"
                    decoration-muted="status=='pending'"
                    decoration-success="status=='complete'"
                />
                <button name="action_view_mitigation" 
                    string="Ver Mitigación" 
                    type="object" 
                    icon="fa-external-link" 
                    class="btn btn-primary"/>
            </list>
        </field>
    </record>

    <record id="view_risk_action_plan_search" model="ir.ui.view">
        <field name="name">risk.action.plan.search</field>
        <field name="model">tyt.risk.action.plan</field>
        <field name="arch" type="xml">
            <search string="Filtros de Planes de Acción">
                <field name="name" />
                <field name="risk_id" />
                <field name="risk_id_department_id" />
                <field name="user_id" />

                <filter string="Completados" name="status_completed"
                    domain="[('status', '=', 'complete')]" />
                <filter string="Pendiente" name="status_progress"
                    domain="[('status', '=', 'pending')]" />
                <separator />
                <filter string="Mis Planes" name="my_plans"
                    domain="[('user_id', '=', uid)]" />
                <filter string="Archivados" name="inactive" domain="[('active', '=', False)]" />

                <group expand="0" string="Agrupar Por">
                    <filter string="Año" name="group_by_year" context="{'group_by': 'mitigation_id_year'}" />
                    <filter string="Mes" name="group_by_month" context="{'group_by': 'mitigation_id_month'}" />
                    <filter string="Departamento" name="group_by_dept"
                        context="{'group_by': 'risk_id_department_id'}" />
                    <filter string="Estado" name="group_by_status" context="{'group_by': 'status'}" />
                </group>
            </search>
        </field>
    </record>

    <record id="action_risk_action_plan" model="ir.actions.act_window">
        <field name="name">Planes de Acción</field>
        <field name="res_model">tyt.risk.action.plan</field>
        <field name="view_mode">list,kanban</field>
        <field name="search_view_id" ref="view_risk_action_plan_search" />
        <field name="context">{
            'search_default_group_by_year': 1,
            'search_default_group_by_month': 1
            }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea el primer plan de acción para mitigar riesgos.
            </p>
        </field>
    </record>
</odoo>
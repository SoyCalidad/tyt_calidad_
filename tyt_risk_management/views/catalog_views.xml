<odoo>
       <record id="view_catalog_frequency_list" model="ir.ui.view">
        <field name="name">catalog.frequency.list</field>
        <field name="model">tyt.catalog.frequency</field>
        <field name="arch" type="xml">
            <list expand="1" multi_edit="1" editable="bottom">
                <field name="name" string="Sub Proceso"/>
                <field name="active" string="Estatus" widget="boolean_toggle" />
            </list>
        </field>


    </record>

     <record id="action_catalog_frequency" model="ir.actions.act_window">
        <field name="name">Frecuencia</field>
        <field name="res_model">tyt.catalog.frequency</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
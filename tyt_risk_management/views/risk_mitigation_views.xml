<odoo>
    <record id="view_risk_mitigation_mitigation_list" model="ir.ui.view">
        <field name="name">risk.mitigation.mitigation.list</field>
        <field name="model">tyt.risk.mitigation</field>
        <field name="arch" type="xml">
            <list>
                <field name="risk_id_id" />
                <field name="period_str" />
                <field name="risk_id_process_id" />
                <field name="risk_id_subprocess_id" />
                <field name="risk_id_owner_id" />
                <field name="risk_id_reviewer_id" />
                <field name="risk_id_auditor_id" />
                <field name="degree_mitigation" />
                <field name="risk_id_quantification" />
                <field name="residual_risk" />
                <field name="risk_id_impact" 
                decoration-success="risk_id_impact == 'low'"
                            decoration-warning="risk_id_impact == 'medium'"
                            decoration-danger="risk_id_impact == 'high'"
                />
                <field name="risk_id_occurrence" 
                decoration-success="risk_id_occurrence == 'low'"
                            decoration-warning="risk_id_occurrence == 'medium'"
                            decoration-danger="risk_id_occurrence == 'high'"
                />
                <field name="status" 
                decoration-muted="status == 'unmitigated'"
                decoration-warning="status == 'review'"
                decoration-success="status == 'filled' or status == 'mitigated'"
                />
            </list>
        </field>
    </record>

    <record id="view_risk_mitigation_mitigation_form" model="ir.ui.view">
        <field name="name">risk.mitigation.mitigation.form</field>
        <field name="model">tyt.risk.mitigation</field>
        <field name="arch" type="xml">
            <form   >
                <header>
                    <button 
                    string="Guía del revisor" 
                    class="btn btn-secondary"
                     
                    type="object"
                    name="open_reviewer_guide"
                    />
                    <button string="Control de documentos" class="btn btn-secondary" />
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archivado" bg_color="text-bg-danger"
                        invisible="active" />
                    
                    <field name="active" invisible="1" readonly="1" />
                    <group >
                        <group>
                            <field name="id" readonly="1" />
                            <field name="risk_id_pdomain_id" readonly="1" />
                        </group>
                        
                        <group>
                            <field name="risk_id_process_id" readonly="1" />
                            <field name="risk_id_subprocess_id" readonly="1" />
                        </group>
                    </group>

                    <group>
                        <group>
                            <field name="risk_id_name" readonly="1" />
                            <field name="risk_id_control_objective" readonly="1" />
                            <field name="risk_id_control_activity" readonly="1" />
                        </group>
                        <group>
                            <field name="risk_id_owner_id" readonly="1" />
                            <field name="risk_id_reviewer_id" readonly="1" />
                            <field name="risk_id_auditor_id" readonly="1" />
                        </group>

                    </group>
                    <group>
                        <group>
                            <field name="risk_id_goal_coso_ids" widget="many2many_tags" readonly="1" />
                            <field name="risk_id_assertion_ids" widget="many2many_tags" readonly="1"/>
                            <field name="risk_id_frequency_id" readonly="1" />
                            <field name="risk_id_type_ma" placeholder="Seleccione" readonly="1" />
                            <field name="risk_id_system_control" readonly="1" />

                        </group>
                        <group>
                            <field name="risk_id_fsc_id" readonly="1"/>
                            <field name="risk_id_quantification" readonly="1"/>
                             

                        </group>
                    </group>
                    <group>
                        <field name="risk_id_type_pd" placeholder="Seleccione" readonly="1"/>
                        <field name="risk_id_type_cf" placeholder="Seleccione" readonly="1" />
                        <field name="risk_id_department_id" readonly="1" />
                    </group>
                    <group >
                        <group>
                            <field name="status" 
                            widget="badge"
                            readonly="1"
                            decoration-muted="status == 'unmitigated'"
                            decoration-warning="status == 'review'"
                            decoration-success="status == 'filled' or status == 'mitigated'"

                            />
                            <field name="risk_id_impact"
                            widget="badge"
                            readonly="1"
                            decoration-success="risk_id_impact == 'low'"
                            decoration-warning="risk_id_impact == 'medium'"
                            decoration-danger="risk_id_impact == 'high'"/>
                            <field name="risk_id_occurrence"
                            widget="badge"
                            readonly="1"
                            decoration-success="risk_id_occurrence == 'low'"
                            decoration-warning="risk_id_occurrence == 'medium'"
                            decoration-danger="risk_id_occurrence == 'high'"/>
                        </group>
                    </group>
                     
                    <field name="status" invisible="1" />
                    <group string="Mitigación dueño" name="mo" >
                        <group colspan="4">
                            <div class="row justify-content-end">
                                <div class="col-auto">
                                    <label for="mo_period_str" string="Periodo" />
                                    <field name="mo_period_str" nolabel="1" />
                                </div>
                            </div>
                        </group>
                        <label for="mo_document_ids" />
                        <field name="mo_document_ids" nolabel="1" context="{'default_mitigation_id': id, 'default_origin': 'mitigation_owner'}">
                            <list >
                                <field name="name" />
                                <field name="description" />
                                <field name="create_date" string="Fecha de carga" />
                                <field name="create_uid" string="Cargado por" />
                            </list>
                        </field>

                        <label for="mo_link_ids" />
                        <field name="mo_link_ids" nolabel="1" context="{'default_mitigation_id': id, 'default_origin': 'mitigation_owner'}">
                            <list >
                                <field name="name" />
                                <field name="description" />
                                <field name="create_date" string="Fecha de carga" />
                                <field name="create_uid" string="Cargado por" />

                            </list>
                        </field>
                        <div invisible="status=='review'" colspan="4">
                            <div >
                                <p class="text-primary fw-bold">
                                    Si completó la carga de archivos, haga click en el botón azul *"NOTIFICAR"*, para enviar su control a revisión
                                </p>
                                
                            </div>
                            <div class="row justify-content-end">
                                <div class="col-auto me-2">
                                    <button class="btn btn-primary" name="action_notify_revision" type="object">
                                    Notificar
                                </button>
                                </div>
                            </div>
                        </div>
                        <field name="mo_comment_ids_count" invisible="1" />
                        <label for="mo_comment_ids" invisible="mo_comment_ids_count==0"/>
                        <field name="mo_comment_ids" options="{'no_create': True}" nolabel="1" invisible="mo_comment_ids_count==0">
                            <list>
                                <field name="name" />
                                <field name="create_uid" string="Creado por"/>
                                <field name="create_date" string="Creado el" />
                            </list>
                        </field>
                        <div invisible="not status=='review'" colspan="4">
                            <field name="status" 
                            widget="badge"
                            nolabel="1"
                            readonly="1"
                            decoration-muted="status == 'unmitigated' or status == 'mitigated'"
                            decoration-warning="status == 'review'"
                            />
                        </div>
                    </group>
                    <group string="Mitigación revisor" name="reviewer_mitigation"
                     
                    >
                            <separator string="Proceso de mitigación"></separator>
                            <div class="row justify-content-end" colspan="4">
                                <div class="col-auto">
                                    <label for="mr_period_str" string="Periodo" />
                                    <field name="mr_period_str" nolabel="1" />
                                </div>
                            </div>
                            <group>
                                <field name="status" readonly="1" 
                                widget="badge"
                                />
                                <field name="risk_id_quantification" readonly="1" 
                                string="Riesgo inherente" />
                            </group>
                            <group>
                                <field name="mr_degree_mitigation" readonly="1" />
                                <field name="mr_residual_risk" readonly="1" />
                            </group>
                            <group>
                                <field name="mr_maturity_level" readonly="1" 
                                widget="badge"
                                decoration-danger="mr_maturity_level=='none'"
                                />
                                <field name="mr_mitigation_date" readonly="1" />
                            </group>
                            <group>
                                <field name="month" readonly="1" />
                                <field name="mr_level_compliance" readonly="1"
                                 />
                            </group>
                            <group>
                                <field name="year" widget="integer" readonly="1" />
                            </group>
                            <separator string="Calificación del riesgo"> </separator>
                            <div class="row ms-1 gx-3" colspan="4">
                                <div class="col-3 me-2">
                                    <span class="fw-bold">Antes de controles</span>
                                </div>
                                <div class="col-3 me-2">
                                    <span class="fw-bold">Despúes de controles</span>
                                </div>
                            </div>
                            <div class="row gx-3 " colspan="4">
                                <field name="before_control" widget="badge" readonly="1" 
                                decoration-success="before_control=='minor'"
                                decoration-warning="before_control=='significant'"
                                
                                />
                                <field name="after_control" widget="badge" readonly="1" />
                                
                            </div>
                            
                            <separator string="Planes de acción"></separator>

                            <div class="row justify-content-end mt-2" colspan="4">
                                <div class="col-auto">
                                    <button string="Agregar plan de acción" 
                                    name="action_create_action_plan"
                                    class="btn btn-primary"
                                    type="object"
                                    />
                                </div>
                            </div>
                            <field name="mr_all_action_plans_complete" invisible="1" />
                            <div invisible="not mr_all_action_plans_complete" class="row mt-2" colspan="4">
                                <div class="text-primary">
                                    Todos los planes de acción estan completados ya es posible asignar el status de mitigado.
                                </div>
                            </div>
                            <group colspan="4">
                                <label for="mr_action_plan_ids" />
                                <field name="mr_action_plan_ids"
                                nolabel="1"
                                colspan="4"
                                options="{'no_quick_create': True, 'no_create': True}"
                                groups="tyt_risk_management.group_risk_action_plan" >
                                    <list  edit="status=='pending'" create="0">
                                        <button 
                                        type="object"
                                        name="action_attendance_action_plan"
                                            string="Atender"
                                            class="btn btn-warning"
                                            invisible="status=='under_review'"
                                        />
                                        <button 
                                        type="object"
                                        name="action_attendance_action_plan"
                                            string="Completar"
                                            class="btn btn-success"
                                            context="{'is_for_complete': True, 'show_buttons': True}"
                                            invisible="not status=='under_review'"
                                        />
                                        <button name="action_attendance_action_plan"
                                            string="Rechazar"
                                            type="object"
                                            class="btn btn-danger"
                                            context="{'is_for_complete': False, 'show_buttons': True}"
                                            invisible="not status=='under_review'"
                                        />
                                        <field name="sequence" widget="handle" />
                                        <field name="name" />
                                        <field name="user_id" />
                                        <field name="remediation_date" />
                                        <field name="status" 
                                        decoration-warning="status=='under_review'"
                                        decoration-muted="status=='pending'"
                                        />
                                    </list>
                                </field>
                            </group>
                    </group>

                    

                </sheet>
                <chatter />
            </form>
        </field>
    </record>

    <record id="action_risk_mitigation" model="ir.actions.act_window">
        <field name="name">Mitigación</field>
        <field name="res_model">tyt.risk.mitigation</field>
        <field name="view_mode">list,form</field>
        <field name="domain"> [('mitigation_date', '&lt;=', (context_today() + relativedelta(months=1, day=1))), ]</field>
        <field name="view_ids" 
         eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_risk_mitigation_mitigation_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_risk_mitigation_my_activity_form')})]"
         />
        <field name="context">{
            'search_default_owner_id': uid,
        }</field>
    </record>

    <record id="view_risk_mitigation_monitoring_list" model="ir.ui.view">
        <field name="name">risk.mitigation.monitoring.list</field>
        <field name="model">tyt.risk.mitigation</field>
        <field name="arch" type="xml">
            <list>
                <field name="risk_id_id" />
                <field name="period_str" />
                <field name="risk_id_process_id" />
                <field name="risk_id_subprocess_id" />
                 
                <field name="risk_id_owner_id" />
                <field name="risk_id_reviewer_id" />
                <field name="risk_id_auditor_id" />
                <field name="ma_degree_mitigation" widget="badge" />
                <field name="risk_id_impact"
                    widget="badge"
                    decoration-success="risk_id_impact == 'low'"
                    decoration-warning="risk_id_impact == 'medium'"
                    decoration-danger="risk_id_impact == 'high'"/>
                <field name="risk_id_occurrence"
                            widget="badge"
                            decoration-success="risk_id_occurrence == 'low'"
                            decoration-warning="risk_id_occurrence == 'medium'"
                            decoration-danger="risk_id_occurrence == 'high'"/>
                <field name="mr_status_mitigation" 
                widget="badge"
                decoration-success="mr_status_mitigation=='mitigated'"
                />
                <field name="status" 
                widget="badge"
                decoration-muted="status == 'unmitigated'"
                decoration-warning="status == 'under_review'"
                decoration-success="status == 'filled' or status == 'mitigated'"
                />
            </list>
        </field>
    </record>

    <record id="action_risk_monitoring" model="ir.actions.act_window">
        <field name="name">Monitoreo</field>
        <field name="res_model">tyt.risk.mitigation</field>
        <field name="view_mode">list,form</field>
        <field name="domain"> [('mitigation_date', '&lt;=', (context_today() + relativedelta(months=1, day=1))), ('risk_activity_state', '=' , 'monitoring' )]</field>
        <field name="view_ids" 
         eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'list', 'view_id': ref('view_risk_mitigation_monitoring_list')}),
                (0, 0, {'view_mode': 'form', 'view_id': ref('view_risk_mitigation_my_activity_form')})]"
         />
        <field name="context">{
            'search_default_owner_id': uid,
        }</field>
    </record>
    
</odoo>
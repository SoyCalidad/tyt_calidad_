<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">
    <t t-name="tyt_risk_management.RiskSectionCard">

        <div class="card shadow-sm risk-section-card">

            <div class="card-header d-flex justify-content-between align-items-center"
              
            >
                <h3 class="card-title mb-0">
                    <t t-esc="props.title"/>
                </h3>

                <button
                    class="btn btn-sm btn-outline-secondary"
                    t-on-click="toggleCollapse" 
                >
                    <i
                        class="fa"
                        t-att-class="state.collapsed ? 'fa-plus' : 'fa-minus'"
                    />
                </button>
            </div>

            <div
                class="card-body"
                t-att-class="state.collapsed ? 'd-none' : ''"
            >
                <div class="row g-4">

                    <!-- BAR CHART -->
                    <div class="col-12 col-xl-6">
                        <div class="chart-container">
                            <canvas t-ref="barChart"/>
                        </div>
                    </div>

                    <!-- PIE + STATS -->
                    <div class="col-12 col-xl-6">

                        <div class="row g-3">
                            <!-- PIE -->
                            <div class="col-12 col-md-8"
                            style="height: 234px;
  width: 468px;"
                            >
                                <PieChart 
                                label="'data piechart'"
                                showLegend="true"
                                data="{}"
                                dataValues="[32324242,32]"
                                dataLabels="['Riesgo residual','Riesgos asegurados']"
                                dataColors="['#DC3545','#16AAFF']" />

                            </div>

                            <!-- STATS -->
                            <div class="col-12 col-md-4">
                                <div class="d-flex flex-column gap-3">
                                    <StatInfoCard
                                        title="'Riesgos Asegurados'"
                                        value="'6,778,003'"
                                        color="'#16AAFF'"
                                        icon="'fa fa-money'"
                                    />
                                    <StatInfoCard
                                        title="'Riesgo Residual'"
                                        value="'404,547,363'"
                                        color="'#DC3545'"
                                        icon="'fa fa-money'"
                                    />

                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>

</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tyt_risk_management.ReportConsolidated">
        <Layout display="display" className="'o_dashboard h-100 mt-2 overflow-y-auto'">
            <div class="row m-2">
                <div class="col-12">
                    <div class="card shadow-sm level3-filter-card">
                        <div class="card-header">
                            <h3 class="fw-semibold text-black mb-0">
                                Nivel 3 - Consolidado
                            </h3>
                        </div>
            
                        <div class="card-body">
            
                            <div class="row g-3 align-items-end">
            
                                <FilterSelect
                                    label="'Sitio'"
                                    name="'department_id'"
                                    value="state.filters.deparment_id"
                                    options="state.deparments" 
                                    onChange.bind="updateFilter"
                                    mainClass="'col-md-3'"
                                />
            
                                <FilterSelect
                                    label="'Dominio'"
                                    name="'pdomain_id'"
                                    value="state.filters.pdomain_id"
                                    options="state.domains"
                                    onChange.bind="updateFilter"
                                    mainClass="'col-md-3'"
                                />
            
                                <FilterSelect
                                    label="'Proceso'"
                                    name="'proceso'"
                                    value="state.filters.process_id"
                                    options="state.processes" 
                                    onChange.bind="updateFilter"
                                    mainClass="'col-md-3'"
                                />
            
                                <!-- <FilterSelect
                                    label="'Año'"
                                    name="'year'"
                                    value="state.filters.year"
                                    options=""
                                    onChange.bind="updateFilter"
                                /> -->
                                <div class="col-md-2" t-att-class="'filter-item col-lg '">
                                    <label class="form-label" for="year">
                                        <t t-esc="'Año'"/>
                                    </label>

                                    <select
                                        class="form-select"
                                        t-att-name="'year'"
                                        t-model="state.filters.year"
                                    >
                                        <option value="0">
                                            <t t-esc="'Todo'"/>
                                        </option>

                                        <t t-foreach="state.years"
                                        t-as="option"
                                        t-key="'Year-' +option.value">

                                            <option
                                                t-att-value="option.value"
                                                
                                            >
                                                <t t-esc="option.label"/>
                                            </option>

                                        </t>
                                    </select>
                                </div>
            
                                <FilterSelect
                                    label="'Mes'"
                                    name="'month'"
                                    value="state.filters.month"
                                    options="monthOptions"
                                    onChange.bind="updateFilter"
                                    mainClass="'col-md-2'"
                                />
            
                                <div class="col-12 col-lg-auto">
            
                                    <button
                                        class="btn btn-primary w-100"
                                        t-on-click="onSearch"
                                    >
                                        Buscar
                                    </button>
            
                                </div>
            
                            </div>
            
                        </div>
            
                    </div>
                </div>
            </div>
            <t t-if="state.loading">
                <div class="spinner-border" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </t>
            <t t-else="">
                <div class="row m-2">
                    <div class="col-12">
                        <RiskSectionCard title="'Mitigación'"
                        data_status_risk="state.dataProcessed.barchart_mitigated"
                        residual_risk="state.dataProcessed.mitigated_riesgo_residual"
                        insured_risk="state.dataProcessed.mitigated_riesgo_asegurado"
                        />
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-12">
                        <RiskSectionCard title="'Monitoreo'" 
                        data_status_risk="state.dataProcessed.barchart_monitoring"
                        residual_risk="state.dataProcessed.monitoring_riesgo_residual"
                        insured_risk="state.dataProcessed.monitoring_riesgo_asegurado"
                        />
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-12">
                        <MaturityLevelCard  
                        dataMonitoring="state.dataProcessed.maturity_monitoring"
                        dataMitigated="state.dataProcessed.maturity_mitigated"
                        />
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-12">
                        <RiskMap 
                        title="'Mapa de riesgos (Mitigación)'" 
                        mitigations="state.dataProcessed.resumenProcesos.mitigado"
                        />
                    </div>
                </div>
                <div class="row m-2">
                    <div class="col-12">
                        <RiskMap 
                        title="'Mapa de riesgos (Monitoreo)'" 
                        mitigations="state.dataProcessed.resumenProcesos.monitoring"
                        />
                    </div>
                </div>
    
                <div class="row m-2">
                    <div class="col-12">
                        <div class="card  shadow-sm ">
                            <div class="card-header d-flex justify-content-between align-items-center bg-secondary ">
    
                                <h3 class="card-title mb-0">
                                    Resultados por procesos ( Mitigación ) 
                                </h3>
                                <button
                                    class="btn btn-sm btn-outline-secondary"
                                    t-on-click="toggleCollapseMitigation"
                                >
                                    <i
                                        class="fa"
                                          t-att-class="state.collapsedMitigation ? 'fa-plus' : 'fa-minus'"
                                    />
                                </button>
    
                            </div>
                            <div
                                class="card-body"
                                t-att-class="state.collapsedMitigation ? 'd-none' : ''" 
                            >
                                <t t-foreach="state.dataProcessed.processes_mitigated" t-as="process" t-key="'resultbyprocessMitigation'+process.id">
                                    <ProcessCard 
                                    process="process"
                                    data_status_risk="[process.n_unmitigation, process.n_partialmitigated, process.n_mitigation]"
                                    residual_risk="process.residual"
                                    insured_risk="process.quantification"
                                    />
                                </t>
    
                            </div>
    
                        </div>
                    </div>
                </div>

                <div class="row m-2">
                    <div class="col-12">
                        <div class="card  shadow-sm ">
                            <div class="card-header d-flex justify-content-between align-items-center bg-secondary ">
    
                                <h3 class="card-title mb-0">
                                    Resultados por procesos (Monitoreo) 
                                </h3>
                                <button
                                    class="btn btn-sm btn-outline-secondary"
                                    t-on-click="toggleCollapseMonitoring"
                                >
                                    <i
                                        class="fa"
                                          t-att-class="state.collapsedMonitoring ? 'fa-plus' : 'fa-minus'"
                                    />
                                </button>
    
                            </div>
                            <div
                                class="card-body"
                                t-att-class="state.collapsedMonitoring ? 'd-none' : ''" 
                            >
                                <t t-foreach="state.dataProcessed.processes_monitoring  " t-as="process" t-key="'resultbyprocessMonitoring'+process.id">
                                    <ProcessCard 
                                    process="process"
                                    data_status_risk="[process.n_unmitigation, process.n_partialmitigated, process.n_mitigation]"
                                    residual_risk="process.residual"
                                    insured_risk="process.quantification"
                                    />
                                </t>
    
                            </div>
    
                        </div>
                    </div>
                </div>
            </t>


        </Layout>

    </t>

</templates>
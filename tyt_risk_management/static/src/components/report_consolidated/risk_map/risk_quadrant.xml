<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tyt_risk_management.RiskQuadrant" owl="1">

        <table t-att-class="'risk-quadrant-table w-100 ' + props.className">
        <tbody>

            <t t-foreach="matrix"
               t-as="row"
               t-key="row_index">

                <tr>

                    <t t-foreach="row"
                       t-as="cell"
                       t-key="cell_index">
                        <t t-if="cell">
                            <td class="risk-cell" t-attf-class="{{ cell.status == 'under_review' ? 'bg-warning' : '' }} {{ cell.mr_status_mitigation == 'mitigated' ? 'bg-success' : 'bg-dark' }}">
    
                                <button
                                    class="btn btn-dark btn-sm risk-badge"
                                    t-on-click="() => this.onRiskClick(cell)"
                                >
                                    <t t-esc="cell.id"/>
                                </button>
    
                            </td>
                        </t>
                        <t t-else="">
                            <td class="risk-cell" >
                                <div class="p-3" />
                            </td>
                        </t>

                    </t>

                </tr>

            </t>

        </tbody>

    </table>

    </t>
</templates>
<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="tyt_risk_management.RiskQuadrant" owl="1">

        <table t-att-class="'risk-quadrant-table w-100 ' + props.className">
        <tbody>

            <t t-foreach="matrix"
               t-as="row"
               t-key="row_index">

                <tr>

                    <t t-foreach="row"
                       t-as="cell"
                       t-key="cell_index">

                        <td class="risk-cell">

                            <button
                                t-if="cell"
                                class="btn btn-dark btn-sm risk-badge"
                                t-on-click="() => this.onRiskClick(cell)"
                            >
                                <t t-esc="cell.id"/>
                            </button>
                            <t t-else="">
                                <div class="p-3" />
                            </t>

                        </td>

                    </t>

                </tr>

            </t>

        </tbody>

    </table>

    </t>
</templates>
<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="tyt_risk_management.MaturityLevelCard">
        <div class="card shadow-sm maturity-level-card">
            <div class="card-header d-flex justify-content-between align-items-center">

                <h3 class="card-title mb-0">
                    Nivel de madurez
                </h3>
                <button
                    class="btn btn-sm btn-outline-secondary"
                    t-on-click="toggleCollapse"
                >
                    <i
                        class="fa"
                        t-att-class="state.collapsed ? 'fa-plus' : 'fa-minus'"
                    />
                </button>

            </div>
            <div
                class="card-body"
                t-if="!state.collapsed"
            >
                <div class="row g-4">
                    <div class="col-12 col-xl-6">
                        <MaturityBarChart
                            title="'Mitigación'"
                            labels="mitigationData.labels"
                            data="mitigationData.data"
                            colors="mitigationData.colors"
                        />

                    </div>
                    <div class="col-12 col-xl-6">
                        <MaturityBarChart
                            title="'Monitoreo'"
                            labels="monitoringData.labels"
                            data="monitoringData.data"
                            colors="monitoringData.colors"
                        />
                    </div>

                </div>

            </div>

        </div>

    </t>

</templates>
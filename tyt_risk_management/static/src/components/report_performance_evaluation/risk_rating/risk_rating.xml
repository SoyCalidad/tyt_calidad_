<templates xml:space="preserve">
    <t t-name="tyt_risk_management.RPERiskRating" owl="1">
        <Layout display="display" className="'o_dashboard h-100 overflow-y-auto'">
            <div class="  p-4 bg-light">
                <!-- Sección de Filtros -->
                <div class="row">
                    <div class="col-md-12">
                        <div class="card rounded">
                            <div class="card-header bg-white ">
                                <h3 class="card-title">
                                    Calificación y Desempeño del Riesgo 
                                </h3>
                            </div>
                            <div class="card-body">
                                <div class="row pb-3" >
                                     
                                    <div class="col-lg-2 col-md-3 col-sm-4">
                                        <label for="company_id" class="form-label fw-semibold">
                                            Sitio
                                        </label> 
                                        <select name="company_id" class="form-select"
                                        t-model="state.filters.department_id">
                                            <option value="0">Todo</option>
                                            <t t-foreach="state.departments" t-as="dep" t-key="'dep'+dep.id">
                                                <option t-att-value="dep.id" t-out="dep.name"></option>

                                            </t> 
                                        </select>
                                    </div>
                                    <div class="col-lg-1 col-sm-3">
                                        <label for="select-anio" class="form-label fw-semibold">Año</label> 
                                        <select name="select-anio" class="form-select" t-model="state.filters.year">
                                            <option value="0" disabled="1">Todo</option>
                                            <t t-foreach="state.years" t-as="y" t-key="y">
                                                <option t-att-value="y"><t t-esc="y"/></option>
                                            </t>
                                        </select>
                                    </div>
                                    <div class="col-lg-2">
                                        <label for="period" class="form-label fw-semibold">Periodo</label> 
                                        
                                        <select
                                            name="period" class="form-select"
                                            t-model="state.filters.cr_period"
                                            >
                                            <option value="month">Mensual</option>
                                            <option value="bi">Bimestral</option>
                                            <option value="tri">Trimestral</option>
                                            <option value="cua">Cuatrimestral</option>
                                            <option value="se">Semestral</option>
                                            <option value="anual">Anual</option>
                                        </select>
                                    </div>
                                    <div class="col-lg-2">
                                        <label for="type_revision" class="form-label fw-semibold">
                                            Tipo de revisión
                                        </label> 
                                        <select name="type_revision" class="form-select" 
                                        t-model="state.filters.revision_type"
                                        >
                                            <option value="0">Todo</option>
                                            <option value="sys_only_normal">Solo normales</option>
                                            <option value="sys_only_special">Solo especiales</option>
                                        </select></div>
                                    <div class="col-lg-1" style="align-self: self-end;">
                                        <button
                                        t-on-click="() => this.onSearch()"

                                            class="btn btn-secondary">Buscar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row mt-3">
                    <div class="col-lg-12">
                        <div t-if="state.loading">
                            <div class="spinner-border" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <t  t-if="reportData and reportData.report and !state.loading">
                            <t t-foreach="reportData.report" t-as="data" t-key="'tableCard'+data_index">
                                <div class="card my-2" >
                                    <div class="card-header"></div>
                                    <div class="card-body">
                                        
                                        <div class="table-responsive" style="padding-top: 10px;">
                                            <table class="table table-bcs-10px table-hover table-sm table-bordered table-condensed">
                                                <thead>
                                                    <tr class="sc-fs-14px bg-primary text-white sc-fw-bold ">
                                                        <th rowspan="2" class="text-primary text-center align-middle text-white sc-fw-bold">
                                                            <t t-if="data.department_name">
                                                                    <t t-out="data.department_name">
                                                                        Subsidiaria 1
                                                                    </t>
                                                                </t>
                                                                <t t-else="">
                                                                    Sin sitio
                                                                </t>
                                                        </th>
                                                        <t t-foreach="reportData.periods" t-key="'PeriodX'+label_period_index+data_index" t-as="label_period">
        
                                                            <th colspan="3" class="text-center align-middle sc-fw-bold ">P<t t-out="label_period" /></th>
                                                        </t> 
                                                    </tr>
                                                    <tr class="sc-fs-14px bg-primary text-white  ">
                                                        <t t-foreach="reportData.periods" t-as="_p" t-key="'controles'+ _p_index + data_index">
                                                            <th class="bg-primary text-center align-middle sc-fw-bold">
                                                                Antes de controles
                                                            </th>
                                                            <th class="bg-primary text-center align-middle sc-fw-bold">
                                                                Después de controles
                                                            </th>
                                                            <th class="bg-primary text-center align-middle sc-fw-bold">
                                                                %
                                                            </th>
        
                                                        </t>
                                                    </tr>
                                                </thead>
                                                <tbody >
                                                    <t t-foreach="data.rows" t-as="row" t-key="row_index">
                                                        <tr class="sc-fs-14px">
                                                            <td class="   text-center align-center sc-fw-bold "
                                                             t-att-style="nivelStyle(row.titulo)"
                                                            >
                                                                <t t-out="row.title">
                                                                    Severo
                                                                </t>
                                                                    
                                                            </td>
                                                            <t t-foreach="row.periodos" t-as="period" t-key="'periodoRow'+row_index + period_index">
        
                                                                <td align="center"
                                                                    class="sc-fw-bold sc-fs-14px"
                                                                    t-att-style="nivelStyle(row.titulo)"
                                                                    >
                                                                    <t t-out="period.before">1</t>
                                                                </td>
                                                                <td align="center"
                                                                    
                                                                    class="sc-fw-bold sc-fs-14px"
                                                                    t-att-style="nivelStyle(row.titulo)"
                                                                    >
                                                                    <t t-out="period.after">2</t>
                                                                </td>
                                                                <td align="center"
                                                                class="sc-fw-bold sc-fs-14px bg-primary text-white"
                                                                        
                                                                    >
                                                                    <t t-out="period.performance">87</t>
                                                                </td>
                                                            </t>
                                                            
                                                        </tr>
                                                    </t>
                                                </tbody>
                                            </table>
                                        </div>
                                       
                                    </div>
                                </div>
                            </t>
                        </t>
                    </div>
                </div>
    
                <div class="row my-2">
                    <div class="col-lg-12">
                        <div class="card rounded" t-if="!state.loading">
                            <div class="card-body" t-if="reportData and reportData.totals and reportData.periods">
                                <div class="table-responsive" style="padding-top: 10px;">
                                    <table class="table table-bcs-10px table-hover table-sm table-bordered ">
                                        <thead>
                                            <tr class="bg-primary text-white  ">
                                                <th   class="bg-primary text-center align-middle  sc-fw-bold sc-fs-14px" rowspan="2">
                                                    Calificación y Desempeño del Riesgo
                                                </th>
                                                <t t-foreach="reportData.periods" t-as="period" t-key="'Period'+report_index+period_index">

                                                    <th class="bg-primary text-center align-middle titulo-celda sc-fw-bold sc-fs-14px" colspan="3">
                                                        P<t t-out="period">1</t>
                                                    </th>
                                                </t> 
                                            </tr>
                                            <tr class="sc-fs-14px bg-primary text-white  ">
                                                <t t-foreach="reportData.periods" t-as="_p" t-key="'controlesTotal'+ _p_index + data_index">
                                                    <th class="bg-primary text-center align-middle sc-fw-bold">
                                                        Antes de controles
                                                    </th>
                                                    <th class="bg-primary text-center align-middle sc-fw-bold">
                                                        Después de controles
                                                    </th>
                                                    <th class="bg-primary text-center align-middle sc-fw-bold">
                                                        %
                                                    </th>

                                                </t>
                                            </tr>
                                        </thead>
                                        <tbody t-if="reportData.totals.items">
                                            <t t-foreach="reportData.totals.items" t-as="item" t-key="'Totalitem'+report_index + item_index">
                                                <tr>
                                                    <td class=""
                                                        
                                                        t-att-style="nivelStyle(item.titulo)"
                                                        >
                                                        <t t-out="item.title" />
                                                    </td>
                                                    <t t-foreach="item.periodos" t-as="period" t-key="'itemperiod'+report_index + item_index+period_index">
                                                         

                                                        <td align="center"
                                                            class="sc-fw-bold sc-fs-14px"
                                                            t-att-style="nivelStyle(item.titulo)"
                                                            >
                                                            <t t-out="period.before">1</t>
                                                        </td>
                                                        <td align="center"
                                                            
                                                            class="sc-fw-bold sc-fs-14px"
                                                            t-att-style="nivelStyle(item.titulo)"
                                                            >
                                                            <t t-out="period.after">2</t>
                                                        </td>
                                                        <td align="center"
                                                        class="sc-fw-bold sc-fs-14px bg-primary text-white"
                                                                
                                                            >
                                                            <t t-out="period.performance">87</t>
                                                        </td>
                                                    </t>
                                                </tr>
                                            </t>
                                        </tbody>
                                        
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </Layout>
    </t>
</templates>
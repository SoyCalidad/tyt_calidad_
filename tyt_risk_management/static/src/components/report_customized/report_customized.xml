<templates xml:space="preserve">
    <t t-name="tyt_risk_management.CustomizedReport" owl="1">
        <Layout display="display" className="'o_dashboard h-100 overflow-y-auto'">
            <div class="  p-4 bg-light">
                <!-- Sección de Filtros -->
                <div class="card shadow-sm rounded">
                    <div class="card-title">
                        <div class="row">
                            <div class="col-auto ">
                                <h3 class=" pt-4 ps-4 fw-semibold text-black ">
                                     Nivel 4 - Personalizado 
                                </h3>
                            </div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row bg-white p-3 mb-4  align-items-end  justify-content-between">
                            
                            <div class="col-md-2">
                                <label>Sitio</label>
                                
                                <SelectMenu
                                choices="state.departments"
                                multiSelect="true"
                                searchable="true"
                                value="state.filters.departmentIds"
                                onSelect.bind="onDepartmentSelect"
                                placeholder="'Todos'"/>
                            </div>
                            <div class="col-md-2">
                                <label>Dominio</label>
                                
                                <SelectMenu
                                choices="state.domains"
                                multiSelect="true"
                                searchable="true"
                                value="state.filters.domainIds"
                                onSelect.bind="onDomainSelect"
                                placeholder="'Todos'"/>
                            </div>
                            <div class="col-md-2">
                                <label>Proceso</label>
                                
                                <SelectMenu
                                choices="state.processes"
                                multiSelect="true"
                                searchable="true"
                                value="state.filters.processIds"
                                onSelect.bind="onProcessSelect"
                                placeholder="'Todos'"/>
                            </div>
                            <div class="col-md-2">
                                <label>Año</label>
                                
                                <SelectMenu
                                choices="state.years"
                                multiSelect="true"
                                searchable="true"
                                value="state.filters.selectedYears"
                                onSelect.bind="onYearSelect"
                                placeholder="'Todos'"/>
                            </div>
                            <div class="col-md-2">
                                <label >Mes</label>
                                <SelectMenu
                                choices="state.months"
                                multiSelect="true"
                                searchable="true"
                                value="state.filters.selectedMonths"
                                onSelect.bind="onMonthSelect"
                                placeholder="'Todos'"/>
                            </div>
                            <div class="col-md-1">
                                <button class="btn btn-secondary w-100" t-on-click="onSearch">
                                     Buscar
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
    

            </div>
        </Layout>
    </t>
</templates>
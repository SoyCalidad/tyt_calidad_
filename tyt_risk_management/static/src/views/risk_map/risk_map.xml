<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="tyt_risk_management.QuantificationRiskMap" owl="1">

        <div>
            <div class="table-responsive d-flex justify-content-center">

                            <table class="risk-map-table">

                                <tbody>

                        <!-- FILAS DE IMPACTO -->
                                    <t t-foreach="rows" t-as="row" t-key="row.impact">

                                        <tr>

                                            <t t-if="row_index === 0">
                                                <td rowspan="4"
                                                    class="risk-axis bg-secondary text-white">
                                                    Impacto
                                                </td>
                                            </t>

                                            <td t-att-class="'risk-impact-label ' + row.impactClass">

                                                <span class="fw-bold text-uppercase">
                                                    <t t-esc="row.impact"/>
                                                </span>

                                            </td>

                                            <t t-foreach="row.quadrants"
                                            t-as="quadrant"
                                            t-key="quadrant.id">

                                                <td 
                                                t-att-class="'p-2 border-0 ' + quadrant.className" t-attf-style="min-width: {{matrixSize * 50}}px">
                                                    <RiskQuadrant
                                                        risks="quadrant.risks"
                                                        size="this.matrixSize"
                                                        className="''"
                                                        
                                                    />
                                                </td>

                                            </t>

                                        </tr>

                                    </t>

                        <!-- OCURRENCIA -->
                                    <tr>

                                        <td class="bg-secondary border-0"/>

                                        <t t-foreach="occurrenceLevels"
                                           t-as="level"
                                           t-key="level.label">

                                            <td 
                                                t-att-class="'text-center fw-bold text-uppercase occurrence-label ' + level.class"
                                            >
                                                <t t-esc="level.label"/>
                                            </td>

                                        </t>

                                    </tr>

                        <!-- EJE X -->
                                    <tr>

                                        <td
                                            colspan="16"
                                            class="bg-secondary text-white text-center text-uppercase fw-bold"
                                        >
                                            Ocurrencia
                                        </td>

                                    </tr>

                                </tbody>

                            </table>

                        </div>
        </div>

    </t>

</templates>
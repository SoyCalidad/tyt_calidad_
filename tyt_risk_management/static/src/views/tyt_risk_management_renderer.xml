<templates>
    <t t-name="tyt_risk_management.RiskQuantificationListRenderer" t-inherit="web.ListRenderer"
        t-inherit-mode="primary">
        <table position="after">
            <div class="container">
                <div class="row justify-content-center">
                    <div class="col-auto">
                        <h4 class="fw-bolder fs-3">Mapa de riesgos</h4>
                    </div>

                </div>
                <t t-if="mitigations.loading==false">
                    <RiskMap mitigations="mitigations.list" />
                </t>
                <t t-else="">
                    <div class="text-center">
                        <div class="spinner-border" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </div>
                </t>

            </div>
        </table>
    </t>

</templates>
        <field name="name">Mitigación riesgo - reporte personalizado </field>
        <field name="model">tyt.customized.report.wizard</field>
        <field name="report_type">xlsx</field>
        <field name="report_name">tyt_risk_management.customized_report_wizard_template</field>
        <field name="report_file">CompliaceStatus--</field>

<odoo>
    <record id="business_process_admin_rule" model="ir.rule">
        <field name="name">Admin full access</field>
        <field name="model_id" ref="model_tyt_business_process" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_admin'))]" />
    </record>
    <record id="business_process_user_rule" model="ir.rule">
        <field name="name">User can only see assigned processes</field>
        <field name="model_id" ref="model_tyt_business_process" />
        <field name="domain_force">
            [
                '|', '|',
                ('id', 'in', user.process_ids.ids),
                ('parent_id.id', 'in', user.process_ids.ids),
                ('parent_id.parent_id.id', 'in', user.process_ids.ids),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario')), (4, ref('tyt_risk_management.group_consulta'))]"/>
    </record>

    <record id="risk_user_rule" model="ir.rule">
        <field name="name">User can only see assigned risk</field>
        <field name="model_id" ref="model_tyt_risk_management" />
        <field name="domain_force">
            [
                '|', '|',
                ('process_id.id', 'in', user.process_ids.ids),
                ('process_id.parent_id.id', 'in', user.process_ids.ids),
                ('process_id.parent_id.parent_id.id', 'in', user.process_ids.ids),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario')), (4, ref('tyt_risk_management.group_consulta'))]"/>

    </record>
    <record id="risk_admin_rule" model="ir.rule">
        <field name="name">Admin full access</field>
        <field name="model_id" ref="model_tyt_risk_management" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_admin'))]" />
    </record>


    <!-- ========================================================== -->
    <!--  Rol Usuario: solo ve sus controles (dueño/revisor/auditor) -->
    <!--  Consulta y Admin conservan la vista completa (reportes)    -->
    <!-- ========================================================== -->

    <!-- Mitigation / monitoring -->
    <record id="risk_mitigation_user_rule" model="ir.rule">
        <field name="name">User can only see own mitigations</field>
        <field name="model_id" ref="model_tyt_risk_mitigation" />
        <field name="domain_force">
            [
                '|', '|',
                ('risk_id_owner_id', '=', user.id),
                ('risk_id_reviewer_id', '=', user.id),
                ('risk_id_auditor_id', '=', user.id),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario'))]" />
    </record>
    <record id="risk_mitigation_full_rule" model="ir.rule">
        <field name="name">Consulta and Admin full access to mitigations</field>
        <field name="model_id" ref="model_tyt_risk_mitigation" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_consulta')), (4, ref('tyt_risk_management.group_admin'))]" />
    </record>

    <!-- Action plans -->
    <record id="risk_action_plan_user_rule" model="ir.rule">
        <field name="name">User can only see own action plans</field>
        <field name="model_id" ref="model_tyt_risk_action_plan" />
        <field name="domain_force">
            [
                '|', '|', '|',
                ('user_id', '=', user.id),
                ('mitigation_id.risk_id_owner_id', '=', user.id),
                ('mitigation_id.risk_id_reviewer_id', '=', user.id),
                ('mitigation_id.risk_id_auditor_id', '=', user.id),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario'))]" />
    </record>
    <record id="risk_action_plan_full_rule" model="ir.rule">
        <field name="name">Consulta and Admin full access to action plans</field>
        <field name="model_id" ref="model_tyt_risk_action_plan" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_consulta')), (4, ref('tyt_risk_management.group_admin'))]" />
    </record>


    <!-- ========================================================== -->
    <!--  Visualizador de archivos (rol Usuario)                    -->
    <!--  Solo ve los archivos que cargó o los de sus controles     -->
    <!--  (mitigación, plan de acción y riesgo; dueño/revisor/auditor). -->
    <!--  Los dominios son explícitos porque Odoo evalúa las reglas -->
    <!--  con sudo y no aplica las reglas de los modelos anidados.  -->
    <!-- ========================================================== -->

    <!-- Files attached to risks / mitigations / action plans -->
    <record id="risk_mo_file_user_rule" model="ir.rule">
        <field name="name">User can only see files of own controls</field>
        <field name="model_id" ref="model_tyt_risk_mo_file" />
        <field name="domain_force">
            [
                '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                ('create_uid', '=', user.id),
                ('mitigation_id.risk_id_owner_id', '=', user.id),
                ('mitigation_id.risk_id_reviewer_id', '=', user.id),
                ('mitigation_id.risk_id_auditor_id', '=', user.id),
                ('plan_id.user_id', '=', user.id),
                ('plan_id.mitigation_id.risk_id_owner_id', '=', user.id),
                ('plan_id.mitigation_id.risk_id_reviewer_id', '=', user.id),
                ('plan_id.mitigation_id.risk_id_auditor_id', '=', user.id),
                ('risk_id.owner_id', '=', user.id),
                ('risk_id.reviewer_id', '=', user.id),
                ('risk_id.auditor_id', '=', user.id),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario'))]" />
    </record>
    <record id="risk_mo_file_full_rule" model="ir.rule">
        <field name="name">Consulta and Admin full access to files</field>
        <field name="model_id" ref="model_tyt_risk_mo_file" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_consulta')), (4, ref('tyt_risk_management.group_admin'))]" />
    </record>



    <!-- Documents app: inside the "Gestión de riesgos" folder the User role
         only sees own uploads or files attached to a control it can access.
         Folders stay visible: child_of also matches the folder itself and hiding
         it would stop the user from uploading. Read only: write/unlink keep the
         native Documents rules. -->
    <record id="documents_document_risk_user_rule" model="ir.rule">
        <field name="name">User can only see own files in the risk folder</field>
        <field name="model_id" ref="documents.model_documents_document" />
        <field name="domain_force" eval="'''
            [
                '|', '|', '|',
                ('owner_id', '=', user.id),
                ('type', '=', 'folder'),
                '!', ('folder_id', 'child_of', %s),
                ('tyt_rm_mo_file_ids', 'any', [
                        '|', '|', '|', '|', '|', '|', '|', '|', '|', '|',
                        ('create_uid', '=', user.id),
                        ('mitigation_id.risk_id_owner_id', '=', user.id),
                        ('mitigation_id.risk_id_reviewer_id', '=', user.id),
                        ('mitigation_id.risk_id_auditor_id', '=', user.id),
                        ('plan_id.user_id', '=', user.id),
                        ('plan_id.mitigation_id.risk_id_owner_id', '=', user.id),
                        ('plan_id.mitigation_id.risk_id_reviewer_id', '=', user.id),
                        ('plan_id.mitigation_id.risk_id_auditor_id', '=', user.id),
                        ('risk_id.owner_id', '=', user.id),
                        ('risk_id.reviewer_id', '=', user.id),
                        ('risk_id.auditor_id', '=', user.id),
                    ]),
            ]
        ''' % ref('tyt_risk_management.folder_risk_management')" />
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario'))]" />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="documents_document_risk_full_rule" model="ir.rule">
        <field name="name">Consulta and Admin full access to files</field>
        <field name="model_id" ref="documents.model_documents_document" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_consulta')), (4, ref('tyt_risk_management.group_admin'))]" />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="rule_res_groups_risk_scope" model="ir.rule">
        <field name="name">Gestión de Riesgos: solo grupos del módulo</field>
        <field name="model_id" ref="base.model_res_groups"/>
        <field name="domain_force" eval="[('category_id', 'child_of',
            ref('tyt_risk_management.module_category_mi_modulo'))]"/>
        <field name="groups" eval="[(4, ref('group_roles'))]"/>
    </record>
</odoo>
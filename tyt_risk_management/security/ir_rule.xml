<odoo>
    <record id="business_process_admin_rule" model="ir.rule">
        <field name="name">Admin full access</field>
        <field name="model_id" ref="model_tyt_business_process" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_admin'))]" />
    </record>
    <record id="business_process_user_rule" model="ir.rule">
        <field name="name">User can only see assigned processes</field>
        <field name="model_id" ref="model_tyt_business_process" />
        <field name="domain_force">
            [
                '|', '|',
                ('id', 'in', user.process_ids.ids),
                ('parent_id.id', 'in', user.process_ids.ids),
                ('parent_id.parent_id.id', 'in', user.process_ids.ids),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario')), (4, ref('tyt_risk_management.group_consulta'))]"/>
    </record>

    <record id="risk_user_rule" model="ir.rule">
        <field name="name">User can only see assigned risk</field>
        <field name="model_id" ref="model_tyt_risk_management" />
        <field name="domain_force">
            [
                '|', '|',
                ('process_id.id', 'in', user.process_ids.ids),
                ('process_id.parent_id.id', 'in', user.process_ids.ids),
                ('process_id.parent_id.parent_id.id', 'in', user.process_ids.ids),
            ]
        </field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_usuario')), (4, ref('tyt_risk_management.group_consulta'))]"/>

    </record>
    <record id="risk_admin_rule" model="ir.rule">
        <field name="name">Admin full access</field>
        <field name="model_id" ref="model_tyt_risk_management" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('tyt_risk_management.group_admin'))]" />
    </record>


    <record id="rule_res_groups_risk_scope" model="ir.rule">
        <field name="name">Gestión de Riesgos: solo grupos del módulo</field>
        <field name="model_id" ref="base.model_res_groups"/>
        <field name="domain_force" eval="[('category_id', 'child_of',
            ref('tyt_risk_management.module_category_mi_modulo'))]"/>
        <field name="groups" eval="[(4, ref('group_roles'))]"/>
    </record>
</odoo>
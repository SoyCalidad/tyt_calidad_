<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vista Tree -->
    <record id="tyt_crehana_learning_path_tree_view" model="ir.ui.view">
        <field name="name">tyt.crehana.learning.path.tree</field>
        <field name="model">tyt_crehana.learning_path</field>
        <field name="arch" type="xml">
            <tree create="false">
                <field name="id_path"/>
                <field name="name"/>
                <field name="course_ids"/>
            </tree>
        </field>
    </record>

    <!-- Vista Form -->
    <record id="tyt_crehana_learning_path_form_view" model="ir.ui.view">
        <field name="name">tyt.crehana.learning.path.form</field>
        <field name="model">tyt_crehana.learning_path</field>
        <field name="arch" type="xml">
            <form string="Ruta de Aprendizaje">
                <sheet>
                    <group>
                        <field name="id_path"/>
                        <field name="name"/>
                    </group>
                    <field name="course_ids">
                        <tree>
                            <field name="id_course"/>
                            <field name="title"/>
                        </tree>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Acción de ventana -->
    <record id="action_learning_path" model="ir.actions.act_window">
        <field name="name">Lista de rutas de aprendizaje</field>
        <field name="res_model">tyt_crehana.learning_path</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="action_server_update_paths" model="ir.actions.server">
        <field name="name">Actualizar rutas de aprendizaje</field>
        <field name="model_id" ref="model_tyt_crehana_learning_path"/>
        <field name="state">code</field>
        <field name="code">env['tyt_crehana.learning_path'].action_fetch_paths_from_api()</field>
        <!-- <field name="code">model.action_fetch_paths_from_api()</field> -->
    </record>

    <!-- Menú -->
    <menuitem id="menu_learning_path" name="Rutas de aprendizaje"
        parent="menu_crehana_root" action="action_learning_path" sequence="80"/>

    <menuitem id="menu_learning_path_update" name="Actualizar rutas"
        parent="menu_crehana_root" action="action_server_update_paths" sequence="90"/>
</odoo>
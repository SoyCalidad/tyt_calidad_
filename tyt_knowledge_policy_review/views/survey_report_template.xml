<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="survey_report_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <t t-foreach="docs" t-as="doc">
                    <div class="header" style="border-top: 50px">
                        <table class="table table-sm table-borderless">
                            <tbody>
                                <tr>
                                    <td style="width: 100%; height: 50px;"/>
                                </tr>
                                <tr>
                                    <td class="text-start" style="width: 60%;"/>
                                    <td class="text-end" style="width: 40%;">
                                        <h3 t-esc="doc.company_id.name"/>
                                        <h3 t-esc="doc.company_id.phone"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="page">
                        <table class="table table-sm table-borderless" style="width: 100%;">
                            <tbody>
                                <tr>
                                    <td class="text-start" style="width: 25%;"/>
                                    
                                    <td class="text-center" style="width: 50%;">
                                        <img t-if="doc.company_id.logo" t-att-src="image_data_uri(doc.company_id.logo)" alt="Logo" style="width: 100%; height: auto;"/>
                                    </td>
                                    <td class="text-start" style="width: 25%;"/>
                                </tr>
                                <tr>
                                    <td class="text-center" style="width: 25%;"/>
                                    <td class="text-center" style="width: 50%;">
                                        <h3 class="text-center" t-esc="doc.company_id.name"/>
                                    </td>
                                    <td class="text-center" style="width: 25%;"/>
                                </tr>
                            </tbody>
                        </table>
                        
                        <br/>

                        <table class="table table-bordered text-center" style="width: 100%; border: 2px solid; border-collapse: collapse;">
                            <thead>
                                <tr>
                                    <th style="border: 2px solid;">Fecha</th>
                                    <th style="border: 2px solid;">Login</th>
                                    <th style="border: 2px solid;">Agente</th>
                                    <th style="border: 2px solid;">Supervisor</th>
                                    <th style="border: 2px solid;">Campaña</th>
                                    <th style="border: 2px solid;">Turno</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.custom_description_line_ids" t-as="line">
                                    <tr>
                                        <td style="border: 2px solid;"><t t-esc="line.date"/></td>
                                        <td style="border: 2px solid;"><t t-esc="line.login"/></td>
                                        <td style="border: 2px solid;"><t t-esc="line.agent"/></td>
                                        <td style="border: 2px solid;"><t t-esc="line.supervisor.name"/></td>
                                        <td style="border: 2px solid;"><t t-esc="line.campaign.name"/></td>
                                        <td style="border: 2px solid;"><t t-esc="line.turn"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                    <div class="footer">
                        <div class="text-left">
                            <h4>Departamento de Calidad y Capacitación</h4>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
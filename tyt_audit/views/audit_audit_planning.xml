<odoo>
    <data>     
        <record id="view_audit_audit_planning_tree" model="ir.ui.view">
            <field name="name">audit.audit.planning.tree</field>
            <field name="model">audit.audit.planning</field>
            <field name="arch" type="xml">
                <list editable="top">
                    <field name="iso_9001_standards_ids" widget="many2many_tags"/>
                    <field name="iso_9001_combined_names" widget="text" optional="hide" />
                    <field name="clause_id" />
                    <field name="new_job_id" string="Responsable"/>
                    <field name="verification" />
                    <field name="finding" />
                    <field name="evidence_char"/>
                    <field name="evidence_attachment_ids" widget="many2many_tags"/>
                    <field name="comment" />
                    <field name="evaluation" />
                    <button name="action_open_audit_application_form"
                        string="Generar Auditoría"
                        type="object"
                        class="btn-primary oe_highlight" />
                </list>
            </field>
        </record>
        
        <menuitem id="audit_configuration_menu"
          name="Configuración"
          parent="mgmtsystem_audit.menu_audit_root"
          sequence="101"/>

        <record id="action_audit_audit_planning_list" model="ir.actions.act_window">
            <field name="name">Lista de Verificación</field>
            <field name="res_model">audit.audit.planning</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[]</field>
            <field name="context">{}</field>
        </record>

        <menuitem id="audit_configuration_checklist_menu"
                name="Lista de Verificación"
                parent="audit_configuration_menu"
                action="action_audit_audit_planning_list"
                sequence="1"/>
    </data>
</odoo>
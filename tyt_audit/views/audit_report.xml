<odoo>    
    <data>
        <record id="report_line_form_tyt" model="ir.ui.view">
            <field name="name">report_line_form_tyt</field>
            <field name="model">report.line</field>
            <field name="inherit_id" ref="mgmtsystem_audit.report_line_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group[1]" position="replace">
                    <group>
                        <field name="date_audit" />
                        <field name="employee_id" />
                        <field name="datetime" />
                        <field name="nc_id" />
                        <field name="found" style="display:block;max-width:480px;overflow-wrap:break-word;"/>
                        <field name="observations" style="display:block;max-width:480px;overflow-wrap:break-word;" />
                        <field name="image_attached" />
                    </group>                          
                </xpath>
            </field>
        </record>

        <record id="view_audit_report_form_tyt" model="ir.ui.view">
            <field name="name">audit.report.form.tyt</field>
            <field name="model">audit.report</field>
            <field name="inherit_id" ref="mgmtsystem_audit.view_audit_report_form"/>
            <field name="arch" type="xml">
                <xpath expr="//sheet/group[1]" position="replace">
                    <group>
                        <group>
                            <field name="site_id" readonly="state not in ['draft', 'in_process']" />
                            <field name="site_manager_id" readonly="state not in ['draft', 'in_process']" />
                            <field name="site_manager_email" readonly="state not in ['draft', 'in_process']" />
                            <field name="training_manager_id" readonly="state not in ['draft', 'in_process']" />
                            <field name="standard" invisible="1" readonly="state not in ['draft', 'in_process']"  />
                            <field name="auditor_id" readonly="state not in ['draft', 'in_process']" />
                            <field name="audited_ids" widget="many2many_tags" readonly="state not in ['draft', 'in_process']" />
                            <field name="next_audit" readonly="state not in ['draft', 'in_process']" />
                            <field name="audit_duration" string = "Duración de la Auditoría (en días)" readonly="state not in ['draft', 'in_process']" />
                        </group>
                        <group>
                            <field name="team_id" string = "Equipo Auditor" readonly="state not in ['draft', 'in_process']" />
                            <field name="audit_id" string="Lista de Verificación" readonly="state not in ['draft']" />
                            <field name="tyt_procedure_description_id" readonly="state not in ['draft']" />
                            <field name="tyt_procedure_activity_id" readonly="state not in ['draft']" />
                        </group>
                    </group>
                </xpath>
                <xpath expr="//sheet/group[2]" position="replace">
                    <group>
                    </group>
                </xpath>                
                <xpath expr="//sheet/group[3]" position="replace">
                    <group>
                    </group>
                </xpath>
                <xpath expr="//sheet/notebook/page[1]" position="replace">
                    <page string="Lineas">
                        <field name="tyt_line_ids" readonly="state in ['in_process']">
                            <list editable="bottom">
                                <field name="iso_9001_standards_ids" widget="many2many_tags" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                <field name="clause_id" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                <!-- <field name="employee_id" readonly="parent.state not in ['elaborate', 'validate_ok']" /> -->
                                <field name="new_job_id" readonly="parent.state not in ['elaborate', 'validate_ok']" string="Responsable"/>
                                <field name="verification" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                <field name="finding" readonly="parent.state not in ['elaborate', 'validate_ok']" />
                                <field name="evidence_attachment_ids" widget="many2many_tags" readonly="parent.state not in ['elaborate', 'validate_ok']"/>
                                <field name="comment" readonly="parent.state not in ['elaborate', 'validate_ok']"  />
                                <field name="evaluation" readonly="parent.state not in ['elaborate', 'validate_ok']"  />
                            </list>
                        </field>
                    </page>
                </xpath>
                <xpath expr="//sheet/notebook/page[2]" position="after">
                    <page name="conclusions" string="Medidas post - auditoría">
                        <group>
                            <field name="post_audit_action" widget="html" />
                        </group>
                    </page>
                </xpath>               
            </field>
        </record>

        <record id="action_audit_audit_planning" model="ir.actions.act_window">
            <field name="name">audit.audit.planning.w.action</field>
            <field name="res_model">audit.audit.planning</field>
            <field name="view_mode">list</field>
            <!-- quitando 'form' de la acción de ventana -->
        </record>


    </data>
</odoo>
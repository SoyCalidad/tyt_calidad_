<odoo>
    <template id="audit_application_form_template" name="Formulario de Auditoría">
        <link rel="stylesheet" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
        <div class="container mt-4 mb-4">
            <h1>Formulario de Auditoría</h1>
            <form action="/audit_application/submit" method="post" class="p-4 border rounded bg-light">
                <!-- Ejemplo de campo con información -->
                <div class="mb-3">
                    <label for="audit_name" class="form-label">Nombre de la Auditoría</label>
                    <input type="text" class="form-control" id="audit_name" name="audit_name" value="t-esc='audit.name'" readonly="readonly"/>
                </div>
                <!-- Agrega más campos aquí según sea necesario -->

                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-primary">Guardar</button>
                </div>
            </form>
        </div>
    </template>
</odoo>

<odoo>
    <template id="audit_application_form_template" name="Formulario de Auditoría">
        <link rel="stylesheet" href="/web/static/lib/bootstrap/dist/css/bootstrap.css"/>
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons/font/bootstrap-icons.css"/>
        <style type="text/css">
            /* Fondo de la página */
            body {
                background-image: url(/tyt_recruitment/static/src/img/fondo_form.png);
                background-size: cover;
            }
            /* Estilo del encabezado */
            h1 {
                background-color: #1f8296;
                padding: 15px;
                color: white;
                text-align: center;
                border-radius: 5px;
            }
            /* Contenedor principal del formulario */
            .container {
                background: white;
                padding: 20px;
                border-radius: 8px;
                box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.1);
                margin-top: 20px;
            }
            /* Bordes entre filas */
            .table-custom tr {
                border-bottom: 1px solid #d3d3d3;
            }
            /* Asegurar igual distribución de columnas */
            .col-md-6 {
                flex: 0 0 50%;
                max-width: 50%;
            }
        </style>

        <div class="container mt-4 mb-4">
            <h1>Formulario de Auditoría</h1>
            <form t-att-action="'/audit_application/' + str(planning_id) + '/'" method="post" enctype="multipart/form-data" class="p-4 border rounded bg-light">
                <div class="row">
                    <!-- Primera columna -->
                    <div class="col-md-6">
                        <table class="table table-borderless table-custom">
                            <tbody>
                                <tr>
                                    <td><strong>PROCEDIMIENTO:</strong></td>
                                    <td><input type="text" class="form-control" name="procedure" readonly="readonly" t-att-value="audit['procedure']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>RESPONSABLE:</strong></td>
                                    <td><input type="text" class="form-control" name="responsible" readonly="readonly" t-att-value="audit['responsible']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>AUDITADO:</strong></td>
                                    <td><input type="text" class="form-control" name="audited" readonly="readonly" t-att-value="audit['audited']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>GRUPO AUDITOR:</strong></td>
                                    <td><input type="text" class="form-control" name="audit_group" readonly="readonly" t-att-value="audit['audit_group']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>NORMA:</strong></td>
                                    <td><input type="text" class="form-control" name="norm" readonly="readonly" t-att-value="audit['norm']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>SEMANA AUDITADA:</strong></td>
                                    <td>
                                        <input type="text" 
                                            class="form-control" 
                                            name="audit_week" 
                                            t-att-value="audit['audit_week'] if audit['audit_week'] else '0'" 
                                            readonly="readonly" />
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>FECHA DE AUDITORÍA:</strong></td>
                                    <td><input type="date" class="form-control" name="audit_date" readonly="readonly" t-att-value="audit['audit_date']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>CENTRO:</strong></td>
                                    <td><input type="text" class="form-control" name="center" readonly="readonly" t-att-value="audit['center']"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Segunda columna -->
                    <div class="col-md-6">
                        <table class="table table-borderless table-custom">
                            <tbody>
                                <tr>
                                    <td><strong>CLÁUSULA:</strong></td>
                                    <td><input type="text" class="form-control" name="clause" readonly="readonly" t-att-value="audit['clause']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>VERIFICACIÓN:</strong></td>
                                    <td><input type="text" class="form-control" name="verification" readonly="readonly" t-att-value="audit['verification']"/></td>
                                </tr>
                                <tr style="border-bottom: none;">
                                    <td colspan="2"><strong>REDACCIÓN DE NO CONFORMIDAD:</strong></td>
                                </tr>
                                <tr>
                                    <td colspan="2">
                                        <textarea class="form-control" name="non_conformity" rows="4"><t t-esc="audit['finding']"/></textarea>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>HALLAZGO:</strong></td>
                                    <td>
                                        <select class="form-control" name="finding">
                                            <option t-att-selected="not audit.get('finding')" value="">Sin Seleccionar</option>
                                            <option t-att-selected="'good_practices' == audit.get('finding', 'good_practices')" value="good_practices">Buenas Prácticas</option>
                                            <option t-att-selected="'non_conformity' == audit.get('finding', 'non_conformity')" value="non_conformity">No Conformidad</option>
                                        </select>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>EVIDENCIA:</strong></td>
                                    <td><input type="text" class="form-control" name="evidence_display" readonly="readonly" t-att-value="audit['evidence']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>COMENTARIO:</strong></td>
                                    <td><input type="text" class="form-control" name="comment" t-att-value="audit['comment']"/></td>
                                </tr>
                                <tr>
                                    <td><strong>EVALUACIÓN:</strong></td>
                                    <td><input type="text" class="form-control" name="evaluation" t-att-value="audit['evaluation']"/></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Botones -->
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-success">Guardar</button>
                    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#evidenceModal">Evidencia</button>
                    <button type="button" class="btn btn-secondary" t-att-href="'/audit_application/' + str(planning_id + 1) + '/'" onclick="window.location.href = this.getAttribute('href');">Siguiente</button>
                </div>
            </form>

            <!-- Modal -->
            <div class="modal fade" id="evidenceModal" tabindex="-1" aria-labelledby="evidenceModalLabel" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="evidenceModalLabel">Adjuntar Evidencia</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form t-att-action="'/audit_application/' + str(planning_id) + '/'" method="post" enctype="multipart/form-data">
                                <input type="file" class="form-control" name="attachment" multiple="multiple" />
                                <div class="text-end mt-3">
                                    <button type="submit" class="btn btn-primary">Guardar Evidencia</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <img src="/tyt_audit/static/src/img/logo_large.png" alt="Logo" style="width: 150px; height: auto;"/>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    </template>
</odoo>
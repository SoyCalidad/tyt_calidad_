<?xml version="1.0"?>
<odoo>
    <data noupdate="1">
        <record id="audit_plan_notify_schedule_mail_template" model="mail.template">
            <field name="name">Auditorías: Notificar cronograma</field>
            <field name="model_id" ref="mgmtsystem_audit.model_audit_plan"/>
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email) }}&gt;</field>
            <field name="email_to"></field>
            <field name="subject">{{ object.name or 'n/a' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Estimado/a,
                        <br />
                        <br />
                        Se adjunta el presente documento para su conocimiento y uso respectivo.
                        <br/>
                        Le recordamos que deberá ingresar al sistema para marcar las fechas en la columna que le corresponde.
                        <br />
                        <br />
                        Saludos cordiales.
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(6,0,[
                ref('tyt_audit.action_audit_schedule_xlsx')
            ])]" />
            <field name="auto_delete" eval="True"/>
        </record>
    </data>

    <data noupdate="0">
        <record id="email_template_mgmtsystem_audit" model="mail.template">
            <field name="name">Lista de Verificación: Enviar por correo electrónico</field>
            <field name="model_id" ref="mgmtsystem_audit.model_audit_audit" />
            <field name="email_from">"{{ object.company_id.name }}" &lt;{{ (object.company_id.email) }}&gt;</field>
            <field name="email_to"></field>
            <field name="subject">{{ object.name or 'n/a' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Estimado/a,
                    </p>
                    <br/>
                    <p>
                        Se adjunta el presente documento para su conocimiento y uso respectivo.
                    </p>
                    <br/>
                    Saludos cordiales.
                </div>
            </field>
            <field name="lang">{{ user.lang }}</field>
            <field name="report_template_ids" eval="[(6,0,[
                ref('tyt_audit.action_audit_checklist_xlsx')
            ])]" />
            <field name="auto_delete" eval="True" />
        </record>
    </data>
</odoo>

<odoo>
    <!-- Vista para el modelo Non-Conforming Products Log -->
    <record id="view_non_conforming_products_log_form" model="ir.ui.view">
        <field name="name">non.conforming.products.log.form</field>
        <field name="model">non.conforming.products.log</field>
        <field name="arch" type="xml">
            <form string="Non-Conforming Products Log">
                <header>
                    <button name="action_confirm" string="Save" type="object" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_link"
                            attrs="{'invisible': [('state', '!=', 'draft')]}"/>
                    <button name="action_draft" string="Edit" type="object" class="oe_highlight"
                            attrs="{'invisible': [('state', '!=', 'confirmed')]}"/>
                </header>
                <sheet attrs="{'readonly': [('state', '=', 'confirmed')]}">
                    <group>
                        <group>
                            <field name="state" invisible="1"/> 
                            <field name="site" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="report_id" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="campaign" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="report_date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="line_number" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="login" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="complete_name" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="adjustment_cause" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="validation_date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </group>
                        <group>
                            <field name="proceed" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="pnc_responsable" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="signed_adjustment" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="general_amount" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="weekly_amount" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="nominal_weeks" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="frequency" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="start_date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                            <field name="end_date" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payments_ids" attrs="{'readonly': [('state', '=', 'confirmed')]}">
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="payment_number"/>
                                    <field name="folio"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="paymeny_status"/>
                                    <field name="responsable"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="coments" attrs="{'readonly': [('state', '=', 'confirmed')]}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para la lista de Non-Conforming Products Logs -->
    <record id="view_non_conforming_products_log_tree" model="ir.ui.view">
        <field name="name">non.conforming.products.log.tree</field>
        <field name="model">non.conforming.products.log</field>
        <field name="arch" type="xml">
            <tree string="Non-Conforming Products Logs">
                <field name="site"/>
                <field name="campaign"/>
                <field name="report_date"/>
                <field name="complete_name"/>
            </tree>
        </field>
    </record>

    <record id="model_non_conforming_products_log" model="ir.model">
        <field name="name"> Non-Conforming Products Log</field>
        <field name="model">non.conforming.products.log</field>
    </record>

    <!-- Acción para abrir el menú de Non-Conforming Products Logs -->
    <record id="action_non_conforming_products_log" model="ir.actions.act_window">
        <field name="name">Non-Conforming Products Logs</field>
        <field name="res_model">non.conforming.products.log</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Submenú para acceder a los Non-Conforming Products Logs -->
    <menuitem id="menu_non_conforming_products_log" name="Non-Conforming Products Logs"
              parent="mgmtsystem_nonconformity.menu_nonconformity_root" action="action_non_conforming_products_log" sequence="10"/>

</odoo>

<odoo>
    <!-- Vista para el modelo Non-Conforming Products Log -->
    <record id="view_non_conforming_products_log_form" model="ir.ui.view">
        <field name="name">non.conforming.products.log.form</field>
        <field name="model">non.conforming.products.log</field>
        <field name="arch" type="xml">
            <form string="Non-Conforming Products Log">
                <header>
                    <button name="action_confirm" string="Save" type="object" class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" class="oe_link"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Edit" type="object" class="oe_highlight"
                            invisible="state != 'confirmed'"/>
                </header>
                <sheet readonly="state == 'confirmed'">
                    <group>
                        <group>
                            <field name="state" invisible="1"/> 
                            <field name="site" readonly="state == 'confirmed'"/>
                            <field name="report_id" readonly="state == 'confirmed'"/>
                            <field name="campaign" readonly="state == 'confirmed'"/>
                            <field name="report_date" readonly="state == 'confirmed'"/>
                            <field name="line_number" readonly="state == 'confirmed'"/>
                            <field name="login" readonly="state == 'confirmed'"/>
                            <field name="complete_name" readonly="state == 'confirmed'"/>
                            <field name="adjustment_cause" readonly="state == 'confirmed'"/>
                            <field name="validation_date" readonly="state == 'confirmed'"/>
                        </group>
                        <group>
                            <field name="proceed" readonly="state == 'confirmed'"/>
                            <field name="pnc_responsable" readonly="state == 'confirmed'"/>
                            <field name="signed_adjustment" readonly="state == 'confirmed'"/>
                            <field name="general_amount" readonly="state == 'confirmed'"/>
                            <field name="weekly_amount" readonly="state == 'confirmed'"/>
                            <field name="nominal_weeks" readonly="state == 'confirmed'"/>
                            <field name="frequency" readonly="state == 'confirmed'"/>
                            <field name="start_date" readonly="state == 'confirmed'"/>
                            <field name="end_date" readonly="state == 'confirmed'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payments">
                            <field name="payments_ids" readonly="state == 'confirmed'">
                                <list editable="bottom" create="false" delete="false">
                                    <field name="payment_number"/>
                                    <field name="folio"/>
                                    <field name="date"/>
                                    <field name="amount"/>
                                    <field name="paymeny_status"/>
                                    <field name="responsable"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field name="coments" readonly="state == 'confirmed'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista de árbol para la lista de Non-Conforming Products Logs -->
    <record id="view_non_conforming_products_log_tree" model="ir.ui.view">
        <field name="name">non.conforming.products.log.tree</field>
        <field name="model">non.conforming.products.log</field>
        <field name="arch" type="xml">
            <list string="Non-Conforming Products Logs">
                <field name="site"/>
                <field name="campaign"/>
                <field name="report_date"/>
                <field name="complete_name"/>
            </list>
        </field>
    </record>

    <record id="model_non_conforming_products_log" model="ir.model">
        <field name="name"> Non-Conforming Products Log</field>
        <field name="model">non.conforming.products.log</field>
    </record>

    <!-- Acción para abrir el menú de Non-Conforming Products Logs -->
    <record id="action_non_conforming_products_log" model="ir.actions.act_window">
        <field name="name">Non-Conforming Products Logs</field>
        <field name="res_model">non.conforming.products.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Submenú para acceder a los Non-Conforming Products Logs -->
    <menuitem id="menu_non_conforming_products_log" name="Non-Conforming Products Logs"
              parent="mgmtsystem_nonconformity.menu_nonconformity_root" action="action_non_conforming_products_log" sequence="10"/>

</odoo>

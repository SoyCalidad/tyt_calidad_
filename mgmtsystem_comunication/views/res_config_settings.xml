<odoo>
    <data>
        <record id="view_hr_config_settings_inherit" model="ir.ui.view">
            <field name="name">hr.config.settings.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="hola_calidad.view_hola_calidad_configuration" />
            <field name="arch" type="xml">
                <xpath expr="//app[@name='hola_calidad']"
                    position="inside">
                    <block string="Comunicaciones">
                        <setting id="setting_record_meeting_line_approval"
                            help="Los acuerdos requieren aprobación."
                        >
                            <field name="record_meeting_line_approval" />
                        </setting>
                    </block>

                </xpath>
            </field>
        </record>
    </data>
</odoo>
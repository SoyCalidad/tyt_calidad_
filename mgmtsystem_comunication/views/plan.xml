<odoo>
    <data>

        <record id="view_comunication_plan_search" model="ir.ui.view">
            <field name="name">comunication.plan.search</field>
            <field name="model">comunication.plan</field>
            <field name="arch" type="xml">
                <search>
                    <field name="code" />
                    <field name="name" />
                    <filter string="Vigentes" name="vigentis" domain="[('state', '!=', 'cancel')]" />
                </search>
            </field>
        </record>

        <record id="view_comunication_plan_tree" model="ir.ui.view">
            <field name="name">comunication.plan.tree</field>
            <field name="model">comunication.plan</field>
            <field name="arch" type="xml">
                <list string="Programa de comunicaciones" >
                    <field name="name" />
                    <field name="date_elaborate" />
                    <field name="version" string="Edición" class="text-center" />
                    <field name="line_ids" />   
                    <field name="state" />
                </list>
            </field>
        </record>

        <record id="view_comunication_plan_form" model="ir.ui.view">
            <field name="name">comunication.plan.form</field>
            <field name="model">comunication.plan</field>
            <field name="arch" type="xml">
                <form string="Programa de comunicaciones">
                    <header>
                        <button string="Notificar por sistema"
                                name="action_notify_employee"
                                type="object"
                                class="btn-success"
                                invisible="state not in ['validate_ok']" />
                        <button string="Notificar por e-mail"
                                name="notify_email_odoo"
                                type="object"
                                class="btn-success"
                                invisible="state not in ['validate_ok']" />
                        <field name="state" widget="statusbar" statusbar_visible="elaborate,review,validate,validate_ok,on_track,closed" />
                        <button string="Enviar a Elaborar"
                                name="send_elaborate"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ['review']" />
                        <button string="Enviar a Revisar"
                                name="send_review"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ['elaborate']" />
                        <button string="Enviar a Validar"
                                name="send_validate"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ['review']" />
                        <button string="Validar"
                                name="send_validate_ok"
                                type="object"
                                class="btn-primary"
                                invisible="state not in ['validate']" />
                        <button string="Comenzar seguimiento"
                                name="send_on_track"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'validate_ok'" />
                        <button string="Terminar"
                                name="send_closed"
                                type="object"
                                class="btn-primary"
                                invisible="state != 'on_track'" />
                        <button string="Volver Obsoleto"
                                confirm="Esto volverá obsoleto el presente registro. ¿Está seguro(a)?"
                                name="send_cancel"
                                type="object"
                                class="btn-second"
                                invisible="state in ['cancel']" />
                        <button name="button_new_version"
                                type="object"
                                string="Nueva versión"
                                invisible="state != 'validate_ok'"
                                class="oe_highlight" />
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button type="object"
                                    name="action_open_older_versions"
                                    class="oe_stat_button"
                                    icon="fa-archive"
                                    style="white-space: nowrap;"
                                    string="Versiones antiguas" />
                            <button type="object"
                                    name="open_line_ids"
                                    class="oe_stat_button"
                                    icon="fa-calendar"
                                    string="Planes de comunicación" />
                        </div>
                        <div class="oe_title">
                            <h2>
                                <field name="code" readonly="1" />
                            </h2>
                        </div>
                        <group>
                            <field name="name" readonly="state not in ['elaborate', 'review', 'validate']" />
                            <field name="process_id" options="{'no_create': True}" readonly="state not in ['elaborate', 'review', 'validate']" />
                        </group>
                        <notebook>
                            <page string="Asignación">
                                <field name="line_ids" readonly="state not in ['elaborate', 'review', 'validate']"  context="{'default_plan_id': context.get('active_id')}" />
                            </page>
                            <page string="Seguimiento" invisible="state not in ['on_track', 'closed']">
                                <field name="linetrack_ids" readonly="state in ['closed', 'cancel']">
                                    <list editable="bottom" create="false">
                                        <field name="resume" readonly="1" />
                                        <field name="date_release" readonly="1" />
                                        <field name="observations" string="Observaciones" column_invisible="parent.state in ['elaborate', 'review', 'validate']" />
                                        <field name="reprogramming" />
                                        <field name="action_id" />
                                        <field name="date_reprogramming" required="reprogramming == True" />
                                        <field name="has_attachments" invisible="1" />
                                        <button name="action_see_attachments" type="object" icon="fa-files-o" invisible="has_attachments == False" />
                                        <button name="action_see_attachments" type="object" icon="fa-file" invisible="has_attachments == True" />
                                    </list>
                                </field>
                            </page>
                            <page name="validation" string="Validación y Versión">
                                <group>
                                    <group colspan="4">
                                        <field name="version" />
                                    </group>
                                    <group colspan="4">
                                        <separator string="Elaboración" />
                                        <field name="elaboration_step" colspan="2" nolabel="1" readonly="state not in ['elaborate']" />
                                        <separator string="Revisión" />
                                        <field name="review_step" colspan="2" nolabel="1" readonly="state not in ['elaborate', 'review']" />
                                        <separator string="Validación" />
                                        <field name="validation_step" colspan="2" nolabel="1" readonly="state not in ['elaborate', 'review', 'validate']" />
                                    </group>
                                    <group colspan="4">
                                        <field name="date_elaborate" readonly="True" required="state in ['elaborate']" />
                                        <field name="date_review" invisible="state in ['elaborate']" readonly="True" required="state in ['review']" />
                                        <field name="date_validate" groups="base.group_no_one,base.group_system" invisible="state in ['elaborate', 'review']" />
                                    </group>
                                </group>
                            </page>

                        </notebook>
                    </sheet>

                    <chatter/>

                </form>
            </field>
        </record>

        <record id="comunication_plan_action" model="ir.actions.act_window">
            <field name="name">Programa de comunicaciones</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">comunication.plan</field>

            <field name="view_mode">list,form,kanban</field>
            <field name="context">{"search_default_vigentis":1}</field>
        </record>



    </data>
</odoo>
<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_menu_department_message" name="Portal Layout : Department Message Menu"
          inherit_id="portal.portal_breadcrumbs" priority="65">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'department_messages'" class="breadcrumb-item active">
                Mensajes a departamentos
            </li>
        </xpath>
    </template>

    <template id="portal_my_department_messages" name="Mensajes a departamentos">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Mensajes a departamentos</t>
            </t>
            <div t-if="not grouped_department_messages" class="alert alert-warning mt8" role="alert">
                There are no department messages.
            </div>
            <t t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th class="col-3">Sender</th>
                        <th class="col-4">Subject</th>
                        <th class="col-3">Tags</th>
                        <th class="text-end">Publication Date</th>
                    </tr>
                </thead>
                <t t-foreach="grouped_department_messages" t-as="department_messages">
                    <tbody>
                        <tr t-if="not groupby =='none'" class="table-light">
                            <th t-if="groupby == 'sender'" colspan="3">
                                <span t-if="department_messages[0].sender_portal" t-out="department_messages[0].sender_portal"/>
                                <span t-else="">Unspecified</span>
                            </th>
                            <th class="text-end">
                                Total: <span class="text-muted" t-out="len(department_messages)"/>
                            </th>
                        </tr>
                    </tbody>
                    <t t-foreach="department_messages" t-as="department_message">
                        <tr>
                            <t t-set="is_read_by_current_user" t-value="department_message.is_read_by_current_user()"/>
                            <td><span t-att-data-id="department_message.id" t-att-class="not is_read_by_current_user and 'fw-bold' or ''"
                                      t-field="department_message.sender_portal"/></td>
                            <td>
                                <t t-set="department_message" t-value="department_message"/>
                                <a role="button" data-bs-toggle="modal" class="mark-as-read" t-att-data-id="department_message.id"
                                   t-attf-data-bs-target="#modal_department_message_view_{{department_message.id}}" href="#">
                                    <span t-att-class="'mark-as-read ' + (not is_read_by_current_user and 'fw-bold' or '')" t-esc="department_message.subject"/>
                                </a>
                                <t t-call="tyt_intranet_messaging.modal_department_message_view"/>
                            </td>
                            <td>
                                <t t-foreach="department_message.tag_ids" t-as="tag">
                                    <span t-attf-class="badge o_wslides_channel_tag o_tag_color_{{tag.color}}">
                                        <t t-esc="tag.name"/>
                                    </span>
                                </t>
                            </td>
                            <td class="text-end">
                                <span t-att-data-id="department_message.id"
                                      t-att-class="not is_read_by_current_user and 'fw-bold' or ''"
                                      t-field="department_message.published_date"/>
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
        </t>
    </template>

    <template id="modal_department_message_view" name="Modal for department message view">
        <div class="modal fade" t-attf-id="modal_department_message_view_{{department_message.id}}" data-bs-backdrop="static"
             data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="o_wevent_registration_title modal-title fs-5" id="staticBackdropLabel">Department Messages</div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <div class="d-flex flex-column align-items-center">
                            <img class="o_image_64_cover" src="/tyt_intranet_messaging/static/src/img/logo-tyt-02.png"/>
                            <p class="fw-bold mb-2 fs-2 text-wrap text-break" style="color: #1F8195" t-esc="department_message.subject"/>
                            <div class="mb-2 text-wrap text-break">
                                <t t-out="department_message.body"/>
                            </div>
                            <div class="row mb-2" t-if="department_message.attachment_ids">
                                 <div class="col-lg-12 col-xl-12 mr-lg-auto">
                                    <p class="fw-bold mb-2 fs-4 text-wrap text-break">Attachments</p>
                                    <ul class="list-group">
                                        <a class="list-group-item list-group-item-action d-flex align-items-center oe_attachments py-1 px-2" t-foreach='department_message.attachment_ids' t-as='attachment'
                                           t-attf-href="/web/content/#{attachment.id}?download=true&amp;access_token=#{attachment.access_token}" data-no-post-process="">
                                            <div class='oe_attachment_embedded o_image o_image_small mr-2 mr-lg-3 flex-shrink-0' t-att-title="attachment.name" t-att-data-mimetype="attachment.mimetype" t-attf-data-src=""/>
                                            <div class="d-flex flex-column align-items-start text-wrap w-100">
                                                <div class='oe_attachment_name'>
                                                    <span t-esc="attachment.name"/>
                                                </div>
                                            </div>
                                        </a>
                                    </ul>
                                 </div>
                            </div>
                            <div class="text-wrap text-break">
                                <t t-out="department_message.footer"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>

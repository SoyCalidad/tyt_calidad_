<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="documents_view_list" model="ir.ui.view">
        <field name="name">documents.document.view.tree.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="short_name"/>
            </xpath>
        </field>
    </record>

    <record id="document_view_kanban" model="ir.ui.view">
        <field name="name">documents.document.view.kanban.inherit</field>
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='thumbnail_status']" position="after">
                <field name="short_name"/>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>

    <record id="evaluation_criterio_line_view_form" model="ir.ui.view">
        <field name="name">evaluation.criterio.line.view.form</field>
        <field name="model">evaluation.criterio.line</field>
        <field name="arch" type="xml">
            <form string="Criterio">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="description" />
                        <field name="value_less" />
                        <field name="value_high" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="evaluation_criterio_line_view_list" model="ir.ui.view">
        <field name="name">evaluation.criterio.line.view.list</field>
        <field name="model">evaluation.criterio.line</field>
        <field name="arch" type="xml">
            <list string="Criterio">
                <field name="name" />
                <field name="description" />
                <field name="value_less" />
                <field name="value_high" />
            </list>
        </field>
    </record>

    <record id="evaluation_result_view_form" model="ir.ui.view">
        <field name="name">evaluation.result.view.form</field>
        <field name="model">evaluation.result</field>
        <field name="arch" type="xml">
            <form string="Evaluación">
                <sheet>
                    <group>
                        <field name="criterio_id" />
                        <field name="description" />
                        <field name="alternative" />
                        <field name="alternative_description" />
                    </group>
                    <group>
                        <field name="value" string='Valor' />
                        <field name="text_values" string='' />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_matrix_block_search">
        <field name="name">matrix.block.search</field>
        <field name="model">matrix.block</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="state" />
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="view_matrix_block_list">
        <field name="name">matrix.block.list</field>
        <field name="model">matrix.block</field>
        <field name="arch" type="xml">
            <list string="Fuentes" class="o_matrix_block" decoration-muted="state=='cancel'">
                <field name="name" />
                <field name="line_ids" />
                <field name="state" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_matrix_block_form">
        <field name="name">matrix.block.form</field>
        <field name="model">matrix.block</field>
        <field name="arch" type="xml">
            <form string="Fuentes" class="o_matrix_block">
                <header>
                    <button name="send_in_process"
                            type="object"
                            string="Iniciar"
                            class="btn-primary"
                            invisible="state != 'draft'" />
                    <button name="send_validate"
                            type="object"
                            string="Validar"
                            class="btn-primary"
                            invisible="state != 'in_process'" />
                    <button name="send_cancel"
                            confirm="Esto volverá obsoleto el presente registro. ¿Está seguro(a)?"
                            type="object"
                            string="Cancelar"
                            class="btn-second"
                            invisible="state == 'cancel'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_process,validate" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <field name="name" invisible="1" />
                    </div>
                    <group>
                        <field name="process_id" options="{'no_create':True,'no_create_edit':True}" 
                        required="other == False" 
                        readonly="state != 'draft'"  />
                        <field name="other" 
                        readonly="state != 'draft'" />
                        <field name="type" invisible="1" />
                    </group>
                    <notebook>
                        <page string="Lineas">
                            <field name="line_ids" 
                            readonly="state not in ['draft','in_process']">
                                <list>
                                    <field name="department_id" />
                                    <field name="name" />
                                    <field name="effect" />
                                    <field name="cause" />
                                    <field name="ntr" string="Valor de riesgo" 
                                    invisible="type != 'risk'" />
                                    <field name="ntr" string="Valor de oportunidad" invisible="type != 'opportunity'" />
                                    <field name="action_ids" />
                                    <field name="state" />
                                    <field name="type" invisible="1" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_matrix_block_line_list">
        <field name="name">matrix.block.line.list</field>
        <field name="model">matrix.block.line</field>
        <field name="arch" type="xml">
            <list class="o_matrix_block_line">
                <field name="name" />
                <field name="effect" />
                <field name="cause" />
                <field name="version" />
                <field name="user_id" />
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_matrix_block_line_form">
        <field name="name">matrix.block.line.form</field>
        <field name="model">matrix.block.line</field>
        <field name="arch" type="xml">
            <form class="o_matrix_block_line">
                <header>
                    <button name="send_validate"
                            type="object"
                            string="Validar"
                            class="btn-primary"
                            invisible="state != 'draft'" />
                    <button name="send_cancel"
                            confirm="Esto volverá obsoleto el presente registro. ¿Está seguro(a)?"
                            type="object"
                            string="Cancelar"
                            class="btn-second"
                            invisible="state == 'cancel'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,validate" />
                    <button name="button_new_version"
                            type="object"
                            string="Nueva versión"
                            invisible="state != 'validate'"
                            class="oe_highlight" />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_older_versions"
                                class="oe_stat_button"
                                icon="fa-archive"
                                style="white-space: nowrap;"
                                string="Versiones antiguas" />
                    </div>
                    <h1>
                        <field name="code" />
                    </h1>
                    <div class="oe_title">
                        <label for="name" />
                        <h2>
                            <field name="name" readonly="state != 'draft'" class="o_mbline_name" />
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="process_id" options="{'no_create': True}" readonly="state  in ['draft','in_process']" />
                            <field name="system_id" options="{'no_create': True, 'no_edit': True}"  />
                            <field name="type" invisible="1" />
                            <field name="cause" 
                            readonly="state  in ['draft','in_process']" class="o_mbline_cause" />
                            <field name="effect" 
                            readonly="state  in ['draft','in_process']" class="o_mbline_effect" />
                            <field name="version" />
                        </group>
                        <group>
                            <field name="department_id" options="{'no_create':True,'no_create_edit':True,'no_open':True}" 
                            readonly="state  in ['draft','in_process']" class="o_mbline_department_id" />
                            <field name="type_id" />
                            <field name="description" readonly="state not in ['draft','in_process']" />
                            <field name="agent_id" />
                            <field name="user_id" />
                        </group>                        
                    </group>

                    <notebook>
                        <page string="Evaluación">
                            <group>
                                <field name="evaluation_id"
                                       string="Indicador"
                                       readonly="state not in ['draft','in_process']"
                                       options="{'no_create':True,'no_create_edit':True}"
                                       domain="[('type','=',type)]"
                                       class="o_mbline_evaluation_id" />
                                <field name="result_ids" widget="one2many" readonly="state not in ['draft','in_process']" class="o_mbline_result_ids">
                                    <list create="false" delete="false">
                                        <field name="criterio_id" options="{'no_create':True,'no_create_edit':True}" />
                                        <field name="description" style="max-width: 200px" />
                                        <field name="alternative" />
                                        <field name="value" />
                                    </list>
                                </field>
                                <field name="ntr" string="Valor de riesgo" invisible="type != 'risk'" 
                                readonly="state not in ['draft','in_process']" />
                                <field name="ntr" string="Valor de oportunidad" invisible="type != 'opportunity'" 
                                readonly="state not in ['draft','in_process']" />
                                <field name="type" invisible="1" />
                                <field name="interpretation_risk" invisible="type != 'risk'"
                                readonly="state not in ['draft','in_process']" />
                                <field name="interpretation_opportunity" invisible="type != 'opportunity'"
                                readonly="state not in ['draft','in_process']" />
                            </group>
                        </page>
                        <page string="Acciones">
                            <field name="action_ids" />
                        </page>
                    </notebook>
                </sheet>
                <chatter />
                
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="matrix_block_risk_action">
        <field name="name">Fuentes</field>
        <field name="res_model">matrix.block</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type','=','risk')]</field>
        <field name="context">{'default_type':'risk'}</field>
    </record>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tyt_context_scope_body_report_action" model="ir.actions.report">
        <field name="name">Alcance del SGC Body</field>
        <field name="model">tyt.context.scope</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">tyt_context.tyt_context_scope_body_report</field>
        <field name="report_file">tyt_context.tyt_context_scope_body_report</field>
        <field name="print_report_name">'%s' % object.name</field>
        <field name="binding_model_id" eval="False" />
        <field name="binding_type">report</field>
    </record>

    <template id="tyt_context_scope_body_report">
         <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div t-call="tyt_process.external_layout_tyt_document">
                    <div class="page">
                         <style type="text/css">
                            .tyt_body_context_scope { font-family: Arial, sans-serif; }
                        </style>
                        <div class="tyt_body_context_scope">
                            <div>
                                <h1 class="colored">1. Objectivo, alcance and usuarios</h1>
                                <p t-out="o.tyt_objective_scope_users" />
                            </div>

                            <div style="page-break-before:always">
                                <h1 class="colored">2. Documentos de referencia</h1>
                                <p t-out="o.tyt_reference_documents" />
                            </div>

                            <div style="page-break-before:always">
                                <h1 class="colored">3. Definicición de alcance del SGC</h1>
                                <t t-out="o.tyt_procedure_scope_definition" />
                                <div class="ms-4">
                                    <h2 class="colored">3.1. Procesos y actividades</h2>
                                    <t t-raw="o.tyt_processes_activities" />
                                    <h2 class="colored">3.2. Productos y servicios</h2>
                                    <t t-raw="o.tyt_products_services" />
                                    <h2 class="colored">3.3. Unidades organizacionales y funciones</h2>
                                    <t t-raw="o.tyt_organizational_units_and_functions" />
                                    <h2 class="colored">3.4. Ubicaciones</h2>
                                    <t t-raw="o.tyt_locations" />
                                    <h2 class="colored">3.5. Exclusiones del alcance</h2>
                                    <t t-raw="o.tyt_scope_exclusions" />
                                    <h2 class="colored">3.6. Exclusiones de los requisitos de ISO 9001:2015</h2>
                                    <t t-raw="o.tyt_iso_requirements_exclusions" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
         </t>
    </template>
</odoo>

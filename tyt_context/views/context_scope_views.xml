<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tyt_context_scope_view_form" model="ir.ui.view">
        <field name="name">tyt.context.scope.view.form</field>
        <field name="model">tyt.context.scope</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="elaborate,review,validate,validate_ok" />
                    <button string="Enviar a Elaborar"
                            name="send_elaborate"
                            type="object"
                            class="btn-primary"
                            invisible="state in ['elaborate', 'cancel', 'validate_ok']" />
                    <button string="Enviar a Revisar"
                            name="send_review"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'elaborate'" />
                    <button string="Enviar a Validar"
                            name="send_validate"
                            type="object"
                            class="btn-primary"
                            invisible="state in ['elaborate', 'validate', 'cancel', 'validate_ok']" />
                    <button string="Validar"
                            name="send_validate_ok"
                            type="object"
                            class="btn-primary"
                            invisible="state not in ['validate']" />
                    <button string="Volver Obsoleto"
                            confirm="Esto volverá obsoleto el presente registro. ¿Está seguro(a)?"
                            name="send_cancel"
                            type="object"
                            class="btn-second"
                            invisible="state in ['cancel']" />
                    <button name="button_new_version"
                            type="object"
                            string="Nueva versión"
                            invisible="state != 'validate_ok'"
                            class="oe_highlight" />
                    <button string="Validación rápida"
                            name="fast_validation"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'elaborate'"/>
                    <button string="Comunicar alcance" name="send_context_scope_by_email" type="object" class="oe_highlight" invisible="state != 'validate_ok'"/>
                </header>
                <sheet>
                    <field name="active" invisible="1" />
                    <widget name="web_ribbon" title="Archivado" bg_color="bg-danger" invisible="active == True" />
                    <div class="oe_button_box" name="button_box">
                        <button type="object"
                                name="action_open_older_versions"
                                class="oe_stat_button"
                                icon="fa-archive"
                                style="white-space: nowrap;"
                                string="Versiones antiguas" />
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="code" />
                        </h1>
                        <label for="name" />
                        <h1>
                            <field name="name" required="1" readonly="state not in ['elaborate']" />
                        </h1>
                    </div>
                    <group>
                        <label for="process_id" />
                        <div class="o_row">
                            <field name="process_id" required="1" options="{'no_create': True}" colspan="3" readonly="state not in ['elaborate']" />
                            <field name="version_as_string" colspan="1" nolabel="1" class="oe_inline" />
                        </div>
                    </group>
                    <notebook>
                        <page string="Contenido" name="content">
                            <h2 class="o_horizontal_separator">1. Objetivo, alcance y usuarios</h2>
                            <field name="tyt_objective_scope_users"/>

                            <h2 class="o_horizontal_separator">2. Documentos de referencia</h2>
                            <field name="tyt_reference_documents"/>

                            <h2 class="o_horizontal_separator">3. Definicición de alcance del SGC</h2>
                            <field name="tyt_procedure_scope_definition"/>

                            <h4>3.1. Procesos y actividades</h4>
                            <field name="tyt_processes_activities"/>
                            <h4>3.2. Procesos y actividades</h4>
                            <field name="tyt_products_services"/>
                            <h4>3.3. Procesos y actividades</h4>
                            <field name="tyt_organizational_units_and_functions"/>
                            <h4>3.4. Procesos y actividades</h4>
                            <field name="tyt_locations"/>
                            <h4>3.5. Procesos y actividades</h4>
                            <field name="tyt_scope_exclusions"/>
                            <h4>3.6. Procesos y actividades</h4>
                            <field name="tyt_iso_requirements_exclusions"/>
                        </page>
                        <page string="Validación y versión" name="version_info">
                            <group col="4">
                                <group colspan="4">
                                    <field name="version" readonly="state in ['validate_ok', 'cancel']" />
                                </group>
                                <group colspan="4">
                                    <separator string="Elaboración" />
                                    <field name="elaboration_step" colspan="2" nolabel="1" readonly="state not in ['elaborate']" />
                                    <separator string="Revisión" />
                                    <field name="review_step" colspan="2" nolabel="1" readonly="state not in ['elaborate', 'review']" />
                                    <separator string="Validación" />
                                    <field name="validation_step" colspan="2" nolabel="1" readonly="state not in ['elaborate', 'review', 'validate']" />
                                </group>
                                <group colspan="2">
                                    <field name="date_elaborate" readonly="True" required="state in ['elaborate']" />
                                    <field name="date_review" invisible="state in ['elaborate']" readonly="True" required="state in ['review']" />
                                    <field name="date_validate" groups="base.group_no_one,base.group_system" invisible="state in ['elaborate', 'review']" />
                                </group>
                            </group>
                        </page>
                        <page name="change_history" string="Historial">
                            <field name="change_history" context="{'default_scope_id': context.get('active_id')}">
                                <list>
                                    <field name="scope_id" invisible="1" />
                                    <field name="numero" />
                                    <field name="publish_date" />
                                    <field name="name" />
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="scope_id" required="1" domain="[('state', '!=', 'cancel')]"
                                                       options="{'no_create': True, 'no_create_edit': True, 'no_open': True}" />
                                                <field name="publish_date" />
                                            </group>
                                            <group>
                                                <field name="numero" />
                                            </group>
                                        </group>
                                        <group>
                                            <field name="name" />
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="tyt_context_scope_view_tree" model="ir.ui.view">
        <field name="name">tyt.context.scope.view.tree</field>
        <field name="model">tyt.context.scope</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" />
                <field name="name" />
                <field name="version_as_string" />
                <field name="state" />
                <field name="process_id" />
                <field name="write_date" string="Ultima actualización"/>
            </list>
        </field>
    </record>

    <record id="tyt_context_scope_action" model="ir.actions.act_window">
        <field name="name">Alcance</field>
        <field name="res_model">tyt.context.scope</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '!=', 'cancel')]</field>
    </record>

    <record id="tyt_context_scope_cancel_action" model="ir.actions.act_window">
        <field name="name">Alcance</field>
        <field name="res_model">tyt.context.scope</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', '=', 'cancel')]</field>
        <field name="context">{}</field>
    </record>
</odoo>

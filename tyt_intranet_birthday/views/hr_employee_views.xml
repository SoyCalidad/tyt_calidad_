<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Birthday Publication" name="birthday_publication"
                      groups="tyt_intranet_base.group_intranet_manager">
                    <group>
                        <field name="include_in_birthday_publication"/>
                        <field name="include_in_all_birthday_publications"/>
                    </group>
                    <group string="Birthday Card">
                        <field name="birthday_card_filename" invisible="1"/>
                        <field name="birthday_card" nolabel="1" readonly="1" widget="image"
                               filename="birthday_card_filename" style="width: 300px;"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_form_simple" model="ir.ui.view">
        <field name="name">hr.employee.view.form.simple</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <field name="company_id" invisible="1"/>
                    <field name="avatar_128" invisible="1"/>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                    <div class="oe_title">
                        <h1 class="d-flex flex-row">
                            <field name="name"/>
                        </h1>
                        <h2>
                            <field name="job_title"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="birthday"/>
                            <field name="is_birthday" invisible="1"/>
                            <field name="is_birthday_this_week" invisible="1"/>
                            <field name="is_birthday_this_month" invisible="1"/>
                            <field name="birthday_month" invisible="1"/>
                            <field name="include_in_birthday_publication"/>
                            <field name="include_in_all_birthday_publications"/>
                        </group>
                        <group>
                            <field name="department_id"/>
                            <field name="job_id"/>
                            <field name="x_studio_sitios0"/>
                        </group>
                    </group>
                    <group string="Birthday Card">
                        <field name="has_uploaded_custom_card"/>
                        <field name="birthday_card_filename" invisible="1"/>
                        <field name="birthday_card" nolabel="1" widget="image" filename="birthday_card_filename" style="width: 300px;"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_view_tree_simple" model="ir.ui.view">
        <field name="name">hr.employee.view.tree.simple</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="x_studio_sitios0"/>
                <field name="birthday"/>
                <field name="is_birthday" invisible="1"/>
                <field name="include_in_birthday_publication"/>
                <field name="include_in_all_birthday_publications"/>
            </tree>
        </field>
    </record>

    <record id="hr_employee_simple_action" model="ir.actions.act_window">
        <field name="name">Employees</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'form_view_ref': 'tyt_intranet_birthday.hr_employee_view_form_simple'}</field>
    </record>
</odoo>

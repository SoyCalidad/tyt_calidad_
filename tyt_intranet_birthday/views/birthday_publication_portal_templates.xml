<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="portal_my_home_menu_birthday_publication" name="Portal layout : birthday publication menu entries" inherit_id="portal.portal_breadcrumbs" priority="70">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'birthday_publication'" class="breadcrumb-item active">
                Publicación de cumpleaños
            </li>
        </xpath>
    </template>

    <template id="portal_birthday_publication" name="Publicación de cumpleaños">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Publicación de cumpleaños</t>
            </t>
            <div t-if="not employees" class="alert alert-info" role="status">
                There is no Birthday Publications for This Period.
            </div>
            <t t-else="">
                <t t-call="portal.portal_table">
                    <thead>
                        <tr>
                            <th class="col-4">Employee</th>
                            <th class="col-2">Job Position</th>
                            <th class="col-2">Department</th>
                            <th class="col-2">Site</th>
                            <th class="col-2 text-end">Birthday</th>
                        </tr>
                    </thead>
                    <t t-foreach="employees" t-as="employee">
                        <tr>
                            <td>
                                <img class="rounded-circle o_portal_contact_img" t-att-src="image_data_uri(employee.avatar_128)" alt="Employee"/>
                                <span class="ml8"><t t-esc="employee.name"/></span>
                            </td>
                            <td><span t-esc="employee.job_id.nesp or employee.job_id.name"/></td>
                            <td><span t-field="employee.department_id.display_name"/></td>
                            <td><span t-field="employee.sitios0"/></td>
                            <td class="text-end"><span t-field="employee.birthday"/></td>
                        </tr>
                    </t>
                </t>
            </t>
        </t>
    </template>
</odoo>

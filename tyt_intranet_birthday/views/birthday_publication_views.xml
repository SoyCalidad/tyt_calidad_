<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tyt_intranet_birthday_publication_view_form" model="ir.ui.view">
        <field name="name">tyt.intranet.birthday_publication.view.form</field>
        <field name="model">tyt.intranet.birthday_publication</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(tyt_intranet_birthday.hr_employee_simple_action)d" type="action" class="oe_stat_button" icon="fa-users">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="employee_count"/>
                                </span>
                                <span class="o_stat_text">Employees</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" required="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="responsible_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                    <group name="Attachments" invisible="1">
                        <label for="attachment_ids" string="Attachments"/>
                        <br/>
                        <field name="attachment_ids" nolabel="1" colspan="2" widget="many2many_binary" class="o_sign_attachments"/>
                    </group>
                    <notebook>
                        <page string="Birthday Employees" name="birthday_employees">
                            <field name="birthday_employee_ids" readonly="1"
                                   context="{
                                        'tree_view_ref': 'tyt_intranet_birthday.hr_employee_view_tree_simple',
                                        'form_view_ref': 'tyt_intranet_birthday.hr_employee_view_form_simple'}">
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter />            </form>
        </field>
    </record>

    <record id="tyt_intranet_birthday_publication_action" model="ir.actions.act_window">
        <field name="name">Birthday Publication</field>
        <field name="res_model">tyt.intranet.birthday_publication</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="tyt_intranet_birthday.tyt_intranet_birthday_publication_singleton"/>
    </record>
</odoo>

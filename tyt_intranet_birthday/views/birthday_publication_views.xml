<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="tyt_intranet_birthday_publication_view_form" model="ir.ui.view">
        <field name="name">tyt.intranet.birthday_publication.view.form</field>
        <field name="model">tyt.intranet.birthday_publication</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_show_employees" type="object" class="oe_stat_button" icon="fa-users">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="employee_count"/>
                                </span>
                                <span class="o_stat_text">Employees</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="responsible_id"  widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="create_date"/>
                            <field name="write_date"/>
                        </group>
                    </group>
                    <group name="Attachments" invisible="1">
                        <label for="attachment_ids" string="Attachments"/>
                        <br/>
                        <field name="attachment_ids" nolabel="1" colspan="2" widget="many2many_binary" class="o_sign_attachments"/>
                    </group>
                    <notebook>
                        <page string="Birthday Employees" name="birthday_employees">
                            <field name="birthday_employee_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="x_studio_sitios0"/>
                                    <field name="birthday"/>
                                    <field name="is_birthday"/>
                                    <field name="include_in_birthday_publication"/>
                                    <field name="include_in_all_birthday_publications"/>
                                    <field name="birthday_card_filename" invisible="1"/>
                                    <field name="birthday_card" filename="birthday_card_filename" widget="binary"/>
                                </tree>
                                <form>
                                    <sheet>
                                        <field name="company_id" invisible="1"/>
                                        <field name="avatar_128" invisible="1"/>
                                        <field name="image_1920" widget="image" class="oe_avatar" options="{&quot;preview_image&quot;: &quot;avatar_128&quot;}"/>
                                        <div class="oe_title">
                                            <h1 class="d-flex flex-row">
                                                <field name="name"/>
                                            </h1>
                                            <h2>
                                                <field name="job_title"/>
                                            </h2>
                                        </div>
                                        <group>
                                            <group>
                                                <field name="birthday"/>
                                                <field name="is_birthday"/>
                                                <field name="include_in_birthday_publication"/>
                                                <field name="include_in_all_birthday_publications"/>
                                            </group>
                                            <group>
                                                <field name="department_id"/>
                                                <field name="job_id"/>
                                                <field name="x_studio_sitios0"/>
                                            </group>
                                        </group>
                                        <group string="Birthday Card">
                                            <field name="birthday_card_filename" invisible="1"/>
                                            <field name="birthday_card" nolabel="1" readonly="1" widget="image"
                                                   filename="birthday_card_filename" style="width: 300px;"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="tyt_intranet_birthday_publication_action" model="ir.actions.act_window">
        <field name="name">Birthday Publication</field>
        <field name="res_model">tyt.intranet.birthday_publication</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="tyt_intranet_birthday.tyt_intranet_birthday_publication_singleton"/>
    </record>
</odoo>

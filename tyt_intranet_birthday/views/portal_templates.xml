<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home" name="My Portal" inherit_id="portal.portal_my_home" priority="25">
        <xpath expr="//div[hasclass('o_portal_my_home')]" position="inside">
            <div>
                <a role="button" class="d-none" data-bs-toggle="modal" data-bs-target="#modal_birthday_card" href="#">
                    <span>Show Modal</span>
                </a>
            </div>
            <t t-if="show_birthday_card_modal">
                <t t-call="tyt_intranet_birthday.modal_birthday_card"/>
            </t>
        </xpath>
    </template>

    <template id="modal_birthday_card" name="Modal Birthday Card">
        <div class="modal fade" id="modal_birthday_card" data-bs-backdrop="static"
             data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
            <div class="modal-dialog">
                <t t-set="employee" t-value="request.env.user.sudo().empleado"/>
                <div class="modal-content">
                    <div class="modal-header">
                        <div class="o_wevent_registration_title modal-title fs-5" id="staticBackdropLabel">
                            <t t-if="employee.birthday_publication_ids">
                                <t t-out="employee.birthday_publication_ids[0].name"/>
                            </t>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex flex-column align-items-center">
                            <div class="d-flex mb-3 align-items-center justify-content-center">
                                <dvi>
                                    <img class="rounded-circle me-3" t-att-src="image_data_uri(employee.avatar_128)" alt="Employee"/>
                                </dvi>
                                <div class="align-self-center text-wrap text-break w-50">
                                    <h3><t t-out="employee.name"/></h3>
                                </div>
                            </div>
                            <div>
                                <t t-if="employee.birthday_card">
                                    <img t-att-src="image_data_uri(employee.sudo().birthday_card)"
                                         alt="Birthday Card"
                                         style="max-width:100%; height:auto;"
                                         class="rounded"/>
                                    </t>
                                <t t-else="">
                                    <p>No Birthday Card Available</p>
                                </t>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function () {
                const modal = document.getElementById('modal_birthday_card');
                if (modal) {
                    const anchor = document.querySelector('a[data-bs-toggle="modal"]');
                    if (anchor) {
                        anchor.click();
                    }
                    let isOverflowApplied = false;
                    const resizeHandler = () => {
                        if (modal.classList.contains('show')) {
                            if (!isOverflowApplied) {
                                document.body.style.overflowY = 'auto';
                                document.body.style.setProperty('overflow-y', 'auto', 'important');
                                isOverflowApplied = true;
                                console.log('Body style updated with overflow-y: auto !important on resize');
                            }
                        } else {
                            if (isOverflowApplied) {
                                document.body.style.removeProperty('overflow-y');
                                isOverflowApplied = false;
                            }
                        }
                    };
                    window.addEventListener('resize', resizeHandler);
                }
            });
        </script>
    </template>
</odoo>

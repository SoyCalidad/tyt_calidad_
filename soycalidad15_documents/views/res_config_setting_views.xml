<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.documents</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70" />
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//app[@name='documents']" position="attributes">
                <attribute name="notApp">0</attribute>
            </xpath>
            <xpath expr="//block[@id='files_centralization_section']" position="inside">
                <setting string="Comunicaciones" company_dependent="1"
                    help="Centralize your communications' documents (contracts, payslips, etc.)">
                    <field name="documents_communications_settings" />
                    <div name="documents_communications_folder" class="content-group"
                        invisible="not documents_communications_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3"
                                for="documents_communications_folder" string="Workspace" />
                            <field name="documents_communications_folder"
                                required="documents_communications_settings"
                                widget="documents_folder_many2one"
                                options="{'no_create': True, 'no_create_edit': True}" />
                        </div>
                    </div>
                    <div id="documents_hr_tags" class="mt-3" />
                </setting>
                <setting company_dependent="1"
                    string="Capacitaciones"
                    help="Centralize your training' documents (contracts, payslips, etc.)">
                    <field name="documents_training_settings" />
                    <div name="documents_training_folder" class="content-group"
                        invisible="not documents_training_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_training_folder"
                                string="Workspace" />
                            <field name="documents_training_folder" required="documents_training_settings"
                                widget="documents_folder_many2one"
                                options="{'no_create': True, 'no_create_edit': True}" />
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" 
                string="Procesos"
                help="Centralize your process' documents (contracts, payslips, etc.)">
                    <field name="documents_process_settings"/>
                    <div name="documents_process_folder" class="content-group" invisible="not documents_process_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_process_folder" string="Workspace"/>
                            <field name="documents_process_folder" required="documents_process_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                    <div id="documents_hr_tags" class="mt-3"/>
                </setting>
                <setting company_dependent="1" 
                string="Contexto"
                help="Centralize your context' documents (contracts, payslips, etc.)">
                    <field name="documents_context_settings"/>
                    <div name="documents_context_folder" class="content-group" invisible="not documents_context_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_context_folder" string="Workspace"/>
                            <field name="documents_context_folder" required="documents_context_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your Risks and Oportunities' documents (contracts, payslips, etc.)" string="Riesgos y Oportunidades">
                    <field name="documents_risk_op_settings"/>
                    <div name="documents_risk_op_folder" class="content-group" invisible="not documents_risk_op_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_risk_op_folder" string="Workspace"/>
                            <field name="documents_risk_op_folder" required="documents_risk_op_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your legal requirements' documents (contracts, payslips, etc.)" string="Requisitos legales">
                    <field name="documents_legal_requirements_settings"/>
                    <div name="documents_legal_requirements_folder" class="content-group" invisible="not documents_legal_requirements_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_legal_requirements_folder" string="Workspace"/>
                            <field name="documents_legal_requirements_folder" required="documents_legal_requirements_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your requirements' documents (contracts, payslips, etc.)" string="Requisitos">
                    <field name="documents_requirements_settings"/>
                    <div name="documents_requirements_folder" class="content-group" invisible="not documents_requirements_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_requirements_folder" string="Workspace"/>
                            <field name="documents_requirements_folder" required="documents_requirements_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your survey' documents (contracts, payslips, etc.)" string="Encuestas">
                    <field name="documents_surveys_settings"/>
                    <div name="documents_surveys_folder" class="content-group" invisible="not documents_surveys_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_surveys_folder" string="Workspace"/>
                            <field name="documents_surveys_folder" required="documents_surveys_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your target' documents (contracts, payslips, etc.)" string="Objetivos y Medición">
                    <field name="documents_target_settings"/>
                    <div name="documents_target_folder" class="content-group" invisible="not documents_target_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_target_folder" string="Workspace"/>
                            <field name="documents_target_folder" required="documents_target_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your indicator' documents (contracts, payslips, etc.)" string="Indicadores">
                    <field name="documents_indicators_settings"/>
                    <div name="documents_indicators_folder" class="content-group" invisible="not documents_indicators_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_indicators_folder" string="Workspace"/>
                            <field name="documents_indicators_folder" required="documents_indicators_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your maintenance' documents (contracts, payslips, etc.)" string="Mantenimiento y Calibración">
                    <field name="documents_maintenance_settings"/>
                    <div name="documents_maintenance_folder" class="content-group" invisible="not documents_maintenance_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_maintenance_folder" string="Workspace"/>
                            <field name="documents_maintenance_folder" required="documents_maintenance_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your management review' documents (contracts, payslips, etc.)" 
                string="Revisión por la Dirección">
                    <field name="documents_management_review_settings"/>
                    <div name="documents_management_review_folder" class="content-group" invisible="not documents_management_review_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_management_review_folder" string="Workspace"/>
                            <field name="documents_management_review_folder" required="documents_management_review_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your non conformities' documents (contracts, payslips, etc.)"
                string="No conformidades"
                >
                    <field name="documents_nonconformities_settings"/>
                    <div name="documents_nonconformities_folder" class="content-group" invisible="not documents_nonconformities_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_nonconformities_folder" string="Workspace"/>
                            <field name="documents_nonconformities_folder" required="documents_nonconformities_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your actions' documents (contracts, payslips, etc.)"
                string="Acciones"
                >
                    <field name="documents_actions_settings"/>
                    <div name="documents_actions_folder" class="content-group" invisible="not documents_actions_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_actions_folder" string="Workspace"/>
                            <field name="documents_actions_folder" required="documents_actions_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
                <setting company_dependent="1" help="Centralize your audits' documents (contracts, payslips, etc.)"
                string="Auditorías"
                >
                    <field name="documents_audits_settings"/>
                    <div name="documents_audits_folder" class="content-group" invisible="not documents_audits_settings">
                        <div class="row mt16">
                            <label class="o_form_label col-lg-3" for="documents_audits_folder" string="Workspace"/>
                            <field name="documents_audits_folder" required="documents_audits_settings" widget="documents_folder_many2one" options="{'no_create': True, 'no_create_edit': True}"/>
                        </div>
                    </div>
                </setting>
            </xpath>

